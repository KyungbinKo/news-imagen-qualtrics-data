  "idx_7": "52",
  "title_7": "\u201c\uae09\ud569\ub2c8\ub2e4\u201d \ud328\ub7ec\uae00\ub77c\uc774\ub529\uc73c\ub85c \uc2dc\ud5d8\uc7a5\uc5d0 \ub3c4\ucc29\ud55c \uc778\ub3c4 \ud559\uc0dd [\uc20f\ud3fc]",
  "body_7": "\uc2dc\ud5d8 \ub2f9\uc77c \uad50\ud1b5\uccb4\uc99d \ub54c\ubb38\uc5d0 \ud328\ub7ec\uae00\ub77c\uc774\ub354\ub97c \ud0c0\uace0 \ub4f1\uad50\ud55c \uc778\ub3c4 \ud559\uc0dd\uc758 \uc0ac\uc5f0\uc774 \uc628\ub77c\uc778\uc0c1\uc5d0\uc11c \ud654\uc81c\ub97c \ubaa8\uc558\uc2b5\ub2c8\ub2e4.18\uc77c NDTV \ub4f1 \uc778\ub3c4 \ud604\uc9c0 \ub9e4\uccb4\uc5d0 \ub530\ub974\uba74 \ud30c\uc0ac\ub77c\ub2c8 \ub9c8\uc744\uc5d0 \uc0ac\ub294 \ub300\ud559\uad50 1\ud559\ub144\uc778 A\uad70\uc740 15km \ub5a8\uc5b4\uc9c4 \uc2dc\ud5d8\uc7a5\uc73c\ub85c \ucc28\uac00 \uc544\ub2cc \ud328\ub7ec\uae00\ub77c\uc774\ub354\ub97c \ud0c0\uace0 \ub0a0\uc544\uac04 \uac74\ub370\uc694.\uc2dc\ud5d8\uc774 \uc788\ub2e8 \uc0ac\uc2e4\uc744 \ubab0\ub790\ub358 A\uad70\uc740 \uce5c\uad6c\ub4e4\uc758 \uc804\ud654\ub97c \ubc1b\uace0 \ucc28\ub97c \ud0c0\uace0 \uc774\ub3d9\ud558\ub824\uace0 \ud588\uc2b5\ub2c8\ub2e4.\uadf8\ub7ec\ub098 \ub3c4\ub85c \uc0ac\uc815\uc774 \uc88b\uc9c0 \uc54a\uc544 \uad50\ud1b5 \uccb4\uc99d\uc774 \uc608\uc0c1\ub3fc \uadfc\ucc98 \ud328\ub7ec\uae00\ub77c\uc774\ub529\uc7a5\uc73c\ub85c \ub6f0\uc5b4\uac14\ub294\ub370\uc694.A\uad70\uc740 \uac04\uc808\ud55c \ub208\ube5b\uc73c\ub85c \uc2dc\ud5d8\uc7a5\uae4c\uc9c0 \ud0dc\uc6cc\ub2ec\ub77c\uace0 \ubd80\ud0c1\ud588\uace0, \uacb0\uad6d 5\ubd84 \ub9cc\uc5d0 \uc2dc\ud5d8\uc7a5\uc5d0 \ub3c4\ucc29\ud574 \ubb34\uc0ac\ud788 \uc2dc\ud5d8\uc744 \uce58\ub97c \uc218 \uc788\uc5c8\ub2e4\uace0 \ud569\ub2c8\ub2e4.",
  "ai_image_file_7": "https://snuss1.qualtrics.com/ControlPanel/Graphic.php?IM=IM_TJvWXmsV8q8CTuZ",
  "real_image_file_7": "https://snuss1.qualtrics.com/ControlPanel/Graphic.php?IM=IM_E7gLIfasiAW7R5i",
  "ai_caption_7": "\uae30\uc0ac\uc640 \uad00\ub828 \uc5c6\ub294 \uc774\ubbf8\uc9c0. \ud234 \uc81c\uacf5=\ud50c\ub77c\uba5c(AI \uc81c\uc791)",
  "real_caption_7": "\ud328\ub7ec\uae00\ub77c\uc774\ub529 \ud0c0\uace0 \ub4f1\uad50\ud55c \uc778\ub3c4 \ud559\uc0dd / X @NewsArenaIndia \uc601\uc0c1 \ucea1\ucc98",
  "idx_8": "43",
  "title_8": "\ucd9c\uadfc\uae38 \uc11c\uc6b8 \uc9c0\ud558\ucca0 \ubc14\ub2e5\uc5d0 \ub4f1\uc7a5\ud55c '\uc778\ubd84' \ubbfc\uc6d0 10\uc5ec\uac74",
  "body_8": "15\uc77c \ucd9c\uadfc \uc2dc\uac04\ub300 \uc11c\uc6b8 \uc9c0\ud558\ucca0 9\ud638\uc120 \uc5f4\ucc28 \ubc14\ub2e5\uc5d0\uc11c \uc778\ubd84\uc774 \ubc1c\uacac\ub3fc \uc2b9\uac1d\ub4e4\uc774 \ud070 \ubd88\ud3b8\uc744 \uacaa\uc5c8\ub2e4.9\ud638\uc120\uc744 \uc6b4\uc601\ud558\ub294 \uc11c\uc6b8\uc2dc\uba54\ud2b8\ub85c9\ud638\uc120\uc740 \uc774\ub0a0 \uc624\uc804 8\uc2dc 20\ubd84\uaed8\ubd80\ud130 '\uc5f4\ucc28 \ubc14\ub2e5\uc5d0 \uc624\ubb3c\uc774 \uc788\ub294 \uac83 \uac19\ub2e4'\ub294 \ubbfc\uc6d0 12\uac74\uc744 \uc811\uc218\ud588\ub2e4.<br>\ud604\uc7a5\uc5d0 \uac04 \uc9c1\uc6d0\ub4e4\uc740 \uc5f4\ucc28 \ub450 \ubc88\uc9f8 \uce78 \ubc14\ub2e5\uc5d0 \ub193\uc778 \uc0ac\ub78c \ub300\ubcc0\uc744 \ud655\uc778\ud558\uace0 20\ubd84 \ub9cc\uc5d0 \uccad\uc18c\ub97c \ub9c8\ucce4\ub2e4.\uba54\ud2b8\ub85c9\ud638\uc120 \uad00\uacc4\uc790\ub294 \uc624\ubb3c\uc758 \ud615\uc0c1\uc744 \ubcf4\uba74 \uc5f4\ucc28\uc5d0 \uc11c \uc788\ub358 \uc2b9\uac1d\uc758 \ubc14\uc9d3\uac00\ub791\uc774\ub97c \ud0c0\uace0 \ud758\ub7ec\ub0b4\ub9b0 \uac83\uc73c\ub85c \ucd94\uc815\ub41c\ub2e4\uace0 \ubc1d\ud614\ub2e4.\uc774 \uad00\uacc4\uc790\ub294 \"\ub9cc\uc57d \uc549\uc544 \uc788\ub294 \uc2b9\uac1d\uc774\uc5c8\ub2e4\uba74 \uc88c\uc11d\uc774 \uc624\uc5fc\ub410\uc5b4\uc57c \ud558\ub294\ub370 \ubc14\ub2e5\uc5d0\ub9cc \ud754\uc801\uc774 \uc788\uc5c8\ub2e4\"\uba70 \"\ud1a0\uc0ac\ubb3c \uac19\ub2e4\ub294 \uc2e0\uace0\ub3c4 \ub4e4\uc5b4\uc654\uc9c0\ub9cc \ub0c4\uc0c8\ub294 \ud655\uc2e4\ud788 \uadf8\ucabd\uc774\uc5c8\ub2e4\"\uace0 \uc124\uba85\ud588\ub2e4.\uc5f4\ucc28 \ubc14\ub2e5\uc5d0 \uc778\ubd84\uc744 \ub0a8\uae34 \uc2b9\uac1d\uc758 \uc2e0\uc6d0\uc740 \uc544\uc9c1 \ud30c\uc545\ub418\uc9c0 \uc54a\uc558\ub2e4.\uc774\ub0a0 \uc628\ub77c\uc778 \ucee4\ubba4\ub2c8\ud2f0\uc5d0\ub294 \"\ub204\uac00 9\ud638\uc120\uc5d0\uc11c X\uc744 \uc2f8\uace0 \ub178\ub7c9\uc9c4\uc5ed\uc5d0\uc11c \ub0b4\ub838\ub2e4\"\ub294 \uae00\uc774 \uc62c\ub77c\uc654\uc9c0\ub9cc, \uba54\ud2b8\ub85c9\ud638\uc120\uc740 \ud574\ub2f9 \uc2b9\uac1d\uc758 \ub3d9\uc120\uc740 \ud655\uc778\ub418\uc9c0 \uc54a\uc558\ub2e4\uace0 \ubc1d\ud614\ub2e4.",
