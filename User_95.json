  "real_image_file_8": "https://snuss1.qualtrics.com/ControlPanel/Graphic.php?IM=IM_qgcLFd1iC5ueZ9l",
  "ai_caption_8": "\uc591\ubc30\ucd94\uc640 \ubc30\ucd94. [\uc0ac\uc9c4 \ucd9c\ucc98 = \ucc57GPT\ub85c \uc0dd\uc131\ud55c \uc774\ubbf8\uc9c0]",
