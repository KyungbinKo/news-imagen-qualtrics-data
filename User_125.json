  "ai_caption_3": "\ucc57GPT \uc0dd\uc131\uc774\ubbf8\uc9c0. [\ucd9c\ucc98=\uc624\ud508AI]",
  "real_caption_3": "\ubb3c\uac00\uc0c1\uc2b9 \uae30\ub300\ud615\uc131 \uc694\uc778\uc5d0 \ub300\ud55c \uc751\ub2f5\ube44\uc911.\ud55c\uad6d\uc740\ud589",
  "idx_4": "226",
  "title_4": "\ud55c\uac15\uacf5\uc6d0 \uc218\uc601\uc7a5\uc11c \uc548\uc804\uc694\uc6d0 \ud589\uc138 \u2018\ucc30\uce75\u2019 \ubd88\ubc95 \ucd2c\uc601 20\ub300",
  "body_4": "\uc218\uc601\uc7a5 \uc548\uc804\uc694\uc6d0\uc73c\ub85c \uc704\uc7a5\ud574 \uc5ec\uc131\ub4e4\uc758 \uc2e0\uccb4\ub97c \ubd88\ubc95 \ucd2c\uc601\ud55c 20\ub300\uac00 \uacbd\ucc30\uc5d0 \ubd99\uc7a1\ud614\ub2e4.<br>\uc11c\uc6b8 \uc11c\ucd08\uacbd\ucc30\uc11c\ub294 \ud55c\uac15\uacf5\uc6d0 \uc218\uc601\uc7a5\uc5d0\uc11c \uc5ec\uc131\ub4e4\uc758 \uc2e0\uccb4\ub97c \ubd88\ubc95 \ucd2c\uc601\ud55c \ud610\uc758\ub85c 20\ub300 \ub0a8\uc131 A\uc528\ub97c \uad6c\uc18d\ud574 \uc870\uc0ac\ud558\uace0 \uc788\ub2e4\uace0 20\uc77c \ubc1d\ud614\ub2e4.<br>A\uc528\ub294 \uc9c0\ub09c 13\uc77c \uc624\ud6c4 \uc11c\ucd08\uad6c \uc7a0\uc6d0\ud55c\uac15\uacf5\uc6d0 \uc218\uc601\uc7a5\uc5d0\uc11c \uc5ec\uc131\ub4e4\uc758 \uc2e0\uccb4\ub97c \ubab0\ub798 \ucd2c\uc601\ud55c \ud610\uc758(\uc131\ud3ed\ub825\ucc98\ubc8c\ubc95\uc0c1 \uce74\uba54\ub77c\ub4f1\uc774\uc6a9\ucd2c\uc601)\ub97c \ubc1b\ub294\ub2e4.<br>A\uc528\ub294 \uba85\ucc30 \ud615\ud0dc\uc758 \uce74\ub4dc \ubaa9\uac78\uc774\ub97c \uac78\uace0 \ube68\uac04 \ubc18\ubc14\uc9c0\ub97c \uc785\uc5b4 \uc548\uc804\uc694\uc6d0\uc778 \ucc99 \ud589\uc138\ud55c \uac83\uc73c\ub85c \uc804\ud574\uc84c\ub2e4.<br>\ubd88\ubc95\ucd2c\uc601\uc744 \ubaa9\uaca9\ud55c \uc218\uc601\uc7a5 \uc9c1\uc6d0\uc774 A\uc528\ub97c \uc7a1\uc544 \uacbd\ucc30\uc5d0 \ub118\uae30\uba70 \ubc94\ud589 \uc0ac\uc2e4\uc774 \ubc1c\uac01\ub410\ub2e4.<br>A\uc528 \ud734\ub300\uc804\ud654\uc5d0\uc11c\ub294 \uc218\uc601\ubcf5\uc744 \uc785\uc740 \uc5ec\uc131 10\uc5ec\uba85\uc758 \uc2e0\uccb4\ub97c \ucd2c\uc601\ud55c \uc601\uc0c1\uc774 \ubc1c\uacac\ub410\ub2e4. A\uc528\uc5d0\uac8c\ub294 \uc720\uc0ac\ud55c \uc804\uacfc\ub3c4 \uc788\ub294 \uac83\uc73c\ub85c \ud30c\uc545\ub410\ub2e4.<br>\uacbd\ucc30\uc740 \ucd94\uac00 \ud53c\ud574\uc790 \uc874\uc7ac \uc5ec\ubd80\ub97c \ud655\uc778 \uc911\uc774\ub2e4.",
  "ai_image_file_4": "https://snuss1.qualtrics.com/ControlPanel/Graphic.php?IM=IM_U0a1C7Rj3UN3zlQ",
  "real_image_file_4": "https://snuss1.qualtrics.com/ControlPanel/Graphic.php?IM=IM_mJPMb8w29eEUMbL",
  "ai_caption_4": "\uc218\uc601\uc7a5\uc5d0\uc11c \uc548\uc804\uc694\uc6d0 \ud589\uc138\ub97c \ud558\uba70 \uc5ec\uc131 \uc2e0\uccb4\ub97c \ubd88\ubc95 \ucd2c\uc601\ud55c \ub0a8\uc131\uc774 \uacbd\ucc30\uc5d0 \ubd99\uc7a1\ud614\ub2e4. \uc790\ub8cc\uc774\ubbf8\uc9c0. \uae30\uc0ac\uc640 \ubb34\uad00. [\uc774\ubbf8\uc9c0 \ucd9c\ucc98 = \ucc57GPT]",
  "real_caption_4": "\uad6d\ubbfc\uc77c\ubcf4 DB",
  "idx_5": "31",
  "title_5": "3 1\uc808 \uc5f0\ud734 23\ub9cc\uba85 \uc77c\ubcf8 \uc624\uac14\ub2e4 \uc9c0\ub09c\ud574\ubcf4\ub2e4 10%\u2191",
  "body_5": "\uc0ac\ud758 \ub3d9\uc548 \uc774\uc5b4\uc9c4 \uc62c\ud574 3\u00b71\uc808 \uc5f0\ud734\uc5d0 23\ub9cc\uba85\uc774 \ub118\ub294 \uc2b9\uac1d\uc774 \uc77c\ubcf8\uc5d0 \uc624\uac00\ub294 \ud56d\uacf5\ud3b8\uc744 \uc774\uc6a9\ud55c \uac83\uc73c\ub85c \ub098\ud0c0\ub0ac\ub2e4.<br>9\uc77c \uad6d\ud68c \uad6d\ud1a0\uad50\ud1b5\uc704\uc6d0\ud68c \uc18c\uc18d \ub354\ubd88\uc5b4\ubbfc\uc8fc\ub2f9 \uc774\uc5f0\ud76c \uc758\uc6d0\uc774 \uc778\ucc9c\uad6d\uc81c\uacf5\ud56d\uacf5\uc0ac\uc640 \ud55c\uad6d\uacf5\ud56d\uacf5\uc0ac\ub85c\ubd80\ud130 \uc81c\ucd9c\ubc1b\uc740 \uc790\ub8cc\uc5d0 \ub530\ub974\uba74 \uc9c0\ub09c 1\uc77c\ubd80\ud130 3\uc77c\uae4c\uc9c0 \uad6d\ub0b4 \uacf5\ud56d\uc5d0\uc11c \uc77c\ubcf8 \ub178\uc120\uc744 \uc774\uc6a9\ud55c \uc2b9\uac1d\uc740 \ucd9c\uc785\uad6d\uc744 \ud569\uccd0 \ucd1d 23\ub9cc1956\uba85\uc73c\ub85c \uc9d1\uacc4\ub410\ub2e4.<br>\uc774\ub294 \uc5ed\uc2dc \uc0ac\ud758\uc774\uc5c8\ub358 \uc9c0\ub09c\ud574 3\u00b71\uc808 \uc5f0\ud734 \uad6d\ub0b4 \uacf5\ud56d\uc5d0\uc11c\uc758 \uc77c\ubcf8 \ub178\uc120 \ud56d\uacf5\ud3b8 \uc774\uc6a9\uac1d 21\ub9cc509\uba85\uacfc \ube44\uad50\ud574 10.2% \ub298\uc5b4\ub09c \uc218\uce58\ub2e4. \ucf54\ub85c\ub09819 \uc774\uc804\uc778 2019\ub144 \uc0ac\ud758\uac04\uc758 3\u00b71\uc808 \uc5f0\ud734(20\ub9cc1467\uba85)\uc640 \ube44\uad50\ud574\ub3c4 15.1% \ub9ce\ub2e4.<br>\uc62c\ud574 3\u00b71\uc808 \uc5f0\ud734\uc5d0\ub294 \uc778\ucc9c\uacf5\ud56d\uc5d0\uc11c 16\ub9cc2235\uba85\uc774, \uae40\ud3ec\u00b7\uae40\ud574\u00b7\uc81c\uc8fc\u00b7\uccad\uc8fc\u00b7\ub300\uad6c \ub4f1 5\uac1c \uacf5\ud56d\uc5d0\uc11c 6\ub9cc9721\uba85\uc774 \uc77c\ubcf8 \ub178\uc120\uc744 \uc774\uc6a9\ud588\ub2e4. \uac01\uac01 \uc9c0\ub09c\ud574 \ub300\ube44 9.1%, 12.9% \ub298\uc5c8\ub2e4.<br>\uc804\uccb4 \uad6d\uc81c\uc120 \uc774\uc6a9\uac1d\ub3c4 \ub298\uc5b4\ub0ac\ub2e4. \uc62c\ud574 3\u00b71\uc808 \uc5f0\ud734 \ub3d9\uc548 \uc804\uccb4 \uad6d\uc81c\uc120 \uc774\uc6a9\uac1d\uc740 81\ub9cc448\uba85\uc73c\ub85c, \uc9c0\ub09c\ud574 75\ub9cc2409\uba85\ubcf4\ub2e4 7.7% \ub9ce\uc558\ub2e4.<br>\ubc18\uba74 3\u00b71\uc808 \uc5f0\ud734\uc5d0 \uad6d\ub0b4\uc120\uc744 \uc774\uc6a9\ud558\ub294 \uc2b9\uac1d\uc740 \uc904\uc5b4\ub4e0 \uac83\uc73c\ub85c \ub098\ud0c0\ub0ac\ub2e4. \uc9c0\ub09c 1~3\uc77c \uad6d\ub0b4\uc120 \ud56d\uacf5 \uc2b9\uac1d\uc740 45\ub9cc2873\uba85\uc73c\ub85c, \uc9c0\ub09c\ud574 51\ub9cc7643\uba85\uacfc \ube44\uad50\ud574 12.5% \uac10\uc18c\ud588\ub2e4.",
  "ai_image_file_5": "https://snuss1.qualtrics.com/ControlPanel/Graphic.php?IM=IM_1oKcC3GMiWEbbWp",
  "real_image_file_5": "https://snuss1.qualtrics.com/ControlPanel/Graphic.php?IM=IM_iJ4jU6wO8pX6VXF",
  "ai_caption_5": "[\ucd9c\ucc98=EBN AI \uadf8\ub798\ud53d]",
  "real_caption_5": "\uc5f0\ud734\uac00 \uc2dc\uc791\ub41c \uc9c0\ub09c 1\uc77c \uc778\ucc9c\uad6d\uc81c\uacf5\ud56d \uc81c1\uc5ec\uac1d\ud130\ubbf8\ub110 \ucd9c\uad6d\uc7a5\uc5d0\uc11c \uc2b9\uac1d\ub4e4\uc774 \ud0d1\uc2b9 \uc218\uc18d\uc744 \uc704\ud574 \uc904\uc744 \uc11c\uace0 \uc788\ub2e4. \uc5f0\ud569\ub274\uc2a4",
  "idx_6": "213",
  "title_6": "\uc6a9\ubcc0 \ubcf4\ub294 \ub0a8\uc131\ub9cc `\ucc30\uce75` 873\ucc28\ub840 \ubd88\ubc95\ucd2c\uc601\ud55c 20\ub300 \ub0a8\uc131 \uad6c\uc18d \uae30\uc18c",
  "body_6": "\uc11c\uc6b8\ubd81\ubd80\uc9c0\uac80 \uc5ec\uc131\uc544\ub3d9\ubc94\uc8c4\uc870\uc0ac\ubd80(\uad6c\ubbf8\uc625 \ubd80\uc7a5\uac80\uc0ac)\ub294 \uc0c1\uac00 \ud654\uc7a5\uc2e4\uc5d0\uc11c 800\ucc28\ub840 \ub118\uac8c \ubd88\ubc95 \ucd2c\uc601\uc744 \ud55c \ud610\uc758\ub85c 20\ub300 \ub0a8\uc131 A\uc528\ub97c \uad6c\uc18d\uae30\uc18c \ud588\ub2e4\uace0 7\uc77c \ubc1d\ud614\ub2e4.<br>\uac80\ucc30\uc5d0 \ub530\ub974\uba74 A\uc528\ub294 2019\ub144 9\uc6d4\ubd80\ud130 2022\ub144 6\uc6d4\uae4c\uc9c0 \uc218\ub3c4\uad8c \ub0b4 \uc0c1\uac00 \ub0a8\uc790 \ud654\uc7a5\uc2e4 \ub4f1\uc9c0\uc5d0\uc11c 873\ucc28\ub840\uc5d0 \uac78\uccd0 \ubd88\ubc95 \ucd2c\uc601\ud55c \ud610\uc758(\uc131\ud3ed\ub825\ucc98\ubc8c\ubc95\uc0c1 \uce74\uba54\ub77c\ub4f1\uc774\uc6a9\ucd2c\uc601\u00b7\ubc18\ud3ec \ub4f1)\ub97c \ubc1b\ub294\ub2e4.<br>A\uc528\ub294 \uc774\uc804\uc5d0\ub3c4 \ub0a8\uc790 \ud654\uc7a5\uc2e4\uc5d0\uc11c \uc720\uc0ac\ud55c \ubc29\uc2dd\uc758 \ubc94\ud589\uc73c\ub85c \ucc98\ubc8c\ubc1b\uc740 \uc801\uc774 \uc5ec\ub7ec \ucc28\ub840 \uc788\uc5c8\uc73c\uba70 \uc7ac\ud310\uc744 \ubc1b\uace0 \uc788\ub294 \uc911\uc5d0\ub3c4 \ube44\uc2b7\ud55c \ubc94\ud589\uc744 \uacc4\uc18d\ud55c \uac83\uc73c\ub85c \uc870\uc0ac\ub410\ub2e4.<br>\uac80\ucc30\uc740 A\uc528 \uc8fc\uac70\uc9c0 \uc555\uc218\uc218\uc0c9\uacfc \ucd94\uac00\uc801\uc778 \ud3ec\ub80c\uc2dd \ubd84\uc11d\uc744 \ud1b5\ud574 \uacbd\ucc30\uc774 \uc1a1\uce58\ud55c \ud610\uc758 \uc678\uc5d0\ub3c4 \ubd88\ubc95 \ucd2c\uc601\ubb3c \uc18c\uc9c0 \ud610\uc758\ub3c4 \ucd94\uac00\ub85c \ud30c\uc545\ud574 \uae30\uc18c\ud588\ub2e4.<br>\uac80\ucc30\uc740 \"\ud734\ub300\uc804\ud654 \uae30\uae30 \uc555\uc218, \ud53c\ud574\uc790 \uc2ec\ub9ac\uce58\ub8cc, \ubd88\ubc95 \ucd2c\uc601\ubb3c \uc720\ud3ec \ucc28\ub2e8\u00b7\uc0ad\uc81c\uc870\uce58 \ub4f1 \ud53c\ud574\uc790 \uc9c0\uc6d0\uc5d0\ub3c4 \ucd5c\uc120\uc744 \ub2e4\ud560 \uc608\uc815\"\uc774\ub77c\uace0 \ubc1d\ud614\ub2e4.",
  "ai_image_file_6": "https://snuss1.qualtrics.com/ControlPanel/Graphic.php?IM=IM_NFT2zQVD9caXU9R",
  "real_image_file_6": "https://snuss1.qualtrics.com/ControlPanel/Graphic.php?IM=IM_ta4nyAt0ghJvmPp",
  "ai_caption_6": "\ud574\ub2f9 \uc774\ubbf8\uc9c0\ub294 \u2018\ud50c\ub77c\uba5c AI \uc774\ubbf8\uc9c0 \uc0dd\uc131\uae30\u2019\ub85c \ub9cc\ub4e4\uc5c8\uc2b5\ub2c8\ub2e4. \ud234 \uc81c\uacf5=\uc2a4\ubaa8\uc5b4\ud1a1",
  "real_caption_6": "\ud654\uc7a5\uc2e4 \ubab0\uce74.<\uc5f0\ud569\ub274\uc2a4>",
  "idx_7": "266",
  "title_7": "\"\uc74c\uc8fc \ube91\uc18c\ub2c8 \uc0ac\uace0 \ub0b8 \uc808\uce5c \uc190\uc808\ud588\ub294\ub370 \uce5c\uad6c\ub4e4\uc774 \ub108\ubb34\ud558\ub300\uc694\" [\uc5b4\ub5bb\uac8c \uc0dd\uac01\ud558\uc138\uc694]",
  "body_7": "19\uc77c \ud55c \uc628\ub77c\uc778 \ucee4\ubba4\ub2c8\ud2f0\uc5d0\ub294 \u2018\uc74c\uc8fc\uc6b4\uc804 \ube91\uc18c\ub2c8 \uc0ac\uace0 \ub0b8 \uce5c\uad6c \uc190\uc808\ud55c \uac8c \uc798\ubabb\uc778\uac00\uc694?\u2019\ub77c\ub294 \uc81c\ubaa9\uc758 \uac8c\uc2dc\ubb3c\uc774 \uc62c\ub77c\uc654\ub2e4.<br>\uc791\uc131\uc790 A\uc528\ub294 \u201c\uc774\uc81c\ub294 \uc544\ub2c8\uc9c0\ub9cc \uace0\ub4f1\ud559\uad50 \ub3d9\ucc3d\uc774\uace0 \ub418\uac8c \uce5c\ud588\ub358 \uce5c\uad6c\uac00 \uc788\uc5c8\ub2e4\u201d\uba70 \u201c\ub2e4\ub978 \uce5c\uad6c\ub4e4\uc774\ub791 \ud568\uaed8 \ub178\ub294 \ub2e8\uccb4 \ub300\ud654\ubc29\ub3c4 \uc788\uc5c8\ub2e4\u201d\uace0 \uc801\uc5c8\ub2e4.<br>\uadf8\ub7ec\uba74\uc11c \u201c\uc5bc\ub9c8 \uc804 \uadf8 \uce5c\uad6c\uac00 \uc74c\uc8fc\uc6b4\uc804 \ube91\uc18c\ub2c8 \uc0ac\uace0\ub97c \ub0c8\ub2e4\ub354\ub77c. (\ud53c\ud574\uc790\uac00) \uc0ac\ub9dd\ud558\uc9c0 \uc54a\uc544 \uad6c\uc18d\uc740 \uc548 \ub410\ub294\ub370 \ub108\ubb34 \ubc30\uc2e0\uac10 \ub4e4\uace0 \uc5b4\uc774\uac00 \uc5c6\uc5c8\ub2e4\u201d\uba70 \u201c\ub3c4\ub300\uccb4 \ub0b4\uac00 \uc5b4\ub5a4 \uc0ac\ub78c\ud558\uace0 \uc54c\uace0 \uc9c0\ub0c8\ub098 \uc2f6\uc5b4\uc11c \uc790\uad34\uac10 \ub4e4\uc5b4 \uce5c\uad6c \ucc28\ub2e8\ud558\uace0 \ub300\ud654\ubc29\uc5d0\uc11c\ub3c4 \ub098\uc654\ub2e4\u201d\uace0 \uc124\uba85\ud588\ub2e4.<br>\uc774\ud6c4 A\uc528\ub294 \ub2e8\uccb4 \ub300\ud654\ubc29 \uce5c\uad6c\ub4e4\ub85c\ubd80\ud130 \ud669\ub2f9\ud55c \uc18c\ub9ac\ub97c \ub4e4\uc5c8\ub2e4. \u201c\uadf8\ub0e5 \uc0ac\uace0\uace0 \ud55c \ubc88 \uc2e4\uc218\ud55c \uac74\ub370 \uadf8\ub807\uac8c \uc27d\uac8c \uc190\uc808\ud558\ub0d0. \ub108\ubb34\ud558\ub2e4\"\uba70 \uba74\ubc15\uc744 \uc900 \uac83.<br>A\uc528\ub294 \"\ub108\ubb34 \ud669\ub2f9\ud574\uc11c \uc778\uac04\uad00\uacc4 \ub2e4 \uc815\ub9ac\ud558\uace0 \uc2f6\uc5b4\uc9c0\ub354\ub77c\"\uba70 \"\uc81c\uac00 \uacfc\ud55c \uac70\ub0d0, \ub2e4\ub978 \uac83\ub3c4 \uc544\ub2c8\uace0 \uc74c\uc8fc\uc6b4\uc804 \ube91\uc18c\ub2c8\ub77c\ub294 \uc911\ubc94\uc8c4\ub97c \uc800\uc9c0\ub978 \ubc94\uc8c4\uc790\uc778\ub370 \uc778\uc5f0 \ub04a\uace0 \uc2f6\uc740 \uac8c \ub2f9\uc5f0\ud558\uc9c0 \uc54a\ub290\ub0d0\"\ub77c\uace0 \uc870\uc5b8\uc744 \uad6c\ud588\ub2e4.<br>\ud574\ub2f9 \uc0ac\uc5f0\uc744 \uc811\ud55c \ub204\ub9ac\uafbc\ub4e4\uc740 \"\ub098\ub77c\ub3c4 \uc778\uc5f0 \ub04a\uc5c8\ub2e4\" \"\uce5c\uad6c\ub4e4\uc740 \uc608\ube44 \uc0b4\uc778\ub9c8\ub97c \uc65c \uac10\uc2f8\uc8fc\ub294 \uac70\ub0d0\" \"\uc778\uac04\uc740 \uace0\uccd0 \uc4f0\ub294 \uac70 \uc544\ub2c8\ub2e4\" \ub4f1\uc758 \ubc18\uc751\uc744 \ubcf4\uc600\ub2e4.<br>\ud55c\ud3b8 \uc74c\uc8fc\uc6b4\uc804\uc73c\ub85c \uad50\ud1b5\uc0ac\uace0\ub97c \ub0c8\ub2e4\uac00 \ud53c\ud574\uc790\uac00 \uc0c1\ud574\ub97c \uc785\uc73c\uba74 1\ub144 \uc774\uc0c1 15\ub144 \uc774\ud558\uc758 \uc9d5\uc5ed\ud615 \ub610\ub294 1000\ub9cc\uc6d0 \uc774\uc0c1 3000\ub9cc\uc6d0 \uc774\ud558\uc758 \ubc8c\uae08\ud615\uc5d0 \ucc98\ud574\uc9c8 \uc218 \uc788\ub2e4. \ube91\uc18c\ub2c8\ub97c \uc800\uc9c0\ub97c \uc2dc\uc5d0\ub294 3\ub144 \uc774\uc0c1\uc758 \uc720\uae30\uc9d5\uc5ed\uc5d0 \ucc98\ud55c\ub2e4.<br>\ube91\uc18c\ub2c8\ub85c \ud53c\ud574\uc790\uac00 \uc0ac\ub9dd\ud55c \uacbd\uc6b0 \ubb34\uae30\uc9d5\uc5ed \ub610\ub294 5\ub144 \uc774\uc0c1\uc758 \uc9d5\uc5ed\ud615\uc5d0 \ucc98\ud560 \uc218 \uc788\ub2e4.",
  "ai_image_file_7": "https://snuss1.qualtrics.com/ControlPanel/Graphic.php?IM=IM_v42qzfScLMCWJgA",
