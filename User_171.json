  "real_image_file_8": "https://snuss1.qualtrics.com/ControlPanel/Graphic.php?IM=IM_gsVh8C4IiEJYufz",
  "ai_caption_8": "\uc77c\ub7ec\uc2a4\ud2b8 = \ubbf8\ub4dc\uc800\ub2c8",
