  "real_image_file_8": "https://snuss1.qualtrics.com/ControlPanel/Graphic.php?IM=IM_PgHgdjQNYRZezfw",
  "ai_caption_8": "\ucc57GPT \uc0dd\uc131 \uc774\ubbf8\uc9c0. [\ucd9c\ucc98=\uc624\ud508AI]",
  "real_caption_8": "\ub3c4\ub110\ub4dc \ud2b8\ub7fc\ud504 \ubbf8\uad6d \ub300\ud1b5\ub839."
}