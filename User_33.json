  "ai_caption_8": "[\ucc57GPT\ub97c \uc774\uc6a9\ud574 \uc81c\uc791\ud55c \uc774\ubbf8\uc9c0]",
  "real_caption_8": "HD\ud55c\uad6d\uc870\uc120\ud574\uc591\uc774 \uac74\uc870\ud55c \ucee8\ud14c\uc774\ub108\uc120. HD\ud55c\uad6d\uc870\uc120\ud574\uc591 \uc81c\uacf5"
