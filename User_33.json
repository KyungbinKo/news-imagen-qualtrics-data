  "ai_caption_7": "[\ucc57GPT\ub97c \uc0ac\uc6a9\ud574 \uc81c\uc791\ud568]",
  "real_caption_7": "\uc5f0\ud569\ub274\uc2a4",
  "idx_8": "128",
  "title_8": "K-\uc870\uc120, \uc9c0\ub09c\ud574 \uc218\uc8fc \uc810\uc720\uc728 8\ub144 \ub9cc\uc5d0 \ucd5c\uc800\u22ef \uc911\uad6d\uacfc \uaca9\ucc28 54%p\ub85c \ud655\ub300",
  "body_8": "\ud55c\uad6d \uc870\uc120\uc5c5\uacc4\uc758 \uc9c0\ub09c\ud574 \uae00\ub85c\ubc8c \uc218\uc8fc \uc810\uc720\uc728\uc774 17%\ub85c 8\ub144 \ub9cc\uc5d0 \ucd5c\uc800\uce58\ub97c \uae30\ub85d\ud55c \uac83\uc73c\ub85c \ub098\ud0c0\ub0ac\ub2e4. \ud2b9\ud788 12\uc6d4\uc5d0\ub294 \uc218\uc8fc \uc810\uc720\uc728\uc774 4%\uae4c\uc9c0 \ud558\ub77d\ud558\uba70 \uc911\uad6d\uacfc\uc758 \uaca9\ucc28\uac00 \ub354\uc6b1 \ubc8c\uc5b4\uc84c\ub2e4.<br>8\uc77c \uc601\uad6d \uc870\uc120\ud574\uc6b4\uc2dc\ud669 \uc804\ubb38\uae30\uad00 \ud074\ub77d\uc2a8\ub9ac\uc11c\uce58\uc5d0 \ub530\ub974\uba74 \ud55c\uad6d\uc740 \uc9c0\ub09c\ud574 \uc804 \uc138\uacc4 \uc218\uc8fc\ub7c9\uc758 17%\uc778 1098\ub9ccCGT(250\ucc99)\ub97c \uc218\uc8fc\ud588\ub2e4. \uc218\uc8fc\ub7c9\uc740 2023\ub144 \ub300\ube44 9% \uc99d\uac00\ud588\uc73c\ub098, \uae00\ub85c\ubc8c \uc810\uc720\uc728\uc740 \uc804\ub144 20%\uc5d0\uc11c 3%\ud3ec\uc778\ud2b8 \ud558\ub77d\ud588\ub2e4. \ud55c\uad6d\uc218\ucd9c\uc785\uc740\ud589 \uc790\ub8cc\uc5d0 \ub530\ub974\uba74 \ud55c\uad6d\uc758 \uc218\uc8fc \uc810\uc720\uc728\uc774 10%\ub300\ub85c \ub5a8\uc5b4\uc9c4 \uac83\uc740 2016\ub144(15.6%) \uc774\ud6c4 \ucc98\uc74c\uc774\ub2e4.<br>\ubc18\uba74 \uc911\uad6d\uc740 \uc9c0\ub09c\ud574 4645\ub9ccCGT(1711\ucc99)\ub97c \uc218\uc8fc\ud574 \uc804 \uc138\uacc4 \uc218\uc8fc\ub7c9\uc758 71%\ub97c \ucc28\uc9c0\ud588\ub2e4. \uc911\uad6d\uc758 \uc218\uc8fc\ub7c9\uc740 \uc804\ub144 \ub300\ube44 58% \uc99d\uac00\ud588\uace0, \uc810\uc720\uc728\uc740 11%\ud3ec\uc778\ud2b8 \uc0c1\uc2b9\ud588\ub2e4. \uc774\uc5d0 \ub530\ub77c \ud55c\uc911 \uac04 \uc810\uc720\uc728 \uaca9\ucc28\ub294 2023\ub144 40%\ud3ec\uc778\ud2b8\uc5d0\uc11c \uc9c0\ub09c\ud574 54%\ud3ec\uc778\ud2b8\ub85c \ud655\ub300\ub410\ub2e4.<br>\ud2b9\ud788 12\uc6d4 \uc2e4\uc801\uc744 \ubcf4\uba74 \uae00\ub85c\ubc8c \uc218\uc8fc\ub7c9 194\ub9ccCGT(86\ucc99) \uc911 \uc911\uad6d\uc774 166\ub9ccCGT(67\ucc99)\ub85c 86%\ub97c \ucc28\uc9c0\ud55c \ubc18\uba74, \ud55c\uad6d\uc740 7\ub9ccCGT(3\ucc99)\ub85c 4%\uc5d0 \uadf8\ucce4\ub2e4. \uc774\ub294 \uc804\ub144 \ub3d9\uae30 \ub300\ube44 56% \uac10\uc18c\ud55c \uc218\uce58\ub2e4.<br>12\uc6d4 \ub9d0 \uae30\uc900 \uc804 \uc138\uacc4 \uc218\uc8fc \uc794\ub7c9\uc740 1\uc5b55717\ub9ccCGT\ub85c \uc804\uc6d4 \ub300\ube44 167\ub9ccCGT \uc99d\uac00\ud588\ub2e4. \uc911\uad6d\uc774 9078\ub9ccCGT\ub85c 58%, \ud55c\uad6d\uc774 3787\ub9ccCGT\ub85c 24%\ub97c \ucc28\uc9c0\ud588\ub2e4. \uc804\ub144 \ub3d9\uae30 \ub300\ube44 \uc911\uad6d\uc740 2588\ub9ccCGT \uc99d\uac00\ud55c \ubc18\uba74, \ud55c\uad6d\uc740 190\ub9ccCGT \uac10\uc18c\ud588\ub2e4.<br>\ud55c\ud3b8 12\uc6d4 \ub9d0 \ud074\ub77d\uc2a8 \uc2e0\uc870\uc120\uac00\uc9c0\uc218\ub294 189.16\uc73c\ub85c \uc804\uc6d4(189.18)\ubcf4\ub2e4 \uc18c\ud3ed \ud558\ub77d\ud588\uc73c\ub098, \uc804\ub144 \ub3d9\uae30 \ub300\ube44\ub85c\ub294 6% \uc0c1\uc2b9\ud588\ub2e4. \uc120\uc885\ubcc4 \uc120\uac00\ub294 LNG\uc6b4\ubc18\uc120\uc774 2\uc5b56000\ub9cc\ub2ec\ub7ec, \ucd08\ub300\ud615 \uc720\uc870\uc120(VLCC)\uc774 1\uc5b52900\ub9cc\ub2ec\ub7ec, \ucd08\ub300\ud615 \ucee8\ud14c\uc774\ub108\uc120(2\ub9cc2000~2\ub9cc4000TEU)\uc774 2\uc5b57500\ub9cc\ub2ec\ub7ec\ub97c \uae30\ub85d\ud588\ub2e4.",
  "ai_image_file_8": "https://snuss1.qualtrics.com/ControlPanel/Graphic.php?IM=IM_3LQSxMFdffAGldT",
