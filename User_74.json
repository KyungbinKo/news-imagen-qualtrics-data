{"assignment_id":"74","idx_1":"82","title_1":"\u4e2d \uc778\ud50c\ub8e8\uc5b8\uc11c\uc758 \uc5b5\uc9c0 \uc8fc\uc7a5 \u201c\uae40\uce58\ub294 \uc911\uad6d \uc694\ub9ac\u201d","body_1":"\uc911\uad6d\uc758 \uc720\uba85 \uc778\ud50c\ub8e8\uc5b8\uc11c\uac00 \uae40\uce58\ub97c \ub2f4\uac00 \uba39\ub294 \uc601\uc0c1\uc744 \uc62c\ub9ac\uba74\uc11c \u2018\uc911\uad6d \uc804\ud1b5\uc694\ub9ac\u2019\ub77c\ub294 \ud0dc\uadf8\ub97c \ub2ec\uc544 \ub17c\ub780\uc774 \ub418\uace0 \uc788\ub2e4.<br>7\uc77c \uc11c\uacbd\ub355 \uc131\uc2e0\uc5ec\ub300 \uad50\uc218\uac00 \ud398\uc774\uc2a4\ubd81\uc5d0 \uc62c\ub9b0 \uac8c\uc2dc\uae00\uc5d0 \ub530\ub974\uba74, \ubb38\uc81c\uc758 \uc778\ud50c\ub8e8\uc5b8\uc11c\ub294 \u2018\ubbf8\uc2a4\ud130 \ubc4c\uc624\u2019\ub77c\ub294 \uacc4\uc815\uc744 \uc6b4\uc601\ud558\ub294 \uc774\ub2e4. \uadf8\ub294 \ucd5c\uadfc \uc9c1\uc811 \uae40\uce58\ub97c \ub2f4\uac00 \uba39\ub294 3\ubd80\uc791 \uc601\uc0c1\uc744 \uc778\uc2a4\ud0c0\uadf8\ub7a8\uc5d0 \uc62c\ub9ac\uba74\uc11c \u2018<br>\uc911\uad6d \ubb38\ud654\u2019(Chineseculture) \u2018\uc911\uad6d \uc804\ud1b5\uc694\ub9ac\u2019(Chinesecuisine)\ub77c\ub294 \ud574\uc2dc\ud0dc\uadf8\ub97c \ub2ec\uc558\ub2e4. \uc774\ub4e4 \uc601\uc0c1\uc758 \uc870\ud68c \uc218\ub294 3000\ub9cc\ud68c\uac00 \ub118\ub294\ub2e4.<br>\uc11c \uad50\uc218\ub294<br>\u201c<br>\ub18d\ucd0c \uc0dd\ud65c\uc744 \uc774\uc6a9\ud574 \uae40\uce58\ub97c \ud64d\ubcf4\ud558\ub294 \uc774\uc720\ub294 \u2018\uc624\ub798\uc804\ubd80\ud130 \uc911\uad6d \uc2dc\uace8\uc5d0\uc11c \ub9cc\ub4e4\uc5b4 \uba39\uc5c8\ub358 \uc74c\uc2dd\u2019\uc774\ub77c\ub294 \uc810\uc744 \ub300\uc678\uc801\uc73c\ub85c \uac15\uc870\ud558\uae30 \uc704\ud55c \uac83\u201d\uc774\ub77c\uba70 \u201c\uc774\ub7f0\ub2e4\uace0 \uc138\uacc4\uc778\ub4e4\uc774 \uc18d\uaca0\ub098. \uc5b4\ub9ac\uc11d\uc740 \uaf3c\uc218\u201d\ub77c\uace0 \uc9c0\uc801\ud588\ub2e4. \uadf8\ub7ec\uba74\uc11c<br>\uc9c0\ub09c 2021\ub144 \uae40\uce58\ub97c \ub2f4\uadf8\ub294 \ub3d9\uc601\uc0c1\uc5d0 \u2018\uc911\uad6d\uc74c\uc2dd\u2019(ChineseFood) \ud574\uc2dc\ud0dc\uadf8\ub97c \ub2ec\uc544 \ubb3c\uc758\ub97c \ube5a\uc740 \uc911\uad6d\uc758 \uc720\uba85 \uc720\ud29c\ubc84 \ub9ac\ucbd4\uce58(\u674e\u5b50\u67d2)\ub97c \uc5b8\uae09\ud588\ub2e4.<br>\uc11c \uad50\uc218\ub294 \u201c\uc138\uacc4\uac00 \ud55c\uad6d \ubb38\ud654\ub97c \uc8fc\ubaa9\ud558\uace0 \uc990\uae30\ub2e4 \ubcf4\ub2c8 \uc911\uad6d\uc778\ub4e4\uc758 \uc5f4\ub4f1\uac10\uc740 \ub0a0\ub85c \uc2ec\ud574\uc838 \uac00\uace0 \uc788\ub2e4. \uc6b0\ub9ac\uac00 \uc774\ub97c \uc5ed\uc774\uc6a9\ud574, \ub354 \uc138\ub828\ub41c \ubc29\uc2dd\uc73c\ub85c \uc6b0\ub9ac \ubb38\ud654\ub97c \ub110\ub9ac \uc54c\ub824 \ub098\uac00\uc57c \ud55c\ub2e4\u201d\uace0 \uc8fc\uc7a5\ud588\ub2e4.","ai_image_file_1":"https://snuss1.qualtrics.com/ControlPanel/Graphic.php?IM=IM_5EuvdbCjlRDml21","real_image_file_1":"https://snuss1.qualtrics.com/ControlPanel/Graphic.php?IM=IM_8Fxda4lmNx5DhEj","ai_caption_1":"\ud574\ub2f9 \uae30\uc0ac\uc640 \ubb34\uad00. \ud234 \uc81c\uacf5=\ud50c\ub77c\uba5c(AI \uc0dd\uc131)","real_caption_1":"\uae40\uce58\ub97c \uc790\uad6d \uc74c\uc2dd\uc774\ub77c\uace0 \uc8fc\uc7a5\ud558\ub294 \uc911\uad6d \uc778\ud50c\ub8e8\uc5b8\uc11c \ubbf8\uc2a4\ud130 \ubc4c\uc624(\uc67c\ucabd \uc0ac\uc9c4)\uc640 \ub9ac\ucbd4\uce58. \uc11c\uacbd\ub355 \uad50\uc218 \ud398\uc774\uc2a4\ubd81 \ucea1\ucc98","idx_2":"22","title_2":"\uc138\uc885 \uc5ec\ub860\uc870\uc0ac\uc2ec\uc758\uc704, \ub300\uc120 \uc5ec\ub860\uc870\uc0ac \uc65c\uace1 \uacf5\ud45c\ud55c \uc120\uac70\uc778 \uace0\ubc1c","body_2":"\uc138\uc885\uc2dc \uc120\uac70\uc5ec\ub860\uc870\uc0ac\uc2ec\uc758\uc704\uc6d0\ud68c\uac00 \uc81c21\ub300 \ub300\ud1b5\ub839 \uc120\uac70 \uc5ec\ub860\uc870\uc0ac \uacb0\uacfc\ub97c \uc65c\uace1\ud574 \uacf5\ud45c\ud55c \ud610\uc758\ub85c A\uc528\ub97c \uc138\uc885\uacbd\ucc30\uccad\uc5d0 \uace0\ubc1c\ud588\ub2e4\uace0 28\uc77c \ubc1d\ud614\ub2e4.<br>\uc138\uc885\uc5ec\uc2ec\uc704\uc5d0 \ub530\ub974\uba74 A\uc528\ub294 \uc774\ub2ec \uc911\uc21c\ucbe4 \uc120\uac70\uad6c\ubbfc 500\uc5ec\uba85\uc774 \ucc38\uc5ec\ud55c \uce74\uce74\uc624\ud1a1 \ub2e8\uccb4 \ucc44\ud305\ubc29\uc5d0 \uc5ec\ub860\uc870\uc0ac\uae30\uad00 3\uacf3\uc774 \uac01\uac01 \uc870\uc0ac\ud55c 5\uc6d4 \uc14b\uc9f8 \uc8fc \uc120\uac70\uc5ec\ub860\uc870\uc0ac \uacb0\uacfc\ub97c \ud2b9\uc815 \ud6c4\ubcf4\uc790\uc5d0\uac8c \uc720\ub9ac\ud558\ub3c4\ub85d \uc65c\uace1\ud574 \uacf5\ud45c\ud55c \ud610\uc758\ub97c \ubc1b\uace0 \uc788\ub2e4.<br>\ud604\ud589 \uacf5\uc9c1\uc120\uac70\ubc95 \uc81c96\uc870 \uc81c1\ud56d\uc740 \uc120\uac70 \uc5ec\ub860\uc870\uc0ac \uacb0\uacfc\ub97c \uc65c\uace1\ud574 \uacf5\ud45c\u00b7\ubcf4\ub3c4\ud558\ub294 \ud589\uc704\ub97c \uae08\uc9c0\ud558\uace0 \uc788\ub2e4. \uc774\ub97c \uc704\ubc18\ud560 \uacbd\uc6b0 5\ub144 \uc774\ud558\uc758 \uc9d5\uc5ed \ub610\ub294 300\ub9cc\uc6d0 \uc774\uc0c1 2000\ub9cc\uc6d0 \uc774\ud558\uc758 \ubc8c\uae08\uc5d0 \ucc98\ud574\uc9c8 \uc218 \uc788\ub2e4.<br>\uc138\uc885\uc2dc\uc5ec\uc2ec\uc704 \uad00\uacc4\uc790\ub294 \u201c\uc65c\uace1\ub41c \uc120\uac70\uc5ec\ub860\uc870\uc0ac \uacb0\uacfc\ub97c \uacf5\ud45c\ud558\ub294 \uac83\uc740 \uc120\uac70\uc5ec\ub860\uc870\uc0ac\uc758 \uc2e0\ub8b0\uc131\uc744 \uc800\ud574\ud558\ub294 \ud589\uc704\u201d\ub77c\uba70 \u201c\uc704\ubc95\ud589\uc704\ub97c \uc9d1\uc911 \ub2e8\uc18d\ud574 \uc5c4\uc911 \uc870\uce58\ud560 \uacc4\ud68d\u201d\uc774\ub77c\uace0 \ub9d0\ud588\ub2e4.","ai_image_file_2":"https://snuss1.qualtrics.com/ControlPanel/Graphic.php?IM=IM_qP6xnknNkf4wN4r","real_image_file_2":"https://snuss1.qualtrics.com/ControlPanel/Graphic.php?IM=IM_DiXZ72zc7JFSvgm","ai_caption_2":"AI \uc774\ubbf8\uc9c0 \uc0dd\uc131\uae30\ub85c \ub9cc\ub4e0 \uc0ac\uc9c4. \ud234 \uc81c\uacf5 = \ud50c\ub77c\uba5c","real_caption_2":"","idx_3":"245","title_3":"\ubcf5\ub3c4 \uc18c\uc74c \uc2dc\ube44\ub85c \uc774\uc6c3\uc5ec\uc131 \ud3ed\ud589\ud574 \ub1cc\ucd9c\ud608 20\ub300 2\uba85 \uc2e4\ud615","body_3":"\uc624\ud53c\uc2a4\ud154 \ubcf5\ub3c4\uc5d0\uc11c \uc18c\uc74c\uc73c\ub85c \uc2dc\ube44\uac00 \ubd99\uc740 \uc774\uc6c3\uc9d1 \uc5ec\uc131\uc744 \ud3ed\ud589\ud574 \uc911\uc0c1\uc744 \uc785\ud78c 20\ub300 \ub0a8\uc131 2\uba85\uc774 \uc2e4\ud615\uc744 \uc120\uace0\ubc1b\uc558\ub2e4.<br>\uc778\ucc9c\uc9c0\ubc95 \ud615\uc0ac18\ub2e8\ub3c5 \uc724\uc815 \ud310\uc0ac\ub294 \ud3ed\ub825\ud589\uc704 \ub4f1 \ucc98\ubc8c\uc5d0 \uad00\ud55c \ubc95\ub960\uc0c1 \uacf5\ub3d9\uc0c1\ud574 \ud610\uc758\ub85c \uae30\uc18c\ub41c A\uc528(26)\ub4f1 2\uba85\uc5d0\uac8c \uc9d5\uc5ed 4\uac1c\uc6d4, \uc9d5\uc5ed 2\uac1c\uc6d4\uc744 \uac01\uac01 \uc120\uace0\ud588\ub2e4\uace0 6\uc77c \ubc1d\ud614\ub2e4.<br>A\uc528 \ub4f1\uc740 2022\ub144 9\uc6d4 1\uc77c \uc624\uc804 1\uc2dc 44\ubd84\uaed8 \uc778\ucc9c\uc2dc \uc911\uad6c \uc624\ud53c\uc2a4\ud154 \ubcf5\ub3c4\uc5d0\uc11c \uc774\uc6c3\uc9d1\uc5d0 \uc0ac\ub294 30\ub300 \uc5ec\uc131 B\uc528\ub97c \ud3ed\ud589\ud574 \ub2e4\uce58\uac8c \ud55c \ud610\uc758\ub85c \uc7ac\ud310\uc5d0 \ub118\uaca8\uc84c\ub2e4.<br>\uc774\ub4e4\uc740 \uc624\ud53c\uc2a4\ud154 \ubcf5\ub3c4\uc5d0\uc11c \ud0dd\ubc30 \ubb3c\uac74\uc744 \ubcbd\uc5d0 \ub358\uc9c0\ub358 B\uc528\uc5d0\uac8c \uc870\uc6a9\ud788 \ud574 \ub2ec\ub77c\uace0 \ud588\ub2e4\uac00 \ubc1c\ub85c \ucc28\uc774\uc790 \ud654\uac00 \ub098 \ubc94\ud589\ud55c \uac83\uc73c\ub85c \uc870\uc0ac\ub410\ub2e4.<br>A\uc528 \uc8fc\uba39\uc5d0 \uc5bc\uad74\uc744 8\ucc28\ub840 \ub9de\uc740 B\uc528\ub294 \uba38\ub9ac\ub97c \ubcbd\uc5d0 \ubd80\ub52a\ud614\uace0, \ub1cc\ucd9c\ud608\ub85c \ubcd1\uc6d0\uc5d0\uc11c \uc804\uce58 6\uc8fc \uc9c4\ub2e8\uc744 \ubc1b\uc558\ub2e4.<br>\uc724 \ud310\uc0ac\ub294 \u201c\ud53c\uace0\uc778\ub4e4\uc740 \ud53c\ud574\uc790\uc640 \ud569\uc758\ud558\uc9c0 \ubabb\ud588\ub2e4\"\uba70 \"\ud53c\ud574\uc790\ub294 \uc774 \uc0ac\uac74\uc73c\ub85c \uc2e0\uccb4\uc801\u00b7\uc815\uc2e0\uc801 \uace0\ud1b5\uc744 \uacaa\uc740 \uac83\uc73c\ub85c \ubcf4\uc778\ub2e4\u201d\uace0 \ud310\ub2e8\ud588\ub2e4.<br>\ub2e4\ub9cc \u201c\ud53c\uace0\uc778\ub4e4\uc774 \uc798\ubabb\uc744 \ubc18\uc131\ud558\uace0 \uc788\ub294 \uac83\uc73c\ub85c \ubcf4\uc778\ub2e4. \uacfc\uac70\uc5d0 \ucc98\ubc8c\ubc1b\uc740 \uc804\ub825\uc774 \uc5c6\ub294 \uc810 \ub4f1\ub3c4 \uace0\ub824\ud588\ub2e4\u201d\uace0 \uc591\ud615 \uc774\uc720\ub97c \ubc1d\ud614\ub2e4.","ai_image_file_3":"https://snuss1.qualtrics.com/ControlPanel/Graphic.php?IM=IM_NQft8jx7reGyU4f","real_image_file_3":"https://snuss1.qualtrics.com/ControlPanel/Graphic.php?IM=IM_oSDOv5WjnUBfIne","ai_caption_3":"\uc624\ud53c\uc2a4\ud154 \ubcf5\ub3c4\uc5d0\uc11c \uc18c\uc74c\uc73c\ub85c \uc2dc\ube44\uac00 \ubd99\uc740 \uc774\uc6c3\uc9d1 \uc5ec\uc131\uc744 \ud3ed\ud589\ud574 \uc911\uc0c1\uc744 \uc785\ud78c 20\ub300 \ub0a8\uc131 2\uba85\uc774 \uc2e4\ud615\uc744 \uc120\uace0\ubc1b\uc558\ub2e4.  \uc790\ub8cc \uc774\ubbf8\uc9c0. [\uc774\ubbf8\uc9c0 \ucd9c\ucc98 = \ucc57GPT]","real_caption_3":"\uae40\uacbd\uc9c4 \uae30\uc790","idx_4":"71","title_4":"\uc81c\uc8fc\uc11c \ubb34\ub4f1\ub85d\uc5ec\ud589\uc5c5\uc790\uc640 \uacf5\ubaa8 \uc678\uad6d\uc778 \ud658\uc790 \uc720\uce58 \ubcd1\uc6d0\uc7a5 \ub4f1 3\uba85 \uae30\uc18c","body_4":"\uc81c\uc8fc\uc5d0\uc11c \uc911\uad6d\uc778 \ubb34\ub4f1\ub85d \uc5ec\ud589\uc5c5\uc790\uc640 \uacf5\ubaa8\ud574 \ubd88\ubc95\uc73c\ub85c \uc678\uad6d\uc778 \ud658\uc790\ub97c \uc720\uce58\ud55c \uc758\ub8cc\uae30\uad00 \uc6d0\uc7a5 \ub4f1 3\uba85\uc774 \uc7ac\ud310\uc5d0 \ub118\uaca8\uc84c\ub2e4.<br>\uc81c\uc8fc\uc9c0\uac80 \ud615\uc0ac3\ubd80\ub294 \u2018\uc758\ub8cc\ud574\uc678\uc9c4\ucd9c \ubc0f \uc678\uad6d\uc778\ud658\uc790\uc720\uce58\uc9c0\uc6d0\uc5d0 \uad00\ud55c \ubc95\ub960 \uc704\ubc18\u2019 \ub4f1\uc758 \ud610\uc758\ub85c \uc81c\uc8fc\uc9c0\uc5ed \ubaa8 \uc758\uc6d0 \ub300\ud45c\uc6d0\uc7a5 A\uc528(48)\uc640 \uacbd\uc601\uc774\uc0ac B\uc528(51)\ub97c \ubd88\uad6c\uc18d \uae30\uc18c\ud588\ub2e4\uace0 8\uc77c \ubc1d\ud614\ub2e4.<br>\ub610 \uacf5\ubc94\uc778 \uc911\uad6d\uc778 \ubb34\ub4f1\ub85d \uc5ec\ud589\uc5c5\uc790 C\uc528(42)\ub97c \uad00\uad11\uc9c4\ud765\ubc95\uc704\ubc18 \ud610\uc758\ub85c \ubd88\uad6c\uc18d \uae30\uc18c\ud588\ub2e4. \ub610\ub2e4\ub978 \uacf5\ubc94 \uc911\uad6d\uc778 D\uc528\ub294 \uc218\uc0ac \uacfc\uc815\uc5d0\uc11c \uc911\uad6d\uc73c\ub85c \ub3c4\ud53c\ud574 \uae30\uc18c\uc911\uc9c0\ub410\ub2e4.<br>\uc81c\uc8fc\uc9c0\uc5ed \ubaa8 \uc758\uc6d0\uc758 \ub300\ud45c\uc6d0\uc7a5 A\uc528\uc640 \uacbd\uc601\uc774\uc0ac B\uc528\ub294 2023\ub144 8\uc6d430\uc77c\ubd80\ud130 2024\ub144 9\uc6d420\uc77c\uae4c\uc9c0 \uc911\uad6d\uc778 C(42)\u00b7D(42)\uc528\ub85c\ubd80\ud130 \uc9c4\ub8cc\ube44\uc758 10\u223c15\uff05\ub97c \uc218\uc218\ub8cc\ub85c \uc9c0\uae09\ud558\ub294 \ub300\uac00\ub85c \uc678\uad6d\uc778 \ud658\uc790 17\uba85\uc744 \uc18c\uac1c\ubc1b\uc740 \ud610\uc758\ub97c \ubc1b\ub294\ub2e4.<br>A\uc640 B\uc528\ub294 \uc911\uad6d\uc778 C\u00b7D\uc528\uac00 \uc678\uad6d\uc778 \ud658\uc790 \uc720\uce58\uc0ac\uc5c5\uc790\ub85c \ub4f1\ub85d\ub418\uc9c0 \uc54a\uc740 \uc0ac\uc2e4\uc744 \uc54c\uace0\ub3c4 \uc678\uad6d\uc778 \ud658\uc790\ub97c \uc18c\uac1c\ubc1b\uc558\ub2e4. \uc774\ub4e4\uc5d0\uac8c \uc9c4\ub8cc\ube44 1\uc5b5180\ub9cc\uc6d0 \uc911 1250\ub9cc\uc6d0\uc744 \uc218\uc218\ub8cc\ub85c \uc9c0\uae09\ud55c \uac83\uc73c\ub85c \uc870\uc0ac\ub410\ub2e4.<br>\uc758\ub8cc\ud574\uc678\uc9c4\ucd9c\ubc95\uc5d0 \ub530\ub974\uba74 \uc678\uad6d\uc778 \ud658\uc790 \uc720\uce58 \ub4f1\ub85d\uc744 \ud558\uc9c0 \uc54a\uace0 \uc678\uad6d\uc778 \ud658\uc790\ub97c \uc720\uce58\ud560 \uacbd\uc6b0 3\ub144 \uc774\ud558\uc758 \uc9d5\uc5ed \ub610\ub294 3000\ub9cc\uc6d0 \uc774\ud558\uc758 \ubc8c\uae08\uc5d0 \ucc98\ud55c\ub2e4.<br>\uac80\ucc30\uc740 \u201c\ubb34\ub4f1\ub85d \uc720\uce58\uc5c5\uc790\uc5d0 \uc758\ud55c \ubb34\ubd84\ubcc4\ud55c \uc678\uad6d\uc778 \ud658\uc790 \uc720\uce58\ub294 \uc81c\uc8fc \uc9c0\uc5ed\uacbd\uc81c \uae30\uc5ec\ubcf4\ub2e4\ub294 \uc758\ub8cc\uc774\uc6a9 \ud3b8\uc758 \uc800\ud558, \ud53c\ubd80\uacfc\u00b7\uc131\ud615\uc678\uacfc\ub85c\uc758 \ud544\uc218\uc758\ub8cc \uc778\ub825 \uc720\ucd9c \ub4f1\uc758 \ubd80\uc791\uc6a9\uacfc \ud568\uaed8 \uc81c\uc8fc\uc9c0\uc5ed \uc758\ub8cc \uc9c8\uc11c\ub97c \ud6fc\uc190\ud560 \uac00\ub2a5\uc131\uc774 \uc788\ub2e4\u201d\uba74\uc11c \u201c\uc678\uad6d\uc778 \ud658\uc790 \uc5ed\uc2dc \uacfc\uc789\uc9c4\ub8cc \uc720\ub3c4, \uc758\ub8cc\uc0ac\uace0 \ubc1c\uc0dd\uc5d0 \ub530\ub978 \ubcf4\ud5d8 \ubc30\uc0c1\uc774 \uc5b4\ub824\uc6b4 \uc704\ud5d8\uc774 \uc788\ub2e4\u201d\uace0 \ubc1d\ud614\ub2e4.","ai_image_file_4":"https://snuss1.qualtrics.com/ControlPanel/Graphic.php?IM=IM_UZy7357LBPsCmXu","real_image_file_4":"https://snuss1.qualtrics.com/ControlPanel/Graphic.php?IM=IM_GVAdhh9tVPpOpxW","ai_caption_4":"\ud574\ub2f9 \uae30\uc0ac\uc640 \ubb34\uad00. \ud234 \uc81c\uacf5=\ud50c\ub77c\uba5c(AI \uc0dd\uc131)","real_caption_4":"\uc81c\uc8fc\uc9c0\ubc29\uac80\ucc30\uccad.","idx_5":"238","title_5":"\uac15\ub0a8 \u2018\uc74c\uc8fc \ube91\uc18c\ub2c8\u2019 \ub864\uc2a4\ub85c\uc774\uc2a4 \u2018\ubc94\uc11c\ubc29\ud30c\u2019 \uace0\ubb38\uc774\uc5c8\ub2e4","body_5":"\uc11c\uc6b8 \uac15\ub0a8\uc5d0\uc11c \uc74c\uc8fc \uc6b4\uc804\uc744 \ud558\ub2e4 \ubca4\ud2c0\ub9ac \ucc28\ub7c9\uc744 \ub4e4\uc774\ubc1b\uc740 \ub4a4 \ub3c4\uc8fc\ud55c \ub864\uc2a4\ub85c\uc774\uc2a4 \ucc28\uc8fc\uac00 \uc7a1\uace0 \ubcf4\ub2c8 \uc870\uc9c1\ud3ed\ub825\ubc30 \ubc94\uc11c\ubc29\ud30c\uc758 \uace0\ubb38\uc778 \uac83\uc73c\ub85c \ub098\ud0c0\ub0ac\ub2e4.\n\uc11c\uc6b8 \uac15\ub0a8\uacbd\ucc30\uc11c\ub294 14\uc77c \ub9cc\ucde8 \uc0c1\ud0dc\ub85c \ub864\uc2a4\ub85c\uc774\uc2a4 \ucc28\ub7c9\uc744 \ubab0\ub2e4 \uc8fc\ucc28\ub41c \ubca4\ud2c0\ub9ac \ucc28\ub7c9\uc744 \ub4e4\uc774\ubc1b\uace0 \ub2ec\uc544\ub09c \ud610\uc758\ub85c \ub098\ubaa8(59)\uc528\uc758 \uad6c\uc18d\uc601\uc7a5\uc744 \uc2e0\uccad\ud588\ub2e4.\n\uacbd\ucc30\uc5d0 \ub530\ub974\uba74 \ub098\uc528\ub294 \uc9c0\ub09c\ub2ec 25\uc77c \uc624\ud6c4 8\uc2dc\ucbe4 \uc220\uc744 \ub9c8\uc2e0 \ucc44 \ucc28\ub97c \ubab0\ub2e4 \uac15\ub0a8\uad6c \ub17c\ud604\ub3d9 \ud55c \ub3c4\ub85c\uc5d0\uc11c \ubc1c\ub808\ud30c\ud0b9(\ub300\ub9ac\uc8fc\ucc28)\uc744 \uc704\ud574 \uc8fc\ucc28\ub41c \ubca4\ud2c0\ub9ac \ucc28\ub7c9\uc744 \ub4e4\uc774\ubc1b\uc740 \ub4a4 \ud604\uc7a5\uc744 \ubc97\uc5b4\ub09c \ud610\uc758(\ub3c4\ub85c\uad50\ud1b5\ubc95\uc0c1 \uc74c\uc8fc\uc6b4\uc804 \ubc0f \uc0ac\uace0 \ud6c4 \ubbf8\uc870\uce58 \ub4f1)\ub97c \ubc1b\uace0 \uc788\ub2e4.\n\uc0ac\uace0 \ucda9\uaca9\uc73c\ub85c \ubca4\ud2c0\ub9ac \ucc28\ub7c9\uc774 \ubc00\ub9ac\uba74\uc11c \uc778\uadfc\uc5d0 \uc11c \uc788\ub358 50\ub300 \ubc1c\ub808\ud30c\ud0b9 \uc9c1\uc6d0\uc774 \ub2e4\ub9ac\ub97c \ub2e4\ucce4\ub2e4. \uc0ac\uace0 \ub2f9\uc2dc \ub098\uc528\uc758 \ud608\uc911\uc54c\ucf54\uc62c\ub18d\ub3c4\ub294 \uba74\ud5c8\ucde8\uc18c \uc218\uc900\uc774\uc5c8\ub358 \uac83\uc73c\ub85c \uc870\uc0ac\ub410\ub2e4.\n\uacbd\ucc30\uc740 \uc218\uc0ac \uacfc\uc815\uc5d0\uc11c \ub098\uc528\uac00 \uad6d\ub0b4 3\ub300 \ud3ed\ub825\uc870\uc9c1 \uc911 \ud558\ub098\uc778 \u2018\ubc94\uc11c\ubc29\ud30c\u2019\uc758 \uace0\ubb38\uc774\ub77c\ub294 \uc0ac\uc2e4\uc744 \ud30c\uc545\ud588\ub2e4. \uc11c\uc6b8 \uac15\ub0a8\uad6c\uc758 \uc720\uba85 \uace0\uae43\uc9d1\uc744 \uc6b4\uc601\ud558\uae30\ub3c4 \ud588\ub358 \ub098\uc528\ub294 2013\ub144 \ub450\ubaa9 \uae40\ud0dc\ucd0c\uc528\uac00 \uc0ac\ub9dd\ud55c \ub4a4 \uc870\uc9c1 \ub0b4\uc5d0\uc11c \ud575\uc2ec\uc801 \uc5ed\ud560\uc744 \ud55c \uac83\uc73c\ub85c \uc54c\ub824\uc84c\ub2e4.\n\ub098\uc528\ub294 2009\ub144 11\uc6d4 \uac15\ub0a8\uad6c \uc77c\ub300\uc5d0\uc11c \ubc94\uc11c\ubc29\ud30c\uc640 \uce60\uc131\ud30c \uc870\uc9c1\uc6d0\uc774 \ud68c\uce7c\uacfc \uc57c\uad6c\ubc29\ub9dd\uc774 \ub4f1\uc744 \ub4e4\uace0 24\uc2dc\uac04 \ub3d9\uc548 \u2018\ub300\uce58\uadf9\u2019\uc744 \ubc8c\uc600\uc744 \ub54c \ubc94\uc11c\ubc29\ud30c\ub97c \uc9c0\ud718\ud55c \ud610\uc758 \ub4f1\uc73c\ub85c \uad6c\uc18d\ub410\ub2e4.\n2013\ub144 2\uc6d4\uc5d0\ub294 \uac15\ub0a8\uad6c \ud55c \ucee4\ud53c\uc20d \uc55e\uc5d0\uc11c \uacbd\uc7c1\uc870\uc9c1\uc778 \u2018\uad6d\uc81cPJ\ud30c\u2019 \ubd80\ub450\ubaa9\uc5d0\uac8c \ub0a9\uce58\ub3fc \ud3ed\ud589\ub2f9\ud558\uae30\ub3c4 \ud588\ub2e4. \uacbd\ucc30\uc740 \ub098\uc528\uc758 \uc2e0\ubcd1\uc744 \ud655\ubcf4\ud574 \uc790\uc138\ud55c \uc0ac\uac74 \uacbd\uc704\ub97c \uc870\uc0ac\ud55c \ub4a4 \uc870\ub9cc\uac04 \uac80\ucc30\uc5d0 \uc1a1\uce58\ud560 \uacc4\ud68d\uc774\ub2e4.\n\ucd5c\uc608\uc2ac \uae30\uc790 smarty@kmib.co.kr\nGoodNews paper \u24d2\n, \ubb34\ub2e8\uc804\uc7ac, \uc218\uc9d1, \uc7ac\ubc30\ud3ec \ubc0f AI\ud559\uc2b5 \uc774\uc6a9 \uae08\uc9c0","ai_image_file_5":"https://snuss1.qualtrics.com/ControlPanel/Graphic.php?IM=IM_bxnSBAI7Vjx6My6","real_image_file_5":"https://snuss1.qualtrics.com/ControlPanel/Graphic.php?IM=IM_EGgeOd07uWcFcje","ai_caption_5":"\uc11c\uc6b8 \uac15\ub0a8\uacbd\ucc30\uc11c\ub294 14\uc77c \ub9cc\ucde8 \uc0c1\ud0dc\ub85c \ub864\uc2a4\ub85c\uc774\uc2a4 \ucc28\ub7c9\uc744 \ubab0\ub2e4 \uc8fc\ucc28\ub41c \ubca4\ud2c0\ub9ac \ucc28\ub7c9\uc744 \ub4e4\uc774\ubc1b\uace0 \ub2ec\uc544\ub09c \ud610\uc758\ub85c \ub098\ubaa8(59)\uc528\uc758 \uad6c\uc18d\uc601\uc7a5\uc744 \uc2e0\uccad\ud588\ub2e4. [\uc0ac\uc9c4\ucd9c\ucc98 = \ucc57GPT]","real_caption_5":"\uae30\uc0ac\uc758 \uc774\ud574\ub97c \ub3d5\uae30 \uc704\ud55c \uc774\ubbf8\uc9c0. \uae30\uc0ac \ub0b4\uc6a9\uacfc \uc9c1\uc811 \uad00\ub828\uc774 \uc5c6\uc2b5\ub2c8\ub2e4. \uc5f0\ud569\ub274\uc2a4","idx_6":"62","title_6":"LG\ub514\uc2a4\ud50c\ub808\uc774, \uccad\uc0c9 \uc778\uad11 \uc801\uc6a9\ud55c OLED \ud328\ub110 \uc81c\ud488\ud654 \uac80\uc99d","body_6":"\ud615\uad11\uacfc \uc778\uad11\uc758 \ubc1c\uad11 \uba54\ucee4\ub2c8\uc998 \uad6c\uc870\ub3c4. LG\ub514\uc2a4\ud50c\ub808\uc774 \uc81c\uacf5<br>LG\ub514\uc2a4\ud50c\ub808\uc774\uac00 \uc138\uacc4 \ucc98\uc74c\uc73c\ub85c \uc591\uc0b0 \uc2dc\uc124\uc5d0\uc11c \uccad\uc0c9 \uc778\uad11 \uc720\uae30\ubc1c\uad11\ub2e4\uc774\uc624\ub4dc(OLED) \ud328\ub110 \uc81c\ud488\ud654 \uc131\ub2a5 \uac80\uc99d\uc5d0 \uc131\uacf5\ud588\ub2e4\uace0 1\uc77c \ubc1d\ud614\ub2e4. 2024\ub144 \ubbf8\uad6d \ub514\uc2a4\ud50c\ub808\uc774 \uc18c\uc7ac\uc5c5\uccb4 UDC\uc640 \uc190\uc7a1\uace0 \uccad\uc0c9 \uc778\uad11\uc744 \uac1c\ubc1c\ud55c \ub370 \uc774\uc5b4 \uc57d 8\uac1c\uc6d4 \ub9cc\uc758 \uc131\uacfc\ub2e4.<br>OLED \ud328\ub110\uc758 \ubc1c\uad11 \ubc29\uc2dd\uc740 \ud06c\uac8c \ud615\uad11\uacfc \uc778\uad11\uc73c\ub85c \ub098\ub25c\ub2e4. \uc804\uae30\uac00 \ub4e4\uc5b4\uc624\uba74 \ubc14\ub85c \ubc18\uc751\ud574 \ube5b\uc744 \ub0b4\ub294 \ud615\uad11\uc740 \ubc1c\uad11 \ud6a8\uc728\uc774 25%\uc5d0 \uadf8\uce58\ub294 \ubc18\uba74 \uc804\uae30 \uc5d0\ub108\uc9c0\ub97c \uc800\uc7a5\ud588\ub2e4\uac00 \ube5b\uc744 \ub0b4\ub294 \uc778\uad11\uc740 \ubc1c\uad11 \ud6a8\uc728\uc774 100%\uc5d0 \ub2ec\ud55c\ub2e4. \uadf8\ub9cc\ud07c \uc804\ub825 \uc18c\ubaa8\ub3c4 \uc801\ub2e4.\ube5b\uc758 \uc0bc\uc6d0\uc0c9 \uc911 \uc801\uc0c9, \ub179\uc0c9 \uc778\uad11\uc774 \uc0c1\uc6a9\ud654\ub41c \uc9c0 20\uc5ec \ub144\uc774 \uc9c0\ub0ac\uc9c0\ub9cc \ud30c\uc7a5\uc774 \uc9e7\uace0 \ud070 \uc5d0\ub108\uc9c0\uac00 \ud544\uc694\ud55c \uccad\uc0c9 \uc778\uad11\uc740 \uc0c1\uc6a9\ud654\uc5d0 \ubc88\ubc88\uc774 \uc2e4\ud328\ud588\ub2e4.<br>LG\ub514\uc2a4\ud50c\ub808\uc774\ub294\uc544\ub798\uce35\uc5d0\ub294 \uccad\uc0c9 \ud615\uad11 \ubb3c\uc9c8\uc744, \uc704\uce35\uc5d0\ub294 \uccad\uc0c9 \uc778\uad11\uc744 \uc313\ub294 \ud558\uc774\ube0c\ub9ac\ub4dc \ud22c \uc2a4\ud0dd \ud0e0\ub364(2 Stack Tandem) \uad6c\uc870\ub85c OLED \uccad\uc0c9 \uc778\uad11 \uac1c\ubc1c\uc5d0 \uc131\uacf5\ud588\ub2e4. \ud2b9\ud788 \uc591\uc0b0 \ub77c\uc778\uc5d0\uc11c\uc758 \uc131\ub2a5 \ud3c9\uac00, \uad11\ud559 \ud2b9\uc131, \uacf5\uc815\uc131 \ub4f1\uc744 \ubaa8\ub450 \ud655\uc778\ud574 \uc81c\ud488\ud654 \ub2e8\uacc4\uae4c\uc9c0 \uc131\uacf5\ud55c \uc0ac\ub840\ub294 LG\ub514\uc2a4\ud50c\ub808\uc774\uac00 \uc138\uacc4 \ucc98\uc74c\uc73c\ub85c, UDC\uc640 \ud568\uaed8 \uc81c\ud488\ud654 \uac80\uc99d\uae4c\uc9c0 \ub9c8\ucce4\ub2e4. LG\ub514\uc2a4\ud50c\ub808\uc774\ub294 \ud558\uc774\ube0c\ub9ac\ub4dc \uc778\uad11 \ube14\ub8e8 \ud0e0\ub364 \uae30\uc220\ud2b9\ud5c8\ub97c \ud55c\uad6d\uacfc \ubbf8\uad6d\uc5d0 \ubaa8\ub450 \ub2e8\ub3c5 \ucd9c\uc6d0\ud55c \uc0c1\ud0dc\ub2e4. \uc774 \uae30\uc220\uc774 \uc801\uc6a9\ub41cOLED \ud328\ub110\uc740 11\uc77c(\ud604\uc9c0\uc2dc\uac04)\ubd80\ud130 \ubbf8\uad6d \uce98\ub9ac\ud3ec\ub2c8\uc544\uc8fc \uc0c8\ub108\uc81c\uc774\uc5d0\uc11c \uc5f4\ub9ac\ub294 \uc138\uacc4 \ucd5c\ub300 \ub514\uc2a4\ud50c\ub808\uc774 \ud589\uc0ac '\uad6d\uc81c\uc815\ubcf4\ub514\uc2a4\ud50c\ub808\uc774\ud559\ud68c(SID) 2025'\uc5d0\uc11c \ubcfc \uc218\uc788\ub2e4.<br>\uc724\uc218\uc601 LG\ub514\uc2a4\ud50c\ub808\uc774 \ucd5c\uace0\uae30\uc220\ucc45\uc784\uc790(CTO\u00b7\ubd80\uc0ac\uc7a5)\ub294 \"\uafc8\uc758 OLED\ub97c \uc704\ud55c \ub9c8\uc9c0\ub9c9 \ud37c\uc990\ub85c \ubd88\ub9ac\ub294 \uccad\uc0c9 \uc778\uad11 \uc81c\ud488\ud654 \uac80\uc99d \uc131\uacf5\uc740 \ucc28\uc138\ub300 OLED\ub85c \ud5a5\ud558\ub294 \ud601\uc2e0\uc801 \uc774\uc815\ud45c\uac00 \ub420 \uac83\"\uc774\ub77c\uace0 \ubc1d\ud614\ub2e4.","ai_image_file_6":"https://snuss1.qualtrics.com/ControlPanel/Graphic.php?IM=IM_4yd0Ytu7m9YnF09","real_image_file_6":"https://snuss1.qualtrics.com/ControlPanel/Graphic.php?IM=IM_4LmORndUVUyibWr","ai_caption_6":"\uc624\ud508AI \ub2ec\ub9ac\ub85c \uc0dd\uc131","real_caption_6":"","idx_7":"200","title_7":"\u65e5 \ub300\ud559\uc0dd 10\uba85 \uc911 3\uba85 \u201c\uc778\ud134 \ub54c \uc131\ud76c\ub871 \uacbd\ud5d8\u201d","body_7":"\uc77c\ubcf8 \ub300\ud559\uc0dd 10\uba85 \uc911 3\uba85\uc774 \ucde8\uc5c5 \ud65c\ub3d9 \uacfc\uc815\uc5d0\uc11c \uc131\ud76c\ub871\uc744 \uacaa\uc5c8\ub2e4\ub294 \uc870\uc0ac \uacb0\uacfc\uac00 \ub098\uc654\ub2e4.<br>18\uc77c \ub2c8\ud63c\uac8c\uc774\uc790\uc774\uc2e0\ubb38\uc5d0 \ub530\ub974\uba74 \uc77c\ubcf8 \ud6c4\uc0dd\ub178\ub3d9\uc131\uc774 \uc678\ubd80 \ubbfc\uac04\uae30\uad00\uc5d0 \uc758\ub8b0\ud574 2020\u223c2022\ub144 \ub300\ud559\uc744 \uc878\uc5c5\ud55c 1000\uba85\uc744 \ub300\uc0c1\uc73c\ub85c \uc9c0\ub09c 1\uc6d4 \uc870\uc0ac\ud55c \uacb0\uacfc \uc774\uac19\uc774 \ub098\ud0c0\ub0ac\ub2e4. \uc774 \uc870\uc0ac\uc5d0\uc11c \ub300\ud559 \uc7ac\ud559 \uc911 \uc778\ud134\uc2ed \uacbd\ud5d8\uc790 30.1%\uac00 \uc131\ud76c\ub871\uc744 \ud55c \ucc28\ub840 \uc774\uc0c1 \uacaa\uc5c8\ub2e4\uace0 \uc751\ub2f5\ud588\ub2e4.<br>\ud53c\ud574 \uc720\ud615\ubcc4\ub85c\ub294 \u2018\uc131\uc801 \ub18d\ub2f4\u00b7\ub180\ub9bc\u2019(38.2%), \u2018\uc2dd\uc0ac \ub610\ub294 \ub370\uc774\ud2b8 \uad8c\uc720\u2019(35.1%), \u2018\ubd88\ud544\uc694\ud55c \uc2e0\uccb4 \uc811\ucd09\u2019(27.2%), \u2018\uc131\uc801 \uad00\uacc4 \uac15\uc694\u2019(19.7%) \ub4f1\uc73c\ub85c \uc870\uc0ac\ub410\ub2e4. \uc131\ubcc4\ub85c \ubcf4\uba74 \ub0a8\uc131 32.4%, \uc5ec\uc131 27.5%\uac00 \ud53c\ud574 \uacbd\ud5d8\uc774 \uc788\ub2e4\uace0 \uc751\ub2f5\ud588\ub2e4.<br>\uc751\ub2f5\uc790 31.9%\ub294 \uae30\uc5c5\uc124\uba85\ud68c, \uba74\uc811 \ub4f1 \uc778\ud134\uc2ed \uc678 \ucde8\uc5c5 \ud65c\ub3d9\uc5d0\uc11c \uc131\ud76c\ub871\uc744 \uacaa\uc5c8\ub2e4\uace0 \ub2f5\ud588\ub2e4. \uc774 \uc124\ubb38\uc5d0\uc11c\ub3c4 \ub0a8\uc131(34.3%)\uc774 \uc5ec\uc131(28.8%)\ubcf4\ub2e4 \ub192\uc740 \uc751\ub2f5\ub960\uc744 \ubcf4\uc600\ub2e4.<br>\ub2c8\ud63c\uac8c\uc774\uc790\uc774\uc2e0\ubb38\uc740 \ub0a8\uc131 \ud53c\ud574 \uc751\ub2f5\ub960\uc774 \ub192\uc740 \uc774\uc720\uc640 \uad00\ub828\ud574 \u201c\uc5ec\uc131\uc5d0 \ub300\ud574\uc120 (\uae30\uc5c5\uc774) \uc5b8\ud589\uc5d0 \ub354 \uc8fc\uc758\ud588\uc744 \uac00\ub2a5\uc131\uc774 \uc788\ub2e4\u201d\uace0 \uc124\uba85\ud588\ub2e4.","ai_image_file_7":"https://snuss1.qualtrics.com/ControlPanel/Graphic.php?IM=IM_SwQmQ7FBJ0QFRAl","real_image_file_7":"https://snuss1.qualtrics.com/ControlPanel/Graphic.php?IM=IM_0oJzztCYpazAmWN","ai_caption_7":"[\uc0ac\uc9c4 \uc81c\uacf5 = \ucc57GPT]","real_caption_7":"","idx_8":"68","title_8":"\"\uc65c \uc774\ub9ac \ube68\ub9ac \ub2f3\uc9c0?\" \uc560\ud50c, \uc544\uc774\ud3f0 \ubc30\ud130\ub9ac \uc218\uba85 \ub298\ub9b0\ub2e4\ub294\ub370 \uc5b4\ub5bb\uac8c?","body_8":"\uc560\ud50c\uc774 \uc778\uacf5\uc9c0\ub2a5(AI) \uae30\uc220\uc744 \ud65c\uc6a9\ud574 \uc544\uc774\ud3f0 \ubc30\ud130\ub9ac \uc218\uba85\uc744 \ub298\ub9ac\ub294 \uae30\ub2a5\uc744 \ub3c4\uc785\ud560 \uacc4\ud68d\uc778 \uac83\uc73c\ub85c \uc804\ud574\uc84c\ub2e4.<br>13\uc77c(\ud604\uc9c0\uc2dc\uac04) \ube14\ub8f8\ubc84\uadf8 \ud1b5\uc2e0\uc740 \uc560\ud50c\uc774 \uadf8\ub3d9\uc548 \ubd88\ub9cc\uc774 \uc81c\uae30\ub3fc\uc628 \uc544\uc774\ud3f0 \ubc30\ud130\ub9ac \uc218\uba85 \ubb38\uc81c\ub97c \ud574\uacb0\ud558\uae30 \uc704\ud574 AI \uae30\uc220\uc744 \uc0ac\uc6a9\ud560 \uacc4\ud68d\uc774\ub77c\uace0 \uc775\uba85\uc758 \uc18c\uc2dd\ud1b5\ub4e4\uc744 \uc778\uc6a9\ud574 \ubcf4\ub3c4\ud588\ub2e4. \uc624\ub294 9\uc6d4 \uc5c5\ub370\uc774\ud2b8\ub418\ub294 \uc560\ud50c\uc758 \ucc28\uc138\ub300 \ubaa8\ubc14\uc77c \uc6b4\uc601\uccb4\uc81c iOS 19\ubd80\ud130 AI\uc5d0 \uae30\ubc18\ud55c \ubc30\ud130\ub9ac \uad00\ub9ac \ubaa8\ub4dc\ub97c \uc801\uc6a9\ud55c\ub2e4\ub294 \uac83\uc774\ub2e4.<br>\uc18c\uc2dd\ud1b5\uc5d0 \ub530\ub974\uba74 \uc0c8 \uae30\uc220\uc740 \uc0ac\uc6a9\uc790\uac00 \ud734\ub300\uc804\ud654\ub97c \uc4f0\ub294 \ubc29\uc2dd\uc744 \ubd84\uc11d\ud574 \uc5d0\ub108\uc9c0\ub97c \uc808\uc57d\ud560 \uc218 \uc788\ub3c4\ub85d \uc870\uc815\ud55c\ub2e4. \uc774 \uae30\uc220 \uc5ed\uc2dc \uc560\ud50c\uc758 AI \uc2dc\uc2a4\ud15c\uc778 '\uc560\ud50c \uc778\ud154\ub9ac\uc804\uc2a4' \ud50c\ub7ab\ud3fc\uc758 \uc77c\ubd80\ub85c \uac1c\ubc1c\ub41c\ub2e4.<br>\uc560\ud50c\uc740 \uc0ac\uc6a9\uc790 \uae30\uae30\uc5d0\uc11c \uc218\uc9d1\ud55c \ubc30\ud130\ub9ac \ub370\uc774\ud130\ub97c \ud65c\uc6a9\ud574 \uc0ac\uc6a9 \ucd94\uc138\ub97c \ud30c\uc545\ud558\uace0, \ud2b9\uc815 \uc560\ud50c\ub9ac\ucf00\uc774\uc158\uc774\ub098 \uae30\ub2a5\uc758 \uc804\ub825 \uc18c\ube44\ub97c \uc904\uc5ec\uc57c \ud558\ub294 \uc2dc\uae30\ub97c \uc608\uce21\ud560 \uacc4\ud68d\uc774\ub2e4. \ub610 \uc7a0\uae08\ud654\uba74\uc5d0\uc11c \uae30\uae30 \ucda9\uc804\uc5d0 \uac78\ub9ac\ub294 \uc2dc\uac04\uc744 \ubcf4\uc5ec\uc8fc\ub294 \uae30\ub2a5\ub3c4 \ucd94\uac00\ud560 \uc608\uc815\uc774\ub2e4.<br>\uc774\ubc88 \ubc30\ud130\ub9ac \uc131\ub2a5 \ucd5c\uc801\ud654 AI \uae30\ub2a5 \ub3c4\uc785\uc740 \uc62c \uac00\uc744 \ucd9c\uc2dc\ub420 \uc608\uc815\uc778 \uc2ac\ub9bc\ud615 \ubaa8\ub378 \u2018\uc544\uc774\ud3f0 17\u2019\uc758 \ubb3c\ub9ac\uc801 \uc81c\uc57d\uc744 \ubcf4\uc644\ud558\uae30 \uc704\ud55c \uc870\uce58\ub2e4. \uc587\uace0 \uac00\ubcbc\uc6b4 \uac8c \ud2b9\uc9d5\uc778 \uc544\uc774\ud3f0 17\uc740 \ubc30\ud130\ub9ac\uac00 \uc791\uc544\uc838 \uc218\uba85\ub3c4 \uc9e7\uc744 \uac83\uc73c\ub85c \uc608\uc0c1\ub41c\ub2e4. \ub2e4\ub9cc \uc0c8 \uae30\uc220\uc740 \uc544\uc774\ud3f0 17\uc5d0\ub9cc \uc801\uc6a9\ub418\ub294 \uac83\uc740 \uc544\ub2c8\uba70 iOS 19\uac00 \uc124\uce58\ub41c \ubaa8\ub4e0 \uc544\uc774\ud3f0 \uae30\uae30\uc5d0\uc11c \uc0ac\uc6a9\ud560 \uc218 \uc788\uc744 \uc804\ub9dd\uc774\ub2e4.","ai_image_file_8":"https://snuss1.qualtrics.com/ControlPanel/Graphic.php?IM=IM_kupy1TwfLOkj11F","real_image_file_8":"https://snuss1.qualtrics.com/ControlPanel/Graphic.php?IM=IM_bP0tijRNW7NF9DP","ai_caption_8":"\uc544\uc774\ud3f0 \uc0ac\uc6a9\uc790 (AI\ub85c \uc774\ubbf8\uc9c0 \uc0dd\uc131)","real_caption_8":"AP\uc5f0\ud569\ub274\uc2a4"}