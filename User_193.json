  "title_1": "\ucf54\uc778\uac70\ub798\uc18c \u2018\uc9c0\ub2e5\u2019, \ud574\ud0b9\uc5d0 \uace0\uac1d \uc9c0\uac11 \ud138\ub838\ub2e4 180\uc5b5 \ud53c\ud574",
  "body_1": "\uad6d\ub0b4 \uac00\uc0c1\uc790\uc0b0 \uac70\ub798\uc18c \uc9c0\ub2e5(GDAC)\uc774 \uace0\uac1d \uac00\uc0c1\uc790\uc0b0\uc744 \ubcf4\uad00\ud55c \uc9c0\uac11\uc744 \ud574\ud0b9\ub2f9\ud574, \uc804\uccb4 \ubcf4\uad00 \uc790\uc0b0\uc758 23%\ub97c \ubd84\uc2e4\ud588\ub2e4.<br>\uc9c0\ub2e5\uc740 10\uc77c \uc624\ud6c4 5\uc2dc\uaed8 \ub204\ub9ac\uc9d1\uacf5\uc9c0\uc0ac\ud56d\uc744 \ud1b5\ud574 \u201c9\uc77c \uc624\uc804 7\uc2dc \uacbd \ud56b\uc6d4\ub81b\uc5d0 \ud574\ud0b9\uc774 \ubc1c\uc0dd\ud574 \uc77c\ubd80 \uc790\uc0b0\uc774 \uc2dd\ubcc4\ub418\uc9c0 \uc54a\uc740 \uc9c0\uac11\uc73c\ub85c \ubc1c\uc1a1\ub410\ub2e4\u201d\uace0 \ubc1d\ud614\ub2e4.<br>\uc9c0\ub2e5\uc774 \ubd84\uc2e4\ud55c \uac00\uc0c1\uc790\uc0b0\uc740 \ube44\ud2b8\ucf54\uc778(BTC) 60\uc5ec\uac1c, \uc774\ub354\ub9ac\uc6c0(ETH) 350\uc5ec\uac1c, \uc704\ubbf9\uc2a4(WEMIX) 1000\ub9cc\uac1c, \ud14c\ub354(USDT) 22\ub9cc\uac1c \ub4f1\uc73c\ub85c, \uc9c0\ub2e5\uc5d0 \ubcf4\uad00 \uc911\uc774\ub358 \uc804\uccb4 \uc790\uc0b0\uc758 \uc57d 23%\uc5d0 \ud574\ub2f9\ud55c\ub2e4. \ud604\uc7ac \uc2dc\uc138 \uae30\uc900 \uc57d 180\uc5b5\uc6d0\uc5b4\uce58\ub2e4.<br>\ud56b\uc6d4\ub81b\uc774\ub780 \ub124\ud2b8\uc6cc\ud06c\uc5d0 \uc5f0\uacb0\ub41c \uc18c\ud504\ud2b8\uc6e8\uc5b4 \ud615\ud0dc \uc9c0\uac11\uc73c\ub85c, \ub124\ud2b8\uc6cc\ud06c\uc5d0 \uc5f0\uacb0\ub418\uc9c0 \uc54a\uc740 \uc774\ub3d9\ud615\uc800\uc7a5\uc7a5\uce58(USB) \ub4f1 \ud558\ub4dc\uc6e8\uc5b4 \ud615\ud0dc \u2018\ucf5c\ub4dc\uc6d4\ub81b\u2019\uc5d0 \ube44\ud574 \ud574\ud0b9 \uac00\ub2a5\uc131\uc774 \ub192\ub2e4. \uc774\uc5d0 \uc815\ubd80\ub294 \uac00\uc0c1\uc790\uc0b0 \uac70\ub798\uc18c\ub4e4\uc774 \uace0\uac1d \uc790\uc0b0\uc758 70% \uc774\uc0c1\uc744 \ucf5c\ub4dc\uc6d4\ub81b\uc5d0 \ubcf4\uad00\ud558\ub3c4\ub85d \uad8c\uace0\ud558\uace0 \uc788\ub2e4.<br>\uc9c0\ub2e5\uc740 \ud574\ud0b9 \uc0ac\uc2e4\uc744 \uc778\uc9c0\ud55c \uc989\uc2dc \ud574\ub2f9 \uc0ac\uc2e4\uc744 \uacbd\ucc30\uacfc \ud55c\uad6d\uc778\ud130\ub137\uc9c4\ud765\uc6d0(KISA), \uae08\uc735\uc815\ubcf4\ubd84\uc11d\uc6d0(FIU) \ub4f1\uc5d0 \uc54c\ub838\ub2e4\uace0 \ubc1d\ud614\ub2e4.",
  "ai_image_file_1": "https://snuss1.qualtrics.com/ControlPanel/Graphic.php?IM=IM_8IQ01Dbp5henpNg",
  "real_image_file_1": "https://snuss1.qualtrics.com/ControlPanel/Graphic.php?IM=IM_Ij13YVMOp4qNjiY",
  "ai_caption_1": "\ucd9c\ucc98: \uce74\uce74\uc624\ube0c\ub808\uc778 \uc774\ubbf8\uc9c0\uc0dd\uc131AI \u2018\uce7c\ub85c\u2019",
  "real_caption_1": "",
  "idx_2": "8",
  "title_2": "\ud68c\uc0ac\uac00 \ub098\ub220\uc900 \ubcf5\uad8c\uc774 1\ub4f1 \ub2f9\ucca8 \u201c\ub3c4\ub85c \ub0b4\ub194\u201d \uc694\uad6c \ub17c\ub780",
  "body_2": "\uc911\uad6d\uc758 \ud55c \ud68c\uc0ac\uac00 \uc0c8\ud574\ub97c \ub9de\uc544 \uc9c1\uc6d0\ub4e4\uc5d0\uac8c \ub098\ub220\uc900 \ubcf5\uad8c\uc5d0\uc11c 1\ub4f1\uc774 \ub098\uc654\ub2e4. \uadf8\ub7f0\ub370 \ud68c\uc0ac\uac00 \uc774\ub97c \ubc18\ud658\ud558\ub77c\uace0 \uc694\uad6c\ud574 \ub17c\ub780\uc774 \uc77c\uace0 \uc788\ub2e4.<br>9\uc77c(\ud604\uc9c0\uc2dc\uac01) \ud6c4\ub09c\uc77c\ubcf4 \ub4f1 \uc911\uad6d \uc5b8\ub860\uc5d0 \ub530\ub974\uba74, \uc800\uc7a5\uc131 \ub2dd\ubcf4\uc2dc\uc5d0 \uc788\ub294 \ud55c \ud68c\uc0ac\ub294 \uc0c8\ud574 \ubd84\uc704\uae30\ub97c \uace0\uc870\uc2dc\ud0a4\uae30 \uc704\ud574 \uc5f0\ub840 \ud68c\uc758\uc5d0 \ucc38\uc11d\ud55c \uc9c1\uc6d0\ub4e4\uc5d0\uac8c \ubcf5\uad8c 500\uc7a5\uc744 \uc120\ubb3c\ub85c \ub098\ub220\uc92c\ub2e4.<br>\ub73b\ubc16\uc5d0\ub3c4 \ubcf5\uad8c\uc744 \ubc1b\uc740 \uc9c1\uc6d0 \uc911 \ud55c \uba85\uc774 1\ub4f1\uc5d0 \ub2f9\ucca8\ub410\ub2e4. \ub2f9\ucca8\uae08\uc740 608\ub9cc \uc704\uc548(\uc57d 12\uc5b5 \uc6d0)\uc774\uc5c8\ub2e4.<br>\uadf8\ub7ec\uc790 \ud68c\uc0ac\ub294 \uc9c1\uc6d0\uc5d0\uac8c \ubcf5\uad8c\uc744 \ubc18\ub0a9\ud558\ub77c\uace0 \uc694\uad6c\ud588\ub2e4. \uc0c1\uae08\uc744 \ucd1d\ud68c \ucc38\uc11d\uc790\ub4e4\uc5d0\uac8c \uade0\ub4f1\ud558\uac8c \ub098\ub220\uc8fc\uaca0\ub2e4\ub294 \uc774\uc720\uc5d0\uc11c\ub2e4.<br>\ub354 \ub180\ub77c\uc6b4 \uac83\uc740 \ud68c\uc0ac\uac00 \ubcf5\uad8c\uc744 \ubc30\ud3ec\ud558\uae30 \uc804 \uc774\ubbf8 \ub2f9\ucca8 \ubc88\ud638\uac00 \ubc1c\ud45c\ub41c \uc0c1\ud0dc\uc600\ub2e4\ub294 \uc810\uc774\ub2e4.<br>\ud68c\uc0ac \ub300\ud45c\ub294 \uc7ac\ubb34 \uc9c1\uc6d0\uc5d0\uac8c \ubcf5\uad8c \ub2f9\ucca8 \uc5ec\ubd80\ub97c \uba3c\uc800 \ud655\uc778\ud558\uace0 \ubbf8\ub2f9\ucca8 \ubcf5\uad8c\uc744 \ub098\ub220\uc8fc\ub77c\uace0 \uc9c0\uc2dc\ud588\ub294\ub370, \ub2f4\ub2f9\uc790\uac00 \uc81c\ub300\ub85c \ud655\uc778\ud558\uc9c0 \uc54a\uc544 1\ub4f1 \ub2f9\ucca8 \ubcf5\uad8c\uc774 \ud3ec\ud568\ub41c \uac83\uc774\ub2e4.<br>\ub2f9\ucca8\ub41c \uc9c1\uc6d0\uc740 \ubc18\ub0a9\uc744 \uac70\ubd80\ud588\uace0, \uc591\uce21\uc740 \uacbd\ucc30\uc11c\ub97c \ucc3e\uc558\ub2e4. \uacbd\ucc30\uc740 \ubbfc\uc0ac \ubd84\uc7c1\uc778 \ub9cc\ud07c \ub2f9\uc0ac\uc790\ub4e4\uc774 \ubc95\uc801\uc73c\ub85c \ud574\uacb0\ud560 \uac83\uc744 \uad8c\ud588\ub2e4.<br>\ubc95\ub960 \uc804\ubb38\uac00\ub294 \ubcf5\uad8c\uc758 \uc18c\uc720\uad8c\uc774 \uc9c1\uc6d0\uc5d0\uac8c \uc788\ub2e4\uace0 \ubd24\ub2e4.<br>\uc911\uad6d \ubc95\ub960\uc0ac\ubb34\uc18c \ud478\ub871 \ubcc0\ud638\uc0ac\ub294 \u201c\uc9c1\uc6d0\uc774 \ubcf5\uad8c\uc5d0 \ub2f9\ucca8\ub410\ub2e4\ub294 \uc0ac\uc2e4\uc744 \uc54c\uac8c \ub41c \ud6c4 \ud68c\uc0ac\uac00 \ubc18\ub0a9\uc744 \uc694\uad6c\ud558\ub294 \uac83\uc740 \ud569\ub9ac\uc801\uc774\uc9c0\ub3c4 \ud569\ubc95\uc801\uc774\uc9c0\ub3c4 \uc54a\ub2e4\u201d\uba70 \u201c\ubcf5\uad8c\uc758 \uc18c\uc720\uad8c\uc740 \uad6c\ub9e4\uc790 \ub610\ub294 \uc218\ub839\uc778\uc5d0\uac8c \uc788\ub294\ub370, \uc774 \uc0ac\ub840\uc758 \uacbd\uc6b0 \ud68c\uc0ac\uac00 \uc120\ubb3c\ub85c \uc9c1\uc6d0\uc5d0\uac8c \uc99d\uc815\ud588\uc73c\ubbc0\ub85c, \uc18c\uc720\uad8c\uc740 \uc9c1\uc6d0\ub4e4\uc5d0\uac8c \uc774\uc804\ub41c \uac83\uc73c\ub85c \ubd10\uc57c \ud55c\ub2e4. \ub530\ub77c\uc11c \ud68c\uc0ac\ub294 \ubcf5\uad8c \ubc18\ub0a9\uc744 \uc694\uad6c\ud560 \ubc95\uc801 \uadfc\uac70\uac00 \uc5c6\ub2e4\u201d\uace0 \ub9d0\ud588\ub2e4.<br>\ub2e4\ub978 \ubcc0\ud638\uc0ac\ub3c4 \u201c\ub9cc\uc57d \ud68c\uc0ac\uac00 \uc774\ub97c \ud551\uacc4\ub85c \uc784\uae08\uc744 \uc0ad\uac10\ud558\uac70\ub098 \ud574\uace0\ud558\uaca0\ub2e4\uace0 \uc704\ud611\ud558\uba74 \uc9c1\uc6d0\uc740 \ub178\ub3d9\ubd80\uc5d0 \ud56d\uc758\uace0 \ubc95\uc801 \ub3c4\uc6c0\uc744 \ubc1b\uc744 \uad8c\ub9ac\uac00 \uc788\ub2e4\u201d\uace0 \ub367\ubd99\uc600\ub2e4.",
