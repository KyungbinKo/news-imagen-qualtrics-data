  "real_image_file_7": "https://snuss1.qualtrics.com/ControlPanel/Graphic.php?IM=IM_X7vQFg28dfaOvTu",
  "ai_caption_7": "AI \uc774\ubbf8\uc9c0.",
  "real_caption_7": "\ubcfc\ubcf4",
  "idx_8": "316",
  "title_8": "\ubd80\uc0b0 \ud55c \uc544\ud30c\ud2b8\uc11c 20\ub300 \uc5ec\uc131 \ucd94\ub77d\uc0ac \ud568\uaed8 \uc788\ub358 \ub0a8\uce5c \uc218\uc0ac",
  "body_8": "\ubd80\uc0b0 \ud55c \uc544\ud30c\ud2b8\uc5d0\uc11c \ub0a8\uc790\uce5c\uad6c\uc640 \ub9d0\ub2e4\ud23c\ud558\ub358 20\ub300 \uc5ec\uc131\uc774 \ucd94\ub77d\ud574 \uc228\uc9c0\ub294 \uc77c\uc774 \ubc1c\uc0dd\ud574 \uacbd\ucc30\uc774 \uc218\uc0ac\uc5d0 \ub098\uc130\ub2e4.<br>11\uc77c \ubd80\uc0b0 \ud574\uc6b4\ub300\uacbd\ucc30\uc11c\uc5d0 \ub530\ub974\uba74 \uc9c0\ub09c 8\uc6d4 31\uc77c \uc624\ud6c4 8\uc2dc 18\ubd84\ucbe4 \ud574\uc6b4\ub300\uad6c \ud55c \uc544\ud30c\ud2b8 20\uce35\uc5d0\uc11c 20\ub300 \uc5ec\uc131 A\uc528\uac00 \ub5a8\uc5b4\uc84c\ub2e4.<br>A\uc528\ub294 \ub2f9\uc2dc \ud568\uaed8 \uc788\ub358 \ub0a8\uc790\uce5c\uad6c B\uc528(30\ub300)\uc758 \uc2e0\uace0\ub97c \ubc1b\uace0 \ucd9c\ub3d9\ud55c 119\uc5d0 \uc758\ud574 \ubcd1\uc6d0\uc5d0 \uc62e\uaca8\uc84c\uc9c0\ub9cc \uacb0\uad6d \uc228\uc84c\ub2e4.<br>\uacbd\ucc30\uc740 \uc0ac\ub9dd \uacbd\uc704\ub97c \ud30c\uc545\ud558\uae30 \uc704\ud574 \uc218\uc0ac\ub97c \uc9c4\ud589\ud558\uace0 \uc788\uc73c\uba70, A\uc528\uac00 \ucd94\ub77d\ud558\uae30 \uc804 \uace0\ud568\uc744 \uc9c0\ub974\ub294 \uc18c\ub9ac\uac00 \ub4e4\ub838\ub2e4\ub294 \uc774\uc6c3 \uc8fc\ubbfc\uc758 \uc9c4\uc220\uc744 \ud655\ubcf4\ud574 B\uc528\uc640\uc758 \uad00\ub828 \uc5ec\ubd80\ub3c4 \ud568\uaed8 \uc870\uc0ac\ud558\uace0 \uc788\ub2e4.<br>\ud604\uc7a5 \uac10\uc2dd \uacb0\uacfc B \uc528\uac00 A \uc528\uc5d0\uac8c \ubb3c\ub9ac\ub825\uc744 \uac00\ud55c \ud754\uc801\uc740 \ubc1c\uacac\ub418\uc9c0 \uc54a\uc740 \uac83\uc73c\ub85c \uc804\ud574\uc84c\ub2e4.<br>B\uc528\ub294 \uacbd\ucc30 \uc870\uc0ac\uc5d0\uc11c \"\ub9d0\ub2e4\ud23c \uc911 \ubc1c\ucf54\ub2c8 \uadfc\ucc98\uc5d0 \uc788\ub358 A\uc528\uac00 \uac11\uc790\uae30 \ub5a8\uc5b4\uc84c\ub2e4\"\uace0 \uc9c4\uc220\ud55c \uac83\uc73c\ub85c \uc54c\ub824\uc84c\ub2e4.<br>\uacbd\ucc30\uc740 \uc815\ud655\ud55c \uc0ac\uc778\uc744 \ud655\uc778\ud558\uae30 \uc704\ud574 \uad6d\ub9bd\uacfc\ud559\uc218\uc0ac\uc5f0\uad6c\uc6d0\uc5d0 \uc815\ubc00 \ubd80\uac80\uc744 \uc758\ub8b0\ud588\ub2e4.<br>\uacbd\ucc30 \uad00\uacc4\uc790\ub294 \"\uad6d\uacfc\uc218 \uacb0\uacfc\ub294 \uc57d \ud55c\ub2ec \uc815\ub3c4 \uc18c\uc694\ub420 \uac83\uc73c\ub85c \ubcf4\uc778\ub2e4\"\uba70 \"\ub450 \uc0ac\ub78c \uc0ac\uc774\uc5d0 \ud3ed\ud589 \ub4f1\uc73c\ub85c \uc778\ud55c \uacbd\ucc30 \uc2e0\uace0\ub294 \uc811\uc218\ub41c \ubc14\uac00 \uc5c6\uc73c\uba70, \ub2e4\uc591\ud55c \uac00\ub2a5\uc131\uc744 \uc5f4\uc5b4 \ub450\uace0 \uc218\uc0ac \uc911\"\uc774\ub77c\uace0 \ub9d0\ud588\ub2e4.",
  "ai_image_file_8": "https://snuss1.qualtrics.com/ControlPanel/Graphic.php?IM=IM_RMhJfcDUhQvfpjd",
  "real_image_file_8": "https://snuss1.qualtrics.com/ControlPanel/Graphic.php?IM=IM_5KbncHQFxgFJTpd",
  "ai_caption_8": "\uc544\ud30c\ud2b8 \ucd94\ub77d \uc608\ubc29 \ub3c5\ub824\ud558\ub294 \uc0bd\ud654. \ucc57\uc9c0\ud2f0\ud53c \uc0dd\uc131 \uc774\ubbf8\uc9c0",
  "real_caption_8": "\ubd80\uc0b0 \ud574\uc6b4\ub300\uacbd\ucc30\uc11c \uc804\uacbd. \ub274\uc2a41"
}