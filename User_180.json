  "ai_caption_8": "\uc774\ubbf8\uc9c0\ub294 \uc0dd\uc131\ud615 AI ChatGPT 4.0\uc744 \ud1b5\ud574 \uc0dd\uc131\ud55c \u2018\ub298\uc5b4\ub09c \uac1c\uc778 \ud22c\uc790\uc6a9 \uad6d\ucc44\u2019 (\uc774\ubbf8\uc9c0=ChatGPT 4.0)",
