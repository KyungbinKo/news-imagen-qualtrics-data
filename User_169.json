  "real_image_file_2": "https://snuss1.qualtrics.com/ControlPanel/Graphic.php?IM=IM_565HCtoySljsh2G",
  "ai_caption_2": "\uc774\ubbf8\uc9c0=\ucc57GPT",
  "real_caption_2": "\ub3c4\ub110\ub4dc \ud2b8\ub7fc\ud504 \ubbf8\uad6d \ub300\ud1b5\ub839 \ub2f9\uc120\uc778. \uc5f0\ud569\ub274\uc2a4",
  "idx_3": "268",
  "title_3": "\u201c\uad50\ud68c \ub2f4\uc784\ubaa9\uc0ac\uac00 \uc2e0\ub3c4 \uc218\uc2ed\uba85\uc5d0 \uc131\ubc94\uc8c4\u201d \uacbd\ucc30 \uc218\uc0ac \ucc29\uc218",
  "body_3": "\uacbd\uae30 \uad70\ud3ec\uc2dc \ud55c \uad50\ud68c\uc758 60\ub300 \ub2f4\uc784\ubaa9\uc0ac\uac00 \uc5ec\uc131 \uc2e0\ub3c4 8\uba85\uc744 \ub300\uc0c1\uc73c\ub85c \uc131\ubc94\uc8c4\ub97c \uc800\uc9c8\ub800\ub2e4\ub294 \uace0\uc18c\uac00 \uc811\uc218\ub3fc \uacbd\ucc30\uc774 \uc218\uc0ac\uc5d0 \ucc29\uc218\ud588\ub2e4.<br>\uacbd\uae30 \uc758\uc655\uacbd\ucc30\uc11c\ub294 \uc900\uac15\uac04\uacfc \uac15\uc81c\ucd94\ud589 \ud610\uc758\ub85c \uae40\ubaa8 \uc528(68)\ub97c \uc785\uac74\ud574 \uc870\uc0ac\ud558\uace0 \uc788\ub2e4\uace0 12\uc77c \ubc1d\ud614\ub2e4. \uae40 \uc528\ub294 2021\ub144\uae4c\uc9c0 \uad70\ud3ec\uc2dc \ud55c \uad50\ud68c\uc758 \ub2f4\uc784\ubaa9\uc0ac\ub85c \uc7ac\uc9c1\ud558\uba70 \uc5ec\uc131 \uc2e0\ub3c4\ub4e4\uc5d0\uac8c \uc131\ubc94\uc8c4\ub97c \uc800\uc9c0\ub978 \ud610\uc758\ub97c \ubc1b\uace0 \uc788\ub2e4.<br>\uacbd\ucc30\uc740 \uc9c0\ub09c\ub2ec \uae40 \uc528\ub85c\ubd80\ud130 \uc131\ud3ed\ub825\uc744 \ub2f9\ud588\ub2e4\ub294 \uc5ec\uc131 8\uba85\uc73c\ub85c\ubd80\ud130 \uace0\uc18c\uc7a5\uc744 \uc811\uc218\ud574 \uc218\uc0ac\uc5d0 \ucc29\uc218\ud55c \uc0c1\ud0dc\ub2e4. \ud53c\ud574 \uc5ec\uc131 \uc911 \uc77c\ubd80\ub294 \ubbf8\uc131\ub144\uc790 \uc2dc\uc808 \uae40 \uc528\ub85c\ubd80\ud130 \uc131\ud3ed\ub825 \ud53c\ud574\ub97c \ub2f9\ud588\ub2e4\uace0 \uc9c4\uc220\ud55c \uac83\uc73c\ub85c \uc54c\ub824\uc84c\ub2e4. \uae40 \uc528\ub294 2021\ub144 \uc131\ubc94\uc8c4 \ud53c\ud574\uc790 24\uba85\uacfc \ud569\uc758\uae08\uc744 \uc9c0\ubd88\ud558\uace0 \uc131\ubc94\uc8c4 \ud53c\ud574\uc5d0 \ub300\ud574 \ud569\uc758\ud55c\ub2e4\ub294 \ub0b4\uc6a9\uc758 \ud569\uc758\uc11c\ub97c \uc791\uc131\ud558\uae30\ub3c4 \ud55c \uac83\uc73c\ub85c \uc804\ud574\uc84c\ub2e4. \uae40 \uc528\ub294 \uac19\uc740 \ud574 \ud574\ub2f9 \uad50\ud68c\uc5d0\uc11c \ud574\uc784\ub410\ub2e4\uace0 \ud55c\ub2e4.<br>\ud53c\ud574\uc790 8\uba85\uc5d0 \ub300\ud55c \uc870\uc0ac\ub97c \ub9c8\uce5c \uacbd\ucc30\uc740 \uc870\ub9cc\uac04 \uae40 \uc528\ub97c \ubd88\ub7ec \uc815\ud655\ud55c \uc0ac\uac74 \uacbd\uc704\ub97c \uc870\uc0ac\ud560 \ubc29\uce68\uc774\ub2e4. \uacbd\ucc30 \uad00\uacc4\uc790\ub294 \u201c\ud604\uc7ac\uae4c\uc9c0 \uace0\uc18c\uc7a5\uc774 \uc811\uc218\ub41c \uac74 8\uba85\uc774\uc9c0\ub9cc, \ud53c\ud574 \uace0\uc18c\uc7a5\uc774 \ucd94\uac00\ub85c \uc811\uc218\ub41c\ub2e4\uba74 \uadf8\uc5d0 \ub300\ud574\uc11c\ub3c4 \uc218\uc0ac\ud560 \uac83\u201d\uc774\ub77c\uba70 \u201c\uc790\uc138\ud55c \uacbd\uc704\ub97c \uc870\uc0ac\ud55c \ub4a4 \ud610\uc758\uac00 \ubcc0\uacbd\ub420 \uac00\ub2a5\uc131\ub3c4 \uc788\ub2e4\u201d\uace0 \ub9d0\ud588\ub2e4.",
  "ai_image_file_3": "https://snuss1.qualtrics.com/ControlPanel/Graphic.php?IM=IM_LMFmZnVR1a2edvi",
  "real_image_file_3": "https://snuss1.qualtrics.com/ControlPanel/Graphic.php?IM=IM_mNyl4s5nmWXTiiR",
  "ai_caption_3": "[\uc0ac\uc9c4 \uc81c\uacf5 = \ucc57GPT]",
  "real_caption_3": "\u24d2\ub274\uc2dc\uc2a4",
  "idx_4": "91",
  "title_4": "\uc6d0\ub2ec\ub7ec \ud658\uc728, \uac15\ub2ec\ub7ec \uc815\uce58\ubd88\ud655\uc2e4\uc131\uc5d0 1470\uc6d0\uc120 \uc704\ud611",
  "body_4": "\uc6d0\u00b7\ub2ec\ub7ec \ud658\uc728\uc774 \uac15\ub2ec\ub7ec \uc601\ud5a5\uacfc \uad6d\ub0b4 \uc815\uce58 \ubd88\ud655\uc2e4\uc131\uc73c\ub85c 1470\uc6d0 \uc120\uc744 \uc704\ud611\ud558\ub294 \ubaa8\uc2b5\uc774\ub2e4.<br>25\uc77c \uc624\ud6c4 2\uc2dc 3\ubd84 \ud604\uc7ac \uc11c\uc6b8 \uc678\ud658\uc2dc\uc7a5\uc5d0\uc11c \uc6d0\u00b7\ub2ec\ub7ec \ud658\uc728\uc740 \uc804\ub0a0 \ubcf4\ub2e4 1.95\uc6d0 \uc0c1\uc2b9\ud55c 1469.65\uc6d0\uc744 \uae30\ub85d\ud558\uace0 \uc788\ub2e4.<br>\uc774\ub0a0 \ud658\uc728\uc740 \uc804\ub0a0\ubcf4\ub2e4 0.1\uc6d0 \ub0b4\ub9b0 1467.6\uc6d0\uc5d0 \ucd9c\ubc1c\ud55c \uc9c1\ud6c4 \uc7a5 \ucd08\ubc18 1469.9\uc6d0\uae4c\uc9c0 \uce58\uc19f\uc558\ub2e4\uac00 1468\uc6d0\ub300\ub85c \uc18c\ud3ed \ud558\ub77d\ud588\ub2e4.<br>\ud658\uc728\uc740 \uc774\ub0a0 \uc624\uc804 \ub0b4\ub0b4 1470\uc6d0 \ub3cc\ud30c\ub97c \uc2dc\ub3c4\ud558\ub2e4\uac00 10\uc2dc 40\ubd84 \ubb34\ub835 1470.0\uc6d0\uc744 \uc7a0\uc2dc \ud130\uce58\ud588\ub2e4.<br>\uc2dc\uc7a5 \uc804\ubb38\uac00\ub4e4\uc740 \ubbf8\uad6d \uc11c\ube44\uc2a4\uc5c5 PMI\uac00 \uc608\uc0c1\uce58\ub97c \uc6c3\ub3cc\uba74\uc11c \uacbd\uae30 \uc790\uc2e0\uac10\uc774 \ubc18\uc601\ub3fc \ub2ec\ub7ec\ud654\uac00 \uac15\uc138\ub97c \ub098\ud0c0\ub0c8\uace0, \uc724\uc11d\uc5f4 \ub300\ud1b5\ub839 \ud0c4\ud575\uc2ec\ud310 \uad00\ub828 \uad6d\ub0b4 \uc815\uce58 \ubd88\ud655\uc2e4\uc131\ub3c4 \uc0c1\ubc29\uc694\uc778\uc778 \uac83\uc73c\ub85c \ubd84\uc11d\ud588\ub2e4.<br>\ubbfc\uacbd\uc6d0 \uc6b0\ub9ac\uc740\ud589 \uc5f0\uad6c\uc6d0\uc740 \u201c\uc6d0\ud654\uac00 \ud0c4\ud575 \uc120\uace0\uae30\uc77c \uc5f0\uc7a5\uc5d0 \ub530\ub978 \ubd88\ud655\uc2e4\uc131 \ud655\ub300, \uac70\uc8fc\uc790 \ud574\uc678\uc8fc\uc2dd\ud22c\uc790\ub85c \uc778\ud55c \uc218\uae09 \uc3e0\ub9bc \ud604\uc0c1\uc73c\ub85c \uc800\ud3c9\uac00 \uad6d\uba74\uc5d0 \uba38\ubb34\ub974\uace0 \uc788\ub2e4\u201d\uba70 \u201c\ud5a5\ud6c4 \ud558\ub77d \uc5ec\ub825\uc774 \ud06c\ub2e4\u201d\uace0 \ubc1d\ud614\ub2e4.",
  "ai_image_file_4": "https://snuss1.qualtrics.com/ControlPanel/Graphic.php?IM=IM_e6hpX18Rym0Uyic",
  "real_image_file_4": "https://snuss1.qualtrics.com/ControlPanel/Graphic.php?IM=IM_BsQN1XMU8DIXcmJ",
  "ai_caption_4": "[\uc0ac\uc9c4=\ucc57GPT\uac00 \uc0dd\uc131\ud55c \uc774\ubbf8\uc9c0]",
  "real_caption_4": "25\uc77c \uc11c\uc6b8 \uc911\uad6c \ud558\ub098\uc740\ud589 \ubcf8\uc810 \ub51c\ub9c1\ub8f8 \ud654\uba74\uc5d0 \uc774\ub0a0 \uac70\ub798\ub97c \uc2dc\uc791\ud55c \ucf54\uc2a4\ud53c, \uc6d0/\ub2ec\ub7ec \ud658\uc728\uc774 \ud45c\uc2dc\ub3fc \uc788\ub2e4. \u00a0\uc774\ub0a0 \ucf54\uc2a4\ud53c\uac00 25\uc77c \uc0c1\uc2b9 \ucd9c\ubc1c\ud574 \uc7a5 \ucd08\ubc18 2630\ub300 \ud6c4\ubc18, \ucf54\uc2a4\ub2e5\uc9c0\uc218\ub3c4 720\ub300 \ucd08\ubc18\uc5d0\uc11c \ub4f1\ub77d\uc744 \uac70\ub4ed\ud558\uace0 \uc788\ub2e4. \u00a0\uc6d0/\ub2ec\ub7ec \ud658\uc728\uc740 \uc804 \uac70\ub798\uc77c \ub300\ube44 1\uc6d0 \uc774\uc0c1 \uc624\ub978 1469\uc6d0\uc744 \uae30\ub85d \uc911\uc774\ub2e4. (\uc5f0\ud569\ub274\uc2a4)",
  "idx_5": "149",
  "title_5": "\uc2e4\uc885\ub41c \uc5b4\uba38\ub2c8\uac00 \ube44\ub2e8\ubc40 \ubc43\uc18d\uc5d0 \uc778\ub2c8\uc11c \ubc1c\uc0dd\ud55c \uc0ac\uace0 '\ucda9\uaca9'",
  "body_5": "\uc778\ub3c4\ub124\uc2dc\uc544\uc5d0\uc11c \uc2e4\uc885\ub410\ub358 60\ub300 \uc5ec\uc131\uc774 \ube44\ub2e8\ubc40 \ubc43\uc18d\uc5d0\uc11c \ubc1c\uacac\ub410\ub2e4\ub294 \ucda9\uaca9\uc801\uc778 \uc18c\uc2dd\uc774 \uc804\ud574\uc84c\ub2e4.<br>\uc9c0\ub09c 2\uc77c(\uc774\ud558 \ud604\uc9c0\uc2dc\uac01) \ub370\uc77c\ub9ac\uba54\uc77c\uc5d0 \ub530\ub974\uba74 \uc778\ub3c4\ub124\uc2dc\uc544 \ub0a8\uc220\ub77c\uc6e8\uc2dc\uc5d0\uc11c \uc2e4\uc885\ub41c 60\ub300 \uc5ec\uc131 \uc2dc\uc2e0\uc774 \ube44\ub2e8\ubc40 \ubc30\uc5d0\uc11c \ubc1c\uacac\ub410\ub2e4.<br>\uc9c0\ub09c 1\uc77c \uac00\uc871\ub4e4\uc740 \ud558\uc2dc\uc544(66)\uac00 \uadc0\uac00 \uc2dc\uac04\uc774 \uc9c0\ub0ac\uc74c\uc5d0\ub3c4 \ub3cc\uc544\uc624\uc9c0 \uc54a\uc790 \ucc3e\uc544 \ub098\uc130\ub2e4\uac00 \uc624\ud6c4 9\uc2dc\ucbe4 \ube44\ub2e8\ubc40\uc744 \ubc1c\uacac\ud588\ub2e4. \uac00\uc871\ub4e4\uc740 \ubc40\uc758 \ubc30\uac00 \uacfc\ud558\uac8c \ubcfc\ub85d\ud574\uc838 \uc788\ub294 \uac83\uc744 \ubcf4\uace0 \ubd88\uc548\ud568\uc744 \ub290\uaf08\uace0, \ubc40\uc758 \ubc30\ub97c \uac08\ub77c\ubcf4\ub2c8 \uadf8 \uc18d\uc5d0 \ud558\uc2dc\uc544\uac00 \uc788\uc5c8\ub2e4.<br>\ud558\uc2dc\uc544\ub294 \uc77c\uc744 \ub9c8\uce58\uace0 \uadc0\uac00\ud558\ub358 \uc911 \ubc40\uc5d0\uac8c \uacf5\uaca9\ub2f9\ud55c \uac83\uc73c\ub85c \ucd94\uc815\ub410\ub2e4.<br>\ud558\uc2dc\uc544\uc758 \uc544\ub4e4 \ub204\ub974\ub518\uc740 \"\uc800\ub141 \ub2a6\uac8c\uae4c\uc9c0 \uc5b4\uba38\ub2c8\ub97c \ucc3e\ub2e4\uac00 \ud070 \ube44\ub2e8\ubc40\uc774 \uc794\ub514 \uc704\uc5d0 \uac00\ub9cc\ud788 \ub204\uc6cc \uc788\ub294 \uac83\uc744 \ubc1c\uacac\ud588\ub2e4\"\uba70 \"\uc5b4\uba38\ub2c8\uac00 \uace0\ud1b5\uc2a4\ub7fd\uac8c \ub3cc\uc544\uac00\uc154\uc11c \ucc38\ub2f4\ud558\ub2e4\"\uace0 \ub9d0\ud588\ub2e4. \uc720\uac00\uc871\uc740 \uc774\uc2ac\ub78c \uc2e0\uc559\uc5d0 \ub530\ub77c \uc7a5\ub840\uc2dd\uc744 \uc900\ube44\ud558\uae30 \uc704\ud574 \ud558\uc2dc\uc544\uc758 \uc2dc\uc2e0\uc744 \uc218\uc2b5\ud588\ub2e4.<br>\uc2dc\uc2e0\uc740 \ud604\uc7ac \uc7a5\ub840\uc2dd\uc7a5\uc73c\ub85c \uc62e\uaca8\uc84c\ub2e4.<br>\ube44\ub2e8\ubc40\uc758 \uc8fc\uc694 \uc11c\uc2dd\uc9c0 \uc778\ub3c4\ub124\uc2dc\uc544\uc5d0\uc11c\ub294 \uad00\ub828 \uc0ac\uace0\uac00 \ub9e4\ub144 \ubc1c\uc0dd\ud558\uace0 \uc788\ub2e4.<br>\uc9c0\ub09c\ud574 8\uc6d4 \ube44\ub2e8\ubc40\uc774 70\ub300 \uc5ec\uc131\uc744 \uc5b4\uae68\uae4c\uc9c0 \uc0bc\ucf30\ub2e4\uac00 \ubc49\uc5b4 \uc0ac\ub9dd\ud558\uac8c \ud588\uace0, \uc9c0\ub09c\ud574 7\uc6d4\uc5d0\ub294 30\ub300 \uc5ec\uc131\uc774 \ube44\ub2e8\ubc40 \ubc43\uc18d\uc5d0\uc11c \uc228\uc9c4 \ucc44 \ubc1c\uacac\ub410\ub2e4.",
  "ai_image_file_5": "https://snuss1.qualtrics.com/ControlPanel/Graphic.php?IM=IM_i5h9RKo5XsMGR0G",
  "real_image_file_5": "https://snuss1.qualtrics.com/ControlPanel/Graphic.php?IM=IM_OAmpSyq9GjxKbLE",
  "ai_caption_5": "\uae30\uc0ac\uc758 \uc774\ud574\ub97c \ub3d5\uae30 \uc704\ud574 AI\ub85c \uc81c\uc791\ud55c \uc774\ubbf8\uc9c0\uc785\ub2c8\ub2e4. AI\ud234=\ud50c\ub77c\uba5c",
  "real_caption_5": "\ube44\ub2e8\ubc40 \ubc30 \uc548\uc5d0\uc11c 60\ub300 \ud560\uba38\ub2c8\uac00 \ubc1c\uacac\ub418\ub294 \uc0ac\uac74\uc774 \ubc1c\uc0dd\ud588\ub2e4. \uc0ac\uc9c4\uc740 60\ub300 \uc5ec\uc131 \ud558\uc2dc\uc544\ub97c \uc0bc\ud0a8 \ube44\ub2e8\ubc40\uc758 \ubaa8\uc2b5. \ucd9c\ucc98=\ub370\uc77c\ub9ac\uba54\uc77c",
  "idx_6": "127",
  "title_6": "\ud478\ubc14\uc624 \ubcf4\ub7ec \uc544\uc2dc\uc544\ub098 \ud0c0\uace0 \ucda9\uce6d \uac00\uc790...\uc911\uad6d \ub178\uc120 26% \ub298\ub9b0\ub2e4",
  "body_6": "\uc544\uc2dc\uc544\ub098\ud56d\uacf5\uc758 A350. \uc544\uc2dc\uc544\ub098\ud56d\uacf5 \uc81c\uacf5<br>\uc544\uc2dc\uc544\ub098\ud56d\uacf5\uc774 \uc62c\uc5ec\ub984\ucca0 \uc911\uad6d\uc73c\ub85c \ud5a5\ud558\ub294 \ud56d\uacf5\ud3b8\uc744 20% \ub298\ub9b0\ub2e4.\uc911\uad6d\uc774 2024\ub144 11\uc6d4 \ud55c\uad6d \uad00\uad11\uac1d\uc744 \ub300\uc0c1\uc73c\ub85c \ube44\uc790 \uba74\uc81c \uc870\uce58\uc5d0 \ub530\ub978 \uac83\uc774\ub2e4.<br>\uc544\uc2dc\uc544\ub098\ud56d\uacf5\uc740 \ud558\uacc4 \ud56d\uacf5 \uc2a4\ucf00\uc904\uc774 \uc801\uc6a9\ub418\ub29410\uc6d4 \ub9d0\uae4c\uc9c0 \uc911\uad6d \ub178\uc120\uc744 \uc8fc 26\ud68c \ud655\ub300\ud574 164\ud68c(18\uac1c \ub178\uc120) \uc6b4\ud56d\ud55c\ub2e4\uace0 31\uc77c \ubc1d\ud614\ub2e4.\uc6b4\ud56d \ud69f\uc218 \uae30\uc900\uc73c\ub85c\ub294 20%\ub97c \uc99d\uac00\ud55c \uac83\uc774\ub2e4.<br>\ub300\ud45c\uc801\uc73c\ub85c\uc6b4\ud56d\uc744 \ud55c\ub3d9\uc548 \uc911\ub2e8\ud588\ub358 \uc778\ucc9c\u223c\uccad\ub450\u00b7\ucda9\uce6d \ub178\uc120\uc740 \uc8fc 7\ud68c\ub85c \ub9e4\uc77c \uc6b4\ud56d\ud55c\ub2e4.\uccad\ub450\ub294 \ud478\ubc14\uc624\ub97c \ub9cc\ub0a0 \uc218 \uc788\ub294 \uc790\uc774\uc5b8\ud2b8 \ud310\ub2e4 \uae30\uc9c0, \uc8fc\uc790\uc774\uac70\uc6b0 \ud48d\uacbd\uad6c, \ubbf8\uc2dd\uc758 \ub3c4\uc2dc\ub85c \uc720\uba85\ud558\ub2e4.\ucda9\uce6d\uc740 \uc911\uad6d 4\ub300 \uc9c1\ud560\uc2dc\ub85c \ud6e0\uad88\uc758 \ubcf8\uace0\uc7a5\uc774\uba70 \uc8fc\uc694 \uc5ec\ud589\uc9c0\ub85c\ub294 \ucd5c\uadfc \ub5a0\uc624\ub974\ub294 \ud64d\uc57c\ub3d9\uacfc \uc0bc\uad6d\uc9c0\uc758 \ubc30\uacbd\uc778 \uc7a5\uac15\uc0bc\ud611\ub4f1\uc774 \uc788\ub2e4.<br>\uc774\uc678\uc5d0\ub3c4\uc778\ucc9c\u223c\ub2e4\ub844 \ub178\uc120\uc740 \uc624\uc804\ud3b8\uc744 \ub9e4\uc77c \uc6b4\ud56d\ud558\uace0 \uc624\ud6c4\ud3b8\uc744 3\ud68c \ub298\ub824 \uc8fc 10\ud68c \ub744\uc6b4\ub2e4.\uc778\ucc9c\u223c\uc60c\uc9c0 \ub178\uc120\uc740 \uc8fc 5\ud68c\uc5d0\uc11c 7\ud68c\ub85c 2\ud68c \uc99d\ud3b8\ud55c \ub4a4 4\uc6d4 28\uc77c\ubd80\ud130 \ub2e4\uc2dc 1\ud68c \ucd94\uac00\ud574 \uc8fc 8\ud68c\ub85c \uc6b4\ud56d\ud55c\ub2e4.\uc778\ucc9c~\ucc3d\ucd98 \ub178\uc120\uc740 \uc8fc 4\ud68c\uc5d0\uc11c \uc8fc 9\ud68c\ub85c 5\ud68c \uc99d\ud3b8\ud588\uace0\uc778\ucc9c~\ucc3d\uc0ac \ub178\uc120\ub3c4 \uc8fc 4\ud68c\uc5d0\uc11c 5\ud68c\ub85c 1\ud68c \ub298\ub838\ub2e4.<br>\uc774\ubc88 \uc911\uad6d \ub178\uc120 \uc99d\ud3b8\uc740 \uc911\uad6d\uc774 \ud55c\uad6d\uc778 \ub300\uc0c1 \ube44\uc790 \uba74\uc81c \uc815\ucc45\uc744 \uc2dc\ud589\ud558\uba74\uc11c \ud55c\uad6d\uc778 \uad00\uad11\uac1d\uc774 \ub298\uc5b4\ub09c \uac83\uc5d0 \ub530\ub978 \uac83\uc774\ub2e4. \uc2e4\uc81c\ube44\uc790\uac00 \uba74\uc81c\ub41c \uc9c0\ub09c\ud574 11\uc6d4\ubd80\ud130 2\uc6d4\uae4c\uc9c0 \uc911\uad6d\uc73c\ub85c \ub5a0\ub09c \ud55c\uad6d\uc778 \uc5ec\ud589\uac1d\uc740 \ucd1d 453\ub9cc5,044\uba85\uc73c\ub85c \uc9c0\ub09c\ud574 \uac19\uc740 \uae30\uac04\ubcf4\ub2e4 37% \uc99d\uac00\ud588\ub2e4.<br>\ud55c\uad6d \uc815\ubd80\ub3c4 \uc62c\ud574 3\ubd84\uae30(7~9\uc6d4) \uc911 '\ubc29\ud55c \uad00\uad11 \uc2dc\uc7a5 \uae00\ub85c\ubc8c \uc131\uc7a5 \uc804\ub7b5'\uc744 \uc2e4\ud604\ud558\uae30 \uc704\ud574 \uc911\uad6d \ub2e8\uccb4 \uad00\uad11\uac1d\uc5d0 \ub300\ud55c \ud55c\uc2dc\uc801 \ube44\uc790 \uba74\uc81c\ub97c \uc2dc\ud589\ud560 \uacc4\ud68d\uc774\ub2e4. \uc544\uc2dc\uc544\ub098\ud56d\uacf5 \uad00\uacc4\uc790\ub294 \"\ud55c\uc911 \uc591\uad6d\uc758 \uc5ec\ud589\uac1d \ube44\uc790 \uba74\uc81c \uc815\ucc45\uc5d0 \ubc1c\ub9de\ucdb0 \uc774\ubc88 \uc99d\ud3b8\uc744 \uc900\ube44\ud588\ub2e4\"\uba70 \"\uc801\uadf9\uc801\uc778 \uc6b4\ud56d \ud655\ub300\ub97c \ud1b5\ud574 \uc591\uad6d \uad50\ub958\ub97c \uc704\ud55c \uac00\uad50\ub97c \uc774\uc5b4 \ub098\uac08 \uacc4\ud68d\"\uc774\ub77c\uace0 \ub9d0\ud588\ub2e4.",
  "ai_image_file_6": "https://snuss1.qualtrics.com/ControlPanel/Graphic.php?IM=IM_zWOdQf7UHjxWcVf",
