  "ai_caption_8": "\uae30\uc0ac \uc774\ud574\ub97c \ub3d5\uae30 \uc704\ud55c \uc0ac\uc9c4. [\uc0ac\uc9c4 \ucd9c\ucc98 = \ucc57GPT]",
  "real_caption_8": "\ub178\uc778 \ud658\uc790. [\uc5f0\ud569\ub274\uc2a4 \uc790\ub8cc\uc0ac\uc9c4]"
