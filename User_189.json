  "assignment_id": "189",
  "idx_1": "35",
  "title_1": "\uc6b0\ub9ac\uae08\uc735\ubbf8\ub798\uc7ac\ub2e8, \ucde8\uc57d\uacc4\uce35 \uad50\uc721\uc9c0\uc6d0 '\uc6b0\ub9ac\ub7ec\ub108' \ub300\uc0c1 \ud655\ub300",
  "body_1": "\uc6b0\ub9ac\uae08\uc735\uadf8\ub8f9 \uc6b0\ub9ac\uae08\uc735\ubbf8\ub798\uc7ac\ub2e8\uc740 \ucde8\uc57d\uacc4\uce35 \uad50\uc721\uaca9\ucc28 \ud574\uc18c\ub97c \uc704\ud55c \u2018\uc6b0\ub9ac\ub7ec\ub108\u2019 \ud504\ub85c\uadf8\ub7a8\uc758 \uc9c0\uc6d0\ub300\uc0c1\uc744 \uae30\uc874 \uace0\ub4f1\ud559\uad50 1\ud559\ub144\uc5d0\uc11c 2\ud559\ub144\uae4c\uc9c0 \ud655\ub300\ud55c\ub2e4\uace0 4\uc77c \ubc1d\ud614\ub2e4.<br>\u2018\uc6b0\ub9ac\ub7ec\ub108\u2019\ub294 \ud559\uc2b5\uc5ed\ub7c9 \uc81c\uace0 \uc758\uc9c0\ub294 \ub192\uc9c0\ub9cc, \ud658\uacbd\uc801 \uc81c\uc57d\uc73c\ub85c \uc5b4\ub824\uc6c0\uc744 \uacaa\ub294 \ubbf8\ub798\uc778\uc7ac\ub97c \uc120\ubc1c\ud574 \ud559\ub825 \ud5a5\uc0c1\uc744 \ub3d5\ub294 \ud504\ub85c\uadf8\ub7a8\uc774\ub2e4. \uc120\ubc1c\ub41c \ud559\uc0dd\ub4e4\uc5d0\uac8c\ub294 \ud559\uc2b5\uc5ed\ub7c9 \uac15\ud654\ub97c \uc704\ud55c \ub2e4\uc591\ud55c \uad50\uc721 \ud504\ub85c\uadf8\ub7a8\uacfc \ud559\uc2b5\ube44\ub97c \uc9c0\uc6d0\ud55c\ub2e4.<br>\uc9c0\ub09c\ud574\uc5d0 \uc774\uc5b4 \uc62c\ud574\ub3c4 \uc11c\uc6b8\ud2b9\ubcc4\uc2dc\uc640 \ud611\ub825\ud574 \u2018\uc11c\uc6b8\ub7f0\u2019\uc744 \uc774\uc6a9\ud558\ub294 2025\ub144\ub3c4 \uace0\ub4f1\ud559\uad50 1\ud559\ub144 \uc785\ud559\uc0dd \uc911 \ud559\uc5c5 \uc758\uc9c0\uc640 \ub2a5\ub825\uc774 \ub6f0\uc5b4\ub09c \ud559\uc0dd \uc57d 100\uc5ec \uba85\uc744 \u2018\uc6b0\ub9ac\ub7ec\ub108 \uace01 : \uc6b0\ub9ac\ubbf8\ub798 \uc11c\uc6b8\ub7ec\ub108\u2019\ub85c \uc120\ubc1c\ud55c\ub2e4. \ub610\ud55c, \u2018\uc6b0\ub9ac\ub7ec\ub108 \uace02\u2019\ub294 \uc804\uad6d \uace0\ub4f1\ud559\uad50 2\ud559\ub144\uc744 \ub300\uc0c1\uc73c\ub85c \uc131\uc801\uacfc \ud559\uc2b5 \ud5a5\uc0c1 \uc758\uc9c0\ub97c \ud3c9\uac00\ud574 \uc57d 50\uc5ec \uba85\uc744 \uc120\ubc1c\ud560 \uc608\uc815\uc774\ub2e4.<br>\uc120\ubc1c\ub41c \u2018\uc6b0\ub9ac\ub7ec\ub108\u2019\uc5d0\uac8c\ub294 \u25b3\uc5ec\ub984 \ud559\uc2b5\ubc29\ubc95 \ucea0\ud504 \u25b3\uaca8\uc6b8 \uc9d1\uc911\ud559\uc2b5 \ucea0\ud504 \u25b3\ud559\uae30 \uc911 \ud559\uc2b5\ube44 \ub4f1\uc744 \uc9c0\uc6d0\ud55c\ub2e4. \uc5ec\ub984 \ud559\uc2b5\ubc29\ubc95 \ucea0\ud504\ub97c \ud1b5\ud574\uc11c\ub294 \ud559\uc2b5 \ubc0f \uc785\uc2dc \ucee8\uc124\ud305\uacfc \ud2b9\uac15\uc744 \ud1b5\ud574 \ud6a8\uacfc\uc801\uc778 \ud559\uc2b5\uc804\ub7b5\uc744 \uc218\ub9bd\ud560 \uc218 \uc788\ub3c4\ub85d \ub3d5\ub294\ub2e4. \uaca8\uc6b8 \uc9d1\uc911\ud559\uc2b5 \ucea0\ud504\uc5d0\uc11c\ub294 \uc57d \ud55c \ub2ec\uac04 \uae30\uc219\ud615 \ubab0\uc785 \ud559\uc2b5 \ud658\uacbd\uacfc \ub9de\ucda4\ud615 \uac15\uc758\ub97c \uc81c\uacf5\ud574 \uc2e4\uc9c8\uc801\uc778 \ud559\ub825 \ud5a5\uc0c1\uc744 \uc9c0\uc6d0\ud55c\ub2e4.<br>\ud2b9\ud788, \uc6b0\ub9ac\uce74\ub4dc\uc640 \ud568\uaed8 \ud559\uae30 \uc911 \ud559\uc2b5\ube44\uc6a9\uc744 \uccb4\ud06c\uce74\ub4dc \ubc14\uc6b0\ucc98 \ud615\ud0dc\ub85c \uc9c0\uc6d0\ud558\uba70, \ud574\ub2f9 \ubc14\uc6b0\ucc98\ub294 \uc11c\uc810, \ubb38\uad6c\uc810 \ub4f1 \ud559\uc2b5 \uad00\ub828 \uc9c0\uc815 \uac00\ub9f9\uc810\uc5d0\uc11c\ub9cc \uc0ac\uc6a9\ud560 \uc218 \uc788\ub3c4\ub85d \uc6b4\uc601\ub41c\ub2e4.<br>\ucc38\uc5ec\ub97c \ud76c\ub9dd\ud558\ub294 \ud559\uc0dd\ub4e4\uc740 \uc624\ub294 21\uc77c\uae4c\uc9c0\u2018\uc6b0\ub9ac\uae08\uc735\ubbf8\ub798\uc7ac\ub2e8\u2019\uacfc \u2018\uc544\uc774\ub4e4\uacfc\ubbf8\ub798\uc7ac\ub2e8\u2019 \ud648\ud398\uc774\uc9c0\ub97c \ud1b5\ud574 \uc2e0\uccad\ud560 \uc218 \uc788\uc73c\uba70, \ucd5c\uc885 \uc120\ubc1c \uacb0\uacfc\ub294 4\uc6d4 7\uc77c\uc5d0 \ubc1c\ud45c\ub420 \uc608\uc815\uc774\ub2e4.<br>\uc6b0\ub9ac\uae08\uc735\ubbf8\ub798\uc7ac\ub2e8 \uad00\uacc4\uc790\ub294 \u201c\uc774\ubc88 \u2018\uc6b0\ub9ac\ub7ec\ub108\u2019 \ud655\ub300\ub97c \uacc4\uae30\ub85c, \ud5a5\ud6c4 \ucde8\uc57d\uacc4\uce35 \ud559\uc0dd\ub4e4\uc774 \ub300\ud559\uc785\uc2dc\uae4c\uc9c0 \uc548\uc815\uc801\uc73c\ub85c \uc9c0\uc6d0\ubc1b\uc744 \uc218 \uc788\ub3c4\ub85d \ub178\ub825 \ud560 \uc608\uc815\u201d\uc774\ub77c\uace0 \ub9d0\ud588\ub2e4.<br>\ud55c\ud3b8, \uc6b0\ub9ac\uae08\uc735\ubbf8\ub798\uc7ac\ub2e8\uc740 \uc6b0\ub9ac\uc740\ud589\uacfc \uc6b0\ub9ac\uce74\ub4dc, \uc6b0\ub9ac\uae08\uc735\uce90\ud53c\ud0c8, \uc6b0\ub9ac\ud22c\uc790\uc99d\uad8c \ub4f1 \uc6b0\ub9ac\uae08\uc735 \uc804 \uadf8\ub8f9\uc0ac\uac00 \ucd9c\uc5f0\ud574 \uc124\ub9bd\ud55c \uacf5\uc775\uc7ac\ub2e8\uc774\ub2e4.",
  "ai_image_file_1": "https://snuss1.qualtrics.com/ControlPanel/Graphic.php?IM=IM_8tj3VIRzflb9c7M",
  "real_image_file_1": "https://snuss1.qualtrics.com/ControlPanel/Graphic.php?IM=IM_XKyO2GgiCLqxB3m",
  "ai_caption_1": "\uad50\uc721\uaca9\ucc28 \ud574\uc18c\ub97c \uc704\ud55c \uc6b0\ub9ac\uae08\uc735\uc758 \ud504\ub85c\uadf8\ub7a8 \ub0b4\uc6a9\uc744 \ucc57GPT\uac00 \uc2dc\uac01\ud654\ud55c \uc774\ubbf8\uc9c0",
  "real_caption_1": "(\uc0ac\uc9c4=\uc6b0\ub9ac\uae08\uc735)",
  "idx_2": "74",
  "title_2": "\uc774\uc6c3\uc9d1 \uc544\ud30c\ud2b8 \ubcf5\ub3c4\uc5d0 \ubc40 \ud47c \ud0dc\uad6d\uc778 \uc774\uc720\ub294 \u201c\uac1c\uac00 \uc9d6\uc5b4\uc11c\u201d",
  "body_2": "\ud0dc\uad6d\uc758 \ud55c \ub0a8\uc131\uc774 \uc774\uc6c3\uc9d1 \uac1c\uc9d6\ub294 \uc18c\ub9ac\uc5d0 \ud654\uac00\ub098 \uc544\ud30c\ud2b8 \ubcf5\ub3c4\uc5d0 \ubc40\uc744 \ud480\uc5b4\ub193\uc558\ub2e4.<br>20\uc77c(\ud604\uc9c0\uc2dc\uac01) \ud0dc\uad6d \ub9e4\uccb4 \ubc29\ucf55\ud3ec\uc2a4\ud2b8\uc5d0 \ub530\ub974\uba74, \ucd5c\uadfc \ud604\uc9c0 SNS\uc5d0\ub294 \ubc40 \ub450 \ub9c8\ub9ac\uac00 \uc544\ud30c\ud2b8 \ubcf5\ub3c4\ub97c \uae30\uc5b4\ub2e4\ub2c8\ub294 \uc601\uc0c1\uc774 \ud655\uc0b0\ub410\ub2e4.<br>\uc601\uc0c1\uc744 \uc62c\ub9b0 \ub0a8\uc131\uc740 \uc218\ub144\uac04 \uc774\uc6c3\uc9d1 \ubc18\ub824\uacac\uc758 \uc18c\uc74c\uc5d0 \uc2dc\ub2ec\ub838\uc9c0\ub9cc, \uad00\ub9ac\uc0ac\ubb34\uc18c\uac00 \uc544\ubb34\ub7f0 \uc870\uce58\ub97c \ud558\uc9c0 \uc54a\uc558\ub2e4\uba70 \ud56d\uc758 \uc758\uc0ac\ub97c \ud45c\ud604\ud55c \uac83\uc774\ub77c\uace0 \ubc1d\ud614\ub2e4.<br>\ubc29\ucf55\uc5d0 \uac70\uc8fc\ud55c\ub2e4\uace0 \ubc1d\ud78c \uadf8\ub294 \u201c\uc624\ub298\uc740 \ub450 \ub9c8\ub9ac\uc9c0\ub9cc, \ub0b4\uc77c\uc740 \ub354 \uac00\uc838\uc62c \uac83\u201d\uc774\ub77c\uba70 \u201c\ub098 \uc5ed\uc2dc \ub3d9\ubb3c\uc744 \uc0ac\ub791\ud558\ub294 \uc0ac\ub78c\u201d\uc774\ub77c\uace0 \ub367\ubd99\uc600\ub2e4.<br>\uc774 \uc544\ud30c\ud2b8\ub294 \ubc18\ub824\ub3d9\ubb3c\uc774 \uae08\uc9c0\ub41c \uacf3\uc774\uc9c0\ub9cc, \uc774\uc6c3\uc9d1\uc740 \uaddc\uc815\uc744 \uc5b4\uae30\uace0 \ubc18\ub824\uacac\uc744 \ud0a4\uc6e0\ub2e4\uace0 \ud55c\ub2e4. \ub0a8\uc131\uc740 \uac1c\uac00 \ubc18\ubcf5\uc801\uc73c\ub85c \uc9d6\uc73c\uba70 \uc77c\uc0c1\uc5d0 \uc2ec\uac01\ud55c \ud53c\ud574\ub97c \uc92c\ub2e4\uace0 \ud638\uc18c\ud588\ub2e4.<br>\uc601\uc0c1\uc774 \uc62c\ub77c\uc628 \ud6c4 \ub17c\ub780\uc774 \ucee4\uc9c0\uc790 \uad00\ub9ac\uc0ac\ubb34\uc18c\ub294 \ub300\uc751\uc5d0 \ub098\uc130\ub2e4. \ubc18\ub824\uacac\uc744 \ud0a4\uc6b4 \uc785\uc8fc\ubbfc\uc5d0\uac8c\ub294 \ubc8c\uae08 1\ub9cc \ubc27(\uc57d 42\ub9cc \uc6d0)\uc744 \ubd80\uacfc\ud558\uace0, \ubc18\ub824\uacac\uc744 \ub354 \uc774\uc0c1 \ud0a4\uc6b8 \uc218 \uc5c6\ub3c4\ub85d \uc870\uce58\ud588\ub2e4. \ubc40\uc744 \ud480\uc5b4\ub193\uc740 \ub0a8\uc131\uc5d0\uac8c\ub3c4 \uc11c\uba74 \uacbd\uace0\uc7a5\uc774 \uc804\ub2ec\ub410\uace0, \ubc40\uc744 \uc989\uc2dc \ubc18\ucd9c\ud558\ub77c\ub294 \uba85\ub839\uc774 \ub0b4\ub824\uc84c\ub2e4.",
  "ai_image_file_2": "https://snuss1.qualtrics.com/ControlPanel/Graphic.php?IM=IM_ZyNfzDT1HQZf0oJ",
  "real_image_file_2": "https://snuss1.qualtrics.com/ControlPanel/Graphic.php?IM=IM_KCKR0GuXr3Qiw7N",
  "ai_caption_2": "AI \uc774\ubbf8\uc9c0 \uc0dd\uc131\uae30\ub85c \ub9cc\ub4e0 \uc0ac\uc9c4. \ud234 \uc81c\uacf5 = \ud50c\ub77c\uba5c",
  "real_caption_2": "\ud398\uc774\uc2a4\ubd81 \uac08\ubb34\ub9ac",
  "idx_3": "128",
  "title_3": "K-\uc870\uc120, \uc9c0\ub09c\ud574 \uc218\uc8fc \uc810\uc720\uc728 8\ub144 \ub9cc\uc5d0 \ucd5c\uc800\u22ef \uc911\uad6d\uacfc \uaca9\ucc28 54%p\ub85c \ud655\ub300",
  "body_3": "\ud55c\uad6d \uc870\uc120\uc5c5\uacc4\uc758 \uc9c0\ub09c\ud574 \uae00\ub85c\ubc8c \uc218\uc8fc \uc810\uc720\uc728\uc774 17%\ub85c 8\ub144 \ub9cc\uc5d0 \ucd5c\uc800\uce58\ub97c \uae30\ub85d\ud55c \uac83\uc73c\ub85c \ub098\ud0c0\ub0ac\ub2e4. \ud2b9\ud788 12\uc6d4\uc5d0\ub294 \uc218\uc8fc \uc810\uc720\uc728\uc774 4%\uae4c\uc9c0 \ud558\ub77d\ud558\uba70 \uc911\uad6d\uacfc\uc758 \uaca9\ucc28\uac00 \ub354\uc6b1 \ubc8c\uc5b4\uc84c\ub2e4.<br>8\uc77c \uc601\uad6d \uc870\uc120\ud574\uc6b4\uc2dc\ud669 \uc804\ubb38\uae30\uad00 \ud074\ub77d\uc2a8\ub9ac\uc11c\uce58\uc5d0 \ub530\ub974\uba74 \ud55c\uad6d\uc740 \uc9c0\ub09c\ud574 \uc804 \uc138\uacc4 \uc218\uc8fc\ub7c9\uc758 17%\uc778 1098\ub9ccCGT(250\ucc99)\ub97c \uc218\uc8fc\ud588\ub2e4. \uc218\uc8fc\ub7c9\uc740 2023\ub144 \ub300\ube44 9% \uc99d\uac00\ud588\uc73c\ub098, \uae00\ub85c\ubc8c \uc810\uc720\uc728\uc740 \uc804\ub144 20%\uc5d0\uc11c 3%\ud3ec\uc778\ud2b8 \ud558\ub77d\ud588\ub2e4. \ud55c\uad6d\uc218\ucd9c\uc785\uc740\ud589 \uc790\ub8cc\uc5d0 \ub530\ub974\uba74 \ud55c\uad6d\uc758 \uc218\uc8fc \uc810\uc720\uc728\uc774 10%\ub300\ub85c \ub5a8\uc5b4\uc9c4 \uac83\uc740 2016\ub144(15.6%) \uc774\ud6c4 \ucc98\uc74c\uc774\ub2e4.<br>\ubc18\uba74 \uc911\uad6d\uc740 \uc9c0\ub09c\ud574 4645\ub9ccCGT(1711\ucc99)\ub97c \uc218\uc8fc\ud574 \uc804 \uc138\uacc4 \uc218\uc8fc\ub7c9\uc758 71%\ub97c \ucc28\uc9c0\ud588\ub2e4. \uc911\uad6d\uc758 \uc218\uc8fc\ub7c9\uc740 \uc804\ub144 \ub300\ube44 58% \uc99d\uac00\ud588\uace0, \uc810\uc720\uc728\uc740 11%\ud3ec\uc778\ud2b8 \uc0c1\uc2b9\ud588\ub2e4. \uc774\uc5d0 \ub530\ub77c \ud55c\uc911 \uac04 \uc810\uc720\uc728 \uaca9\ucc28\ub294 2023\ub144 40%\ud3ec\uc778\ud2b8\uc5d0\uc11c \uc9c0\ub09c\ud574 54%\ud3ec\uc778\ud2b8\ub85c \ud655\ub300\ub410\ub2e4.<br>\ud2b9\ud788 12\uc6d4 \uc2e4\uc801\uc744 \ubcf4\uba74 \uae00\ub85c\ubc8c \uc218\uc8fc\ub7c9 194\ub9ccCGT(86\ucc99) \uc911 \uc911\uad6d\uc774 166\ub9ccCGT(67\ucc99)\ub85c 86%\ub97c \ucc28\uc9c0\ud55c \ubc18\uba74, \ud55c\uad6d\uc740 7\ub9ccCGT(3\ucc99)\ub85c 4%\uc5d0 \uadf8\ucce4\ub2e4. \uc774\ub294 \uc804\ub144 \ub3d9\uae30 \ub300\ube44 56% \uac10\uc18c\ud55c \uc218\uce58\ub2e4.<br>12\uc6d4 \ub9d0 \uae30\uc900 \uc804 \uc138\uacc4 \uc218\uc8fc \uc794\ub7c9\uc740 1\uc5b55717\ub9ccCGT\ub85c \uc804\uc6d4 \ub300\ube44 167\ub9ccCGT \uc99d\uac00\ud588\ub2e4. \uc911\uad6d\uc774 9078\ub9ccCGT\ub85c 58%, \ud55c\uad6d\uc774 3787\ub9ccCGT\ub85c 24%\ub97c \ucc28\uc9c0\ud588\ub2e4. \uc804\ub144 \ub3d9\uae30 \ub300\ube44 \uc911\uad6d\uc740 2588\ub9ccCGT \uc99d\uac00\ud55c \ubc18\uba74, \ud55c\uad6d\uc740 190\ub9ccCGT \uac10\uc18c\ud588\ub2e4.<br>\ud55c\ud3b8 12\uc6d4 \ub9d0 \ud074\ub77d\uc2a8 \uc2e0\uc870\uc120\uac00\uc9c0\uc218\ub294 189.16\uc73c\ub85c \uc804\uc6d4(189.18)\ubcf4\ub2e4 \uc18c\ud3ed \ud558\ub77d\ud588\uc73c\ub098, \uc804\ub144 \ub3d9\uae30 \ub300\ube44\ub85c\ub294 6% \uc0c1\uc2b9\ud588\ub2e4. \uc120\uc885\ubcc4 \uc120\uac00\ub294 LNG\uc6b4\ubc18\uc120\uc774 2\uc5b56000\ub9cc\ub2ec\ub7ec, \ucd08\ub300\ud615 \uc720\uc870\uc120(VLCC)\uc774 1\uc5b52900\ub9cc\ub2ec\ub7ec, \ucd08\ub300\ud615 \ucee8\ud14c\uc774\ub108\uc120(2\ub9cc2000~2\ub9cc4000TEU)\uc774 2\uc5b57500\ub9cc\ub2ec\ub7ec\ub97c \uae30\ub85d\ud588\ub2e4.",
