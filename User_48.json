  "real_image_file_7": "https://snuss1.qualtrics.com/ControlPanel/Graphic.php?IM=IM_2B5GQp3n24O4dIc",
  "ai_caption_7": "[\uc0ac\uc9c4=EBN AI \uadf8\ub798\ud53d DB]",
