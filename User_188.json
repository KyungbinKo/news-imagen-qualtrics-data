  "idx_6": "220",
  "title_6": "\ub3d9\ubb38 \ud589\uc0ac\uc11c \uc4f0\ub7ec\uc9c4 50\ub300\u5973, \ub3d9\ubb38\ub4e4\uc774 \uc0b4\ub838\ub2e4 \uadf8\ub4e4 \uc9c1\uc5c5 \ubcf4\ub2c8 \u201c\uc774\ub7f0 \ucc9c\uc6b4\uc774\u201d",
  "body_6": "8\uc77c \uac15\uc6d0 \uc601\uc6d4\uad70\uc758 \ud55c \uc911\ud559\uad50\uc5d0\uc11c \uc5f4\ub9b0 \ub3d9\ubb38 \ud589\uc0ac\uc5d0 \ucc38\uc11d\ud55c 50\ub300 \uc5ec\uc131 A\uc528\uac00 \uc0c9\uc18c\ud3f0 \uc5f0\uc8fc \ub3c4\uc911 \uc4f0\ub7ec\uc838 \uc2ec\uc7a5\uc774 \uba4e\uc5c8\uc9c0\ub9cc, \ub3d9\ubb38\uc778 \uc18c\ubc29\ub300\uc6d0\ub4e4\uc758 \ub3c4\uc6c0\uc73c\ub85c \ubaa9\uc228\uc744 \uac74\uc84c\ub2e4.<br>\uc774\ub4e4\uc740 \uc2ec\ud3d0\uc18c\uc0dd\uc220\uc744 \ud3bc\uce58\ub294 \ub3d9\uc2dc\uc5d0 \uc790\ub3d9\uc81c\uc138\ub3d9\uae30\ub97c \uc774\uc6a9\ud574 A\uc528\uc758 \uc2ec\uc7a5\uc774 \ub2e4\uc2dc \ub6f0\ub3c4\ub85d \ub3c4\uc654\ub2e4.<br>A\uc528\ub294 \uc790\ubc1c \uc21c\ud658\uc744 \ud68c\ubcf5\ud55c \ub4a4 \uc6d0\uc8fc\uc758 \ub300\ud615 \ubcd1\uc6d0\uc73c\ub85c \uc62e\uaca8\uc838 \uce58\ub8cc\ubc1b\uace0 \uc788\ub2e4.",
  "ai_image_file_6": "https://snuss1.qualtrics.com/ControlPanel/Graphic.php?IM=IM_HWDXog0jyr81DyZ",
  "real_image_file_6": "https://snuss1.qualtrics.com/ControlPanel/Graphic.php?IM=IM_j79rYFWFxWbQRo9",
  "ai_caption_6": "[\ucc57GPT\ud569\uc131 \uc774\ubbf8\uc9c0]",
  "real_caption_6": "\uc2ec\ud3d0\uc18c\uc0dd\uc220 (PG). \uc5f0\ud569\ub274\uc2a4",
  "idx_7": "82",
  "title_7": "\u4e2d \uc778\ud50c\ub8e8\uc5b8\uc11c\uc758 \uc5b5\uc9c0 \uc8fc\uc7a5 \u201c\uae40\uce58\ub294 \uc911\uad6d \uc694\ub9ac\u201d",
  "body_7": "\uc911\uad6d\uc758 \uc720\uba85 \uc778\ud50c\ub8e8\uc5b8\uc11c\uac00 \uae40\uce58\ub97c \ub2f4\uac00 \uba39\ub294 \uc601\uc0c1\uc744 \uc62c\ub9ac\uba74\uc11c \u2018\uc911\uad6d \uc804\ud1b5\uc694\ub9ac\u2019\ub77c\ub294 \ud0dc\uadf8\ub97c \ub2ec\uc544 \ub17c\ub780\uc774 \ub418\uace0 \uc788\ub2e4.<br>7\uc77c \uc11c\uacbd\ub355 \uc131\uc2e0\uc5ec\ub300 \uad50\uc218\uac00 \ud398\uc774\uc2a4\ubd81\uc5d0 \uc62c\ub9b0 \uac8c\uc2dc\uae00\uc5d0 \ub530\ub974\uba74, \ubb38\uc81c\uc758 \uc778\ud50c\ub8e8\uc5b8\uc11c\ub294 \u2018\ubbf8\uc2a4\ud130 \ubc4c\uc624\u2019\ub77c\ub294 \uacc4\uc815\uc744 \uc6b4\uc601\ud558\ub294 \uc774\ub2e4. \uadf8\ub294 \ucd5c\uadfc \uc9c1\uc811 \uae40\uce58\ub97c \ub2f4\uac00 \uba39\ub294 3\ubd80\uc791 \uc601\uc0c1\uc744 \uc778\uc2a4\ud0c0\uadf8\ub7a8\uc5d0 \uc62c\ub9ac\uba74\uc11c \u2018<br>\uc911\uad6d \ubb38\ud654\u2019(Chineseculture) \u2018\uc911\uad6d \uc804\ud1b5\uc694\ub9ac\u2019(Chinesecuisine)\ub77c\ub294 \ud574\uc2dc\ud0dc\uadf8\ub97c \ub2ec\uc558\ub2e4. \uc774\ub4e4 \uc601\uc0c1\uc758 \uc870\ud68c \uc218\ub294 3000\ub9cc\ud68c\uac00 \ub118\ub294\ub2e4.<br>\uc11c \uad50\uc218\ub294<br>\u201c<br>\ub18d\ucd0c \uc0dd\ud65c\uc744 \uc774\uc6a9\ud574 \uae40\uce58\ub97c \ud64d\ubcf4\ud558\ub294 \uc774\uc720\ub294 \u2018\uc624\ub798\uc804\ubd80\ud130 \uc911\uad6d \uc2dc\uace8\uc5d0\uc11c \ub9cc\ub4e4\uc5b4 \uba39\uc5c8\ub358 \uc74c\uc2dd\u2019\uc774\ub77c\ub294 \uc810\uc744 \ub300\uc678\uc801\uc73c\ub85c \uac15\uc870\ud558\uae30 \uc704\ud55c \uac83\u201d\uc774\ub77c\uba70 \u201c\uc774\ub7f0\ub2e4\uace0 \uc138\uacc4\uc778\ub4e4\uc774 \uc18d\uaca0\ub098. \uc5b4\ub9ac\uc11d\uc740 \uaf3c\uc218\u201d\ub77c\uace0 \uc9c0\uc801\ud588\ub2e4. \uadf8\ub7ec\uba74\uc11c<br>\uc9c0\ub09c 2021\ub144 \uae40\uce58\ub97c \ub2f4\uadf8\ub294 \ub3d9\uc601\uc0c1\uc5d0 \u2018\uc911\uad6d\uc74c\uc2dd\u2019(ChineseFood) \ud574\uc2dc\ud0dc\uadf8\ub97c \ub2ec\uc544 \ubb3c\uc758\ub97c \ube5a\uc740 \uc911\uad6d\uc758 \uc720\uba85 \uc720\ud29c\ubc84 \ub9ac\ucbd4\uce58(\u674e\u5b50\u67d2)\ub97c \uc5b8\uae09\ud588\ub2e4.<br>\uc11c \uad50\uc218\ub294 \u201c\uc138\uacc4\uac00 \ud55c\uad6d \ubb38\ud654\ub97c \uc8fc\ubaa9\ud558\uace0 \uc990\uae30\ub2e4 \ubcf4\ub2c8 \uc911\uad6d\uc778\ub4e4\uc758 \uc5f4\ub4f1\uac10\uc740 \ub0a0\ub85c \uc2ec\ud574\uc838 \uac00\uace0 \uc788\ub2e4. \uc6b0\ub9ac\uac00 \uc774\ub97c \uc5ed\uc774\uc6a9\ud574, \ub354 \uc138\ub828\ub41c \ubc29\uc2dd\uc73c\ub85c \uc6b0\ub9ac \ubb38\ud654\ub97c \ub110\ub9ac \uc54c\ub824 \ub098\uac00\uc57c \ud55c\ub2e4\u201d\uace0 \uc8fc\uc7a5\ud588\ub2e4.",
  "ai_image_file_7": "https://snuss1.qualtrics.com/ControlPanel/Graphic.php?IM=IM_5EuvdbCjlRDml21",
  "real_image_file_7": "https://snuss1.qualtrics.com/ControlPanel/Graphic.php?IM=IM_8Fxda4lmNx5DhEj",
  "ai_caption_7": "\ud574\ub2f9 \uae30\uc0ac\uc640 \ubb34\uad00. \ud234 \uc81c\uacf5=\ud50c\ub77c\uba5c(AI \uc0dd\uc131)",
  "real_caption_7": "\uae40\uce58\ub97c \uc790\uad6d \uc74c\uc2dd\uc774\ub77c\uace0 \uc8fc\uc7a5\ud558\ub294 \uc911\uad6d \uc778\ud50c\ub8e8\uc5b8\uc11c \ubbf8\uc2a4\ud130 \ubc4c\uc624(\uc67c\ucabd \uc0ac\uc9c4)\uc640 \ub9ac\ucbd4\uce58. \uc11c\uacbd\ub355 \uad50\uc218 \ud398\uc774\uc2a4\ubd81 \ucea1\ucc98",
  "idx_8": "81",
  "title_8": "\ub300\uae30\uc5c5 CEO, \u2018\uae30\uc220 \uc5f0\uad6c\ud615\u2019 \ube44\uc911 \uc904\uace0 \u2018\uad00\ub9ac\ud615\u2019 \ub298\uc5c8\ub2e4",
  "body_8": "\uc2dc\uac00\ucd1d\uc561 \uc0c1\uc704 500\ub300 \uae30\uc5c5 \ub300\ud45c\uc774\uc0ac(CEO)\ub4e4 \uac00\uc6b4\ub370 \uacbd\uc601\u00b7\uc7ac\ubb34 \uc5c5\ubb34 \ucd9c\uc2e0\uc778 \u2018\uad00\ub9ac\ud615\u2019 \ube44\uc911\uc774 \ub298\uace0 \uae30\uc220\ud615 \ube44\uc911\uc740 \uc904\uc5b4\ub4dc\ub294 \uac83\uc73c\ub85c \ub098\ud0c0\ub0ac\ub2e4.<br>\uae30\uc5c5 \ub370\uc774\ud130 \uc5f0\uad6c\uc18c \uc2dc\uc774\uc624\uc2a4\ucf54\uc5b4\ub294 \uc2dc\uac00\ucd1d\uc561 \uc0c1\uc704 500\ub300 \uae30\uc5c5\ub4e4 \uc911 470\uacf3 \uc2dc\uc774\uc624\ub4e4\uc758 \uc774\ub825\uc744 \uc870\uc0ac\ud574\ubcf4\ub2c8 49.8%\uac00 \uacbd\uc601\u00b7\uc7ac\ubb34 \ucd9c\uc2e0\uc774\uc5c8\ub2e4\uace0 19\uc77c \ubc1d\ud614\ub2e4. \u2018\uad00\ub9ac\ud615\u2019\uc73c\ub85c\ub3c4 \ubd88\ub9ac\ub294 \uc774\ub7f0 \uc720\ud615\uc758 \uc2dc\uc774\uc624 \ube44\uc911\uc740 3\ub144 \uc804\ubcf4\ub2e4 2.9%\ud3ec\uc778\ud2b8 \ub298\uc5c8\ub2e4.<br>\uae30\uc220\u00b7\uc5f0\uad6c\uc9c1 \ucd9c\uc2e0\uc778 \u2018\uae30\uc220\ud615\u2019\uc740 28.4%\ub85c \uc9d1\uacc4\ub410\ub2e4. \uc774\ub4e4\uc758 \ube44\uc911\uc740 3\ub144 \uc804\ubcf4\ub2e4 3.4%\ud3ec\uc778\ud2b8 \uc904\uc5c8\ub2e4. \uc2dc\uc774\uc624\uc2a4\ucf54\uc5b4\ub294 \uc5d4\uc9c0\ub2c8\uc5b4 \ucd9c\uc2e0 \uc2dc\uc774\uc624\uac00 \uc904\uc5b4\ub4dc\ub294 \ucd94\uc138\ub294 \ub300\ud559 \uc804\uacf5\uc744 \ud1b5\ud574\uc11c\ub3c4 \uc5ff\ubcfc \uc218 \uc788\ub2e4\uace0 \ud588\ub2e4. \uacbd\uc601\u00b7\uacbd\uc81c\ud559 \uc804\uacf5\uc790 \ube44\uc911\uc740 3\ub144 \uc804 27.3%\uc5d0\uc11c \uc62c\ud574 29.9%\ub85c 2.6%\ud3ec\uc778\ud2b8 \ub298\uc5c8\ub294\ub370 \uc804\uc790\u00b7\ud654\ud559\u00b7\uae30\uacc4\u00b7\uc0b0\uc5c5\uacf5\ud559 \ub4f1 \uacf5\ud559\uacc4\uc5f4 \uc804\uacf5\uc740 \uc904\uc5b4\ub4dc\ub294 \ucd94\uc138\ub97c \ubcf4\uc600\ub2e4.<br>\uc2dc\uc774\uc624\ub4e4 \uc911 \uc601\uc5c5\u00b7\ub9c8\ucf00\ud305 \ucd9c\uc2e0\uc740 15.1%\ub85c, 3\ub144 \uc804(15%)\uacfc \ube44\uc2b7\ud588\ub2e4. \uc0dd\uc0b0\u00b7\uad6c\ub9e4 \ub4f1 \u2018\ud604\uc7a5\uc9c1\u2019 \ucd9c\uc2e0\uc740 3.3%\ub85c, 3\ub144 \uc804\ubcf4\ub2e4 1.3%\ud3ec\uc778\ud2b8 \uac10\uc18c\ud588\ub2e4.<br>\uc2dc\uc774\uc624\ub4e4\uc758 \ucd9c\uc2e0 \ub300\ud559\uc740 \uc11c\uc6b8\ub300\uac00 22.5%\ub85c \uac00\uc7a5 \ub9ce\uc558\ub2e4. \uc774\uc5b4 \uc5f0\uc138\ub300(12.7%)\uc640 \uace0\ub824\ub300(10.8%) \ucd9c\uc2e0 \ucc28\ub840\ub85c \ub9ce\uc558\ub2e4.<br>\uc870\uc0ac \ub300\uc0c1 \uae30\uc5c5\ub4e4\uc758 \uc2dc\uc774\uc624 \ud3c9\uade0 \ub098\uc774\ub294 59.6\uc0b4\ub85c, 3\ub144 \uc804\ubcf4\ub2e4 1.2\uc0b4\uc774 \ub9ce\uc558\ub2e4.r",
  "ai_image_file_8": "https://snuss1.qualtrics.com/ControlPanel/Graphic.php?IM=IM_mnUaiynj5jRB725",
  "real_image_file_8": "https://snuss1.qualtrics.com/ControlPanel/Graphic.php?IM=IM_1vIkAnQ5MrTdSi8",
  "ai_caption_8": "\ucc57GPT \uc0dd\uc131 \uc774\ubbf8\uc9c0.",
