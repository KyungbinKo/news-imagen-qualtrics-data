  "ai_caption_8": "\uc778\ub3c4\uc5d0\uc11c 10\ub300 \uc18c\ub140\ub97c \uc131\ud3ed\ud589\ud558\ub358 40\ub300 \ub0a8\uc131\uc774 \uac11\uc791\uc2a4\ub7fd\uac8c \uc0ac\ub9dd\ud558\ub294 \uc77c\uc774 \ubc1c\uc0dd\ud588\ub2e4. [\uc774\ubbf8\uc9c0 \ucd9c\ucc98 = \ucc57GPT]",
  "real_caption_8": "\uc774 \uc0ac\uc9c4\uc740 \uae30\uc0ac \ub0b4\uc6a9\uacfc \uc9c1\uc811 \uad00\ub828 \uc5c6\uc74c. AFP \uc5f0\ud569\ub274\uc2a4"
