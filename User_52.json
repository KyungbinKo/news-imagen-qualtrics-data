  "title_8": "3 1\uc808 \uc5f0\ud734 23\ub9cc\uba85 \uc77c\ubcf8 \uc624\uac14\ub2e4 \uc9c0\ub09c\ud574\ubcf4\ub2e4 10%\u2191",
  "body_8": "\uc0ac\ud758 \ub3d9\uc548 \uc774\uc5b4\uc9c4 \uc62c\ud574 3\u00b71\uc808 \uc5f0\ud734\uc5d0 23\ub9cc\uba85\uc774 \ub118\ub294 \uc2b9\uac1d\uc774 \uc77c\ubcf8\uc5d0 \uc624\uac00\ub294 \ud56d\uacf5\ud3b8\uc744 \uc774\uc6a9\ud55c \uac83\uc73c\ub85c \ub098\ud0c0\ub0ac\ub2e4.<br>9\uc77c \uad6d\ud68c \uad6d\ud1a0\uad50\ud1b5\uc704\uc6d0\ud68c \uc18c\uc18d \ub354\ubd88\uc5b4\ubbfc\uc8fc\ub2f9 \uc774\uc5f0\ud76c \uc758\uc6d0\uc774 \uc778\ucc9c\uad6d\uc81c\uacf5\ud56d\uacf5\uc0ac\uc640 \ud55c\uad6d\uacf5\ud56d\uacf5\uc0ac\ub85c\ubd80\ud130 \uc81c\ucd9c\ubc1b\uc740 \uc790\ub8cc\uc5d0 \ub530\ub974\uba74 \uc9c0\ub09c 1\uc77c\ubd80\ud130 3\uc77c\uae4c\uc9c0 \uad6d\ub0b4 \uacf5\ud56d\uc5d0\uc11c \uc77c\ubcf8 \ub178\uc120\uc744 \uc774\uc6a9\ud55c \uc2b9\uac1d\uc740 \ucd9c\uc785\uad6d\uc744 \ud569\uccd0 \ucd1d 23\ub9cc1956\uba85\uc73c\ub85c \uc9d1\uacc4\ub410\ub2e4.<br>\uc774\ub294 \uc5ed\uc2dc \uc0ac\ud758\uc774\uc5c8\ub358 \uc9c0\ub09c\ud574 3\u00b71\uc808 \uc5f0\ud734 \uad6d\ub0b4 \uacf5\ud56d\uc5d0\uc11c\uc758 \uc77c\ubcf8 \ub178\uc120 \ud56d\uacf5\ud3b8 \uc774\uc6a9\uac1d 21\ub9cc509\uba85\uacfc \ube44\uad50\ud574 10.2% \ub298\uc5b4\ub09c \uc218\uce58\ub2e4. \ucf54\ub85c\ub09819 \uc774\uc804\uc778 2019\ub144 \uc0ac\ud758\uac04\uc758 3\u00b71\uc808 \uc5f0\ud734(20\ub9cc1467\uba85)\uc640 \ube44\uad50\ud574\ub3c4 15.1% \ub9ce\ub2e4.<br>\uc62c\ud574 3\u00b71\uc808 \uc5f0\ud734\uc5d0\ub294 \uc778\ucc9c\uacf5\ud56d\uc5d0\uc11c 16\ub9cc2235\uba85\uc774, \uae40\ud3ec\u00b7\uae40\ud574\u00b7\uc81c\uc8fc\u00b7\uccad\uc8fc\u00b7\ub300\uad6c \ub4f1 5\uac1c \uacf5\ud56d\uc5d0\uc11c 6\ub9cc9721\uba85\uc774 \uc77c\ubcf8 \ub178\uc120\uc744 \uc774\uc6a9\ud588\ub2e4. \uac01\uac01 \uc9c0\ub09c\ud574 \ub300\ube44 9.1%, 12.9% \ub298\uc5c8\ub2e4.<br>\uc804\uccb4 \uad6d\uc81c\uc120 \uc774\uc6a9\uac1d\ub3c4 \ub298\uc5b4\ub0ac\ub2e4. \uc62c\ud574 3\u00b71\uc808 \uc5f0\ud734 \ub3d9\uc548 \uc804\uccb4 \uad6d\uc81c\uc120 \uc774\uc6a9\uac1d\uc740 81\ub9cc448\uba85\uc73c\ub85c, \uc9c0\ub09c\ud574 75\ub9cc2409\uba85\ubcf4\ub2e4 7.7% \ub9ce\uc558\ub2e4.<br>\ubc18\uba74 3\u00b71\uc808 \uc5f0\ud734\uc5d0 \uad6d\ub0b4\uc120\uc744 \uc774\uc6a9\ud558\ub294 \uc2b9\uac1d\uc740 \uc904\uc5b4\ub4e0 \uac83\uc73c\ub85c \ub098\ud0c0\ub0ac\ub2e4. \uc9c0\ub09c 1~3\uc77c \uad6d\ub0b4\uc120 \ud56d\uacf5 \uc2b9\uac1d\uc740 45\ub9cc2873\uba85\uc73c\ub85c, \uc9c0\ub09c\ud574 51\ub9cc7643\uba85\uacfc \ube44\uad50\ud574 12.5% \uac10\uc18c\ud588\ub2e4.",
  "ai_image_file_8": "https://snuss1.qualtrics.com/ControlPanel/Graphic.php?IM=IM_1oKcC3GMiWEbbWp",
  "real_image_file_8": "https://snuss1.qualtrics.com/ControlPanel/Graphic.php?IM=IM_iJ4jU6wO8pX6VXF",
  "ai_caption_8": "[\ucd9c\ucc98=EBN AI \uadf8\ub798\ud53d]",
  "real_caption_8": "\uc5f0\ud734\uac00 \uc2dc\uc791\ub41c \uc9c0\ub09c 1\uc77c \uc778\ucc9c\uad6d\uc81c\uacf5\ud56d \uc81c1\uc5ec\uac1d\ud130\ubbf8\ub110 \ucd9c\uad6d\uc7a5\uc5d0\uc11c \uc2b9\uac1d\ub4e4\uc774 \ud0d1\uc2b9 \uc218\uc18d\uc744 \uc704\ud574 \uc904\uc744 \uc11c\uace0 \uc788\ub2e4. \uc5f0\ud569\ub274\uc2a4"
}