  "assignment_id": "52",
  "idx_1": "72",
  "title_1": "\ubcf4\ud5d8 \ub300\ub9ac\uc810 2\uacf3 \ud574\ud0b9 \uc815\ud669 \ud3ec\ucc29 \"\uace0\uac1d \uc815\ubcf4 \uc720\ucd9c \ud655\uc778\uc911\"",
  "body_1": "\ubc95\uc778\ubcf4\ud5d8\ub300\ub9ac\uc810(GA) 2\uacf3\uc5d0\uc11c \ud574\ud0b9 \uc0ac\uace0\uac00 \ubc1c\uc0dd\ud55c \uc815\ud669\uc774 \ud3ec\ucc29\ub3fc \uae08\uc735\ub2f9\uad6d\uc774 \uc870\uce58\uc5d0 \ub098\uc130\ub2e4.<br>27\uc77c \uae08\uc735\uac10\ub3c5\uc6d0\uc5d0 \ub530\ub974\uba74 \ucd5c\uadfc 2\uac1c GA\uc0ac\uc5d0\uc11c \uc2dc\uc2a4\ud15c \ud574\ud0b9 \uc0ac\uace0 \uc815\ud669\uc774 \ud30c\uc545\ub410\ub2e4. \uae08\uac10\uc6d0 \uad00\uacc4\uc790\ub294 \u201c\uc774\ubc88 \uce68\ud574\uc0ac\uace0\ub294 \ubcf4\ud5d8 \uc601\uc5c5 \uc9c0\uc6d0 IT\uc11c\ube44\uc2a4 \uc804\ubb38\uc5c5\uccb4\uc5d0\uc11c \ube44\ub86f\ub41c \uc815\ud669\uc774 \ud655\uc778\ub410\ub2e4\u201d\uba70 \u201c\ud604\uc7ac \uae08\uc735\ubcf4\uc548\uc6d0\uc758 \uce68\ud574\uc0ac\uace0 \uc870\uc0ac\u00b7\ubd84\uc11d\uc774 \uc9c4\ud589 \uc911\u201d\uc774\ub77c\uace0 \ub9d0\ud588\ub2e4.<br>\ub2e4\ub9cc \ud604\uc7ac\uae4c\uc9c0 \uace0\uac1d\uc815\ubcf4 \uc720\ucd9c \uc5ec\ubd80\ub294 \ud655\uc778\ub418\uc9c0 \uc54a\uc740 \uc0c1\ud0dc\ub2e4. \uae08\uac10\uc6d0\uc740 \u2018\uac1c\uc778\uc815\ubcf4 \uc720\ucd9c \ub4f1 \uc0ac\uace0 \ub300\uc751 \ub9e4\ub274\uc5bc\uacfc \uc790\uccb4 \ub300\uc751 \ubc29\uc548\uc5d0 \ub530\ub77c \ud574\ub2f9 GA \ub4f1 \uad00\ub828 \ud68c\uc0ac\uac00 \uc0c1\ud669 \ub2e8\uacc4\ubcc4\ub85c \uc801\uc808\ud55c \uc870\uce58\ub97c \ucde8\ud558\ub3c4\ub85d \ud558\uace0 \uc788\ub2e4.<br>\uae08\uac10\uc6d0\uc740 \u201c\ud574\ub2f9 GA\uc5d0 \ub300\ud574\uc120 \uc2dc\uc2a4\ud15c \ubd84\ub9ac\u00b7\ucc28\ub2e8 \ub4f1 \ud53c\ud574 \ucd5c\uc18c\ud654\ub97c \uc704\ud55c \uc870\uce58, \uc18c\uad00\uae30\uad00 \uc2e0\uace0 \ub4f1\uc744 \uc9c4\ud589\ud1a0\ub85d \ud588\uc73c\uba70, \uace0\uac1d \uc815\ubcf4 \uc720\ucd9c \uc0ac\uc2e4\uc774 \ud655\uc815\ub418\ub294 \uacbd\uc6b0 \uace0\uac1d\uc5d0\uac8c \uc2e0\uc18d\ud788 \ud1b5\uc9c0\ud560 \uc218 \uc788\ub3c4\ub85d \uc0ac\uc804 \uc900\ube44\ub97c \ucde8\ud560 \uac83\uc744 \uc9c0\ub3c4\ud588\ub2e4\u201d\uace0 \ud588\ub2e4.<br>\uae08\uac10\uc6d0\uc740 \ub610 \uac01 GA\uc640 \ubcf4\ud5d8\ud68c\uc0ac\uc5d0 \ubcf4\uc548 \ucde8\uc57d\uc810 \uc790\uccb4 \uc810\uac80, \ubd88\ud544\uc694\ud55c \uace0\uac1d\uc815\ubcf4 \uc0ad\uc81c \ub4f1\uc744 \uc694\uad6c\ud588\ub2e4. \uc815\ubcf4 \uc720\ucd9c\uc774 \ud655\uc778\ub418\ub294 \uc989\uc2dc 2\ucc28 \ud53c\ud574 \uc2e0\uace0, \uad00\ub828 \uc81c\ub3c4 \uc548\ub0b4 \ub4f1\uc744 \uc704\ud55c \uc885\ud569\uc0c1\ub2f4\uc13c\ud130\ub97c \uc0dd\uba85\u00b7\uc190\ud574\ubcf4\ud5d8\ud611\ud68c\uc5d0 \uc124\uce58\ud574 \ubcf4\ud5d8 \uc18c\ube44\uc790 \ud53c\ud574\ub97c \ucd5c\uc18c\ud654\ud55c\ub2e4\ub294 \uacc4\ud68d\uc774\ub2e4. \uace0\uac1d \uc815\ubcf4 \uc720\ucd9c \uc6d0\uc778 \ub4f1\uc774 \ud30c\uc545\ub418\uba74 \uc7ac\ubc1c \ubc29\uc9c0 \ub300\ucc45\uc744 \uac15\uad6c\ud574 GA\uc640 \ubcf4\ud5d8 \ud68c\uc0ac\uac00 \uc774\ud589\ud1a0\ub85d \uc870\uce58\ud560 \uc608\uc815\uc774\ub2e4.",
  "ai_image_file_1": "https://snuss1.qualtrics.com/ControlPanel/Graphic.php?IM=IM_OKwegJzJzZFXfJd",
  "real_image_file_1": "https://snuss1.qualtrics.com/ControlPanel/Graphic.php?IM=IM_ACzbKt50mIFr82v",
