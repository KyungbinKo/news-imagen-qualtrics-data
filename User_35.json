  "ai_caption_8": "\ucc57GPT\ub85c \uc0dd\uc131\ud55c \uc790\uae08\uc0ac\uc815\uc5d0 \uc5b4\ub824\uc6c0\uc744 \uacaa\uace0 \uc788\ub294 \uc911\uc18c\uae30\uc5c5 \uc774\ubbf8\uc9c0",
  "real_caption_8": "\uc0ac\uc9c4=\uc5f0\ud569\ub274\uc2a4"
}