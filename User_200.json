  "ai_caption_8": "\ucc57GPT \uc0dd\uc131\uc774\ubbf8\uc9c0. [\ucd9c\ucc98=\uc624\ud508AI]",
  "real_caption_8": "\ubb3c\uac00\uc0c1\uc2b9 \uae30\ub300\ud615\uc131 \uc694\uc778\uc5d0 \ub300\ud55c \uc751\ub2f5\ube44\uc911.\ud55c\uad6d\uc740\ud589"
}