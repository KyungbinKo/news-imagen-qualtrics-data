  "ai_caption_8": "\ud234 \uc81c\uacf5=\ud50c\ub77c\uba5c(AI \uc81c\uc791)",
  "real_caption_8": "\ub85c\uc774\ud130\uc5f0\ud569\ub274\uc2a4"
}