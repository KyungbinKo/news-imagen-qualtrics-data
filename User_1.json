  "real_caption_4": "\uae30\uc0ac \ub0b4\uc6a9\uacfc \ubb34\uad00\ud55c \uc0ac\uc9c4. \uc774\ubbf8\uc9c0\ud22c\ub370\uc774",
  "idx_5": "157",
  "title_5": "\ucda9\ub0a8\uc120\uad00\uc704, \uc120\uac70\ubc95 \uc704\ubc18 \ud610\uc758\ub85c \uc785\ud6c4\ubcf4 \uc608\uc815\uc790 \uace0\ubc1c",
  "body_5": "\ucda9\ub0a8\uc120\uac70\uad00\ub9ac\uc704\uc6d0\ud68c\ub294 \ub0b4\ub144 \uc2e4\uc2dc\ub420 \uc81c9\ud68c \uc804\uad6d\ub3d9\uc2dc\uc9c0\ubc29\uc120\uac70\ub97c \uc55e\ub450\uace0 \uc120\uac70\uad6c\ubbfc\uc5d0\uac8c \uc74c\uc2dd\ubb3c\uc744 \uc81c\uacf5\ud55c \ud610\uc758\ub85c \uc785\ud6c4\ubcf4 \uc608\uc815\uc790 A\uc528 \ub4f1 4\uba85\uc744 \ub300\uc804\uc9c0\ubc29\uac80\ucc30\uccad \ud64d\uc131\uc9c0\uccad\uc5d0 \uace0\ubc1c\ud588\ub2e4\uace0 22\uc77c \ubc1d\ud614\ub2e4. A\uc528 \ub4f1\uc740 \uc9c0\ub09c 3\uc6d426\uc77c \uc800\ub141 7\uc2dc\uaed8 A\uc528\uac00 \uc785\ud6c4\ubcf4\ud558\uace0\uc790 \ud558\ub294 \uc120\uac70\uad6c \ub0b4\uc758 \ud55c \uc2dd\ub2f9\uc5d0\uc11c \uc120\uac70\uad6c\ubbfc 7\uba85\uc5d0\uac8c \ub0b4\ub144 \uc9c0\ubc29\uc120\uac70\uc5d0\uc11c\uc758 \uc9c0\uc9c0\ub97c \ubd80\ud0c1\ud558\uba70 35\ub9cc\uc6d0 \uc0c1\ub2f9\uc758 \uc74c\uc2dd\ubb3c\uc744 \uc81c\uacf5\ud55c \ud610\uc758\ub97c \ubc1b\uace0 \uc788\ub2e4.<br>\uacf5\uc9c1\uc120\uac70\ubc95 \uc81c113\uc870\uc640 \uc81c115\uc870\uc5d0 \ub530\ub974\uba74, \ud6c4\ubcf4\uc790\uac00 \ub418\uace0\uc790 \ud558\ub294 \uc790\ub294 \uc120\uac70\uad6c\ubbfc\uc5d0\uac8c \uae30\ubd80\ud589\uc704\ub97c \ud560 \uc218 \uc5c6\uc73c\uba70, \uc774\ub97c \uc704\ubc18\ud560 \uacbd\uc6b0 5\ub144 \uc774\ud558\uc758 \uc9d5\uc5ed \ub610\ub294 1000\ub9cc\uc6d0 \uc774\ud558\uc758 \ubc8c\uae08\uc5d0 \ucc98\ud574\uc9c8 \uc218 \uc788\ub2e4.<br>\ucda9\ub0a8\uc120\uad00\uc704 \uad00\uacc4\uc790\ub294 \u201c\uc81c9\ud68c \uc804\uad6d\ub3d9\uc2dc\uc9c0\ubc29\uc120\uac70\uac00 \ub2e4\uac00\uc62c\uc218\ub85d \uc720\uc0ac\ud55c \uc704\ubc95\ud589\uc704\uac00 \ubc1c\uc0dd\ud560 \uac83\uc73c\ub85c \uc608\uc0c1\ub41c\ub2e4\u201d\uba70 \u201c\uc62c\ubc14\ub978 \uc120\uac70\ubb38\ud654 \uc815\ucc29\uc744 \uc704\ud574 \uc120\uac70\ubc95 \uc704\ubc18\ud589\uc704 \ubc1c\uacac \uc2dc \uc801\uadf9\uc801\uc778 \uc2e0\uace0\uc640 \uc81c\ubcf4\ub97c \ubd80\ud0c1\ud55c\ub2e4\u201d\uace0 \ub9d0\ud588\ub2e4.<br>\uc774\ubc88 \uc0ac\uac74\uc740 \uc120\uac70\ubc95 \uc704\ubc18\uc758 \uc2ec\uac01\uc131\uc744 \ub2e4\uc2dc \ud55c \ubc88 \uc77c\uae68\uc6cc \uc8fc\uba70, \uc720\uad8c\uc790\uc640 \ud6c4\ubcf4\uc790\ub4e4\uc758 \uacf5\uc815\ud55c \uc120\uac70\ub97c \uc704\ud55c \uacbd\uac01\uc2ec\uc744 \ub192\uc774\ub294 \uacc4\uae30\uac00 \ub420 \uac83\uc73c\ub85c \uae30\ub300\ub41c\ub2e4. \uc120\uad00\uc704\ub294 \uc55e\uc73c\ub85c\ub3c4 \uc704\ubc95\ud589\uc704\uc5d0 \ub300\ud55c \ucca0\uc800\ud55c \uac10\uc2dc\uc640 \ub2e8\uc18d\uc744 \ud1b5\ud574 \uae68\ub057\ud55c \uc120\uac70\ubb38\ud654\ub97c \uc815\ucc29\uc2dc\ud0a4\uae30 \uc704\ud574 \ucd5c\uc120\uc744 \ub2e4\ud560 \ubc29\uce68\uc774\ub2e4.",
  "ai_image_file_5": "https://snuss1.qualtrics.com/ControlPanel/Graphic.php?IM=IM_u0ev2hyDoT1LJVS",
  "real_image_file_5": "https://snuss1.qualtrics.com/ControlPanel/Graphic.php?IM=IM_mZPbv1qiTG8E0J0",
  "ai_caption_5": "\ub0b4\ub144 6\uc6d4 \uc9c0\ubc29\uc120\uac70\uc5d0 \ucd9c\ub9c8 \uc608\uc815\uc778 \uc785\ud6c4\ubcf4\uc790 A\uc528\uac00 \uc120\uac70\uad6c\ubbfc 7\uba85\uc5d0\uac8c 35\ub9cc \uc6d0 \uc0c1\ub2f9\uc758 \uc2dd\uc0ac\ub97c \uc81c\uacf5\ud558\uba70 \uc9c0\uc9c0\ub97c \ud638\uc18c\ud558\ub2e4 \uc120\uac70\ubc95 \uc704\ubc18 \ud610\uc758\ub85c 23\uc77c \ucda9\ub0a8\uc120\uad00\uc704\uc5d0 \uace0\ubc1c\ub41c \uc0c1\ud669\uc744 \uc7ac\ud604\ud55c \ud55c\uad6d\uc77c\ubcf4 HAI\uac00 \uadf8\ub9b0 \uac00\uc0c1 \uc774\ubbf8\uc9c0",
  "real_caption_5": "\ucda9\ub0a8\uc120\uad00\uc704",
  "idx_6": "209",
  "title_6": "\ubc29\ud1b5\uc704-\ubc29\uc2ec\uc704, \ub525\ud398\uc774\ud06c \uc131\ubc94\uc8c4 \ub300\uc751 \ud1a0\ub860\ud68c \uac1c\ucd5c",
  "body_6": "\ubc29\uc1a1\ud1b5\uc2e0\uc704\uc6d0\ud68c\ub294 \ubc29\uc1a1\ud1b5\uc2e0\uc2ec\uc758\uc704\uc6d0\ud68c, \uc2dc\uccad\uc790\ubbf8\ub514\uc5b4\uc7ac\ub2e8\uacfc \ud568\uaed8 \uc624\ub294 12\uc77c \uc624\ud6c4 \uc11c\uc6b8 \uc591\ucc9c\uad6c \ubaa9\ub3d9 \ubc29\uc1a1\ud68c\uad00\uc5d0\uc11c \ub525\ud398\uc774\ud06c \uc131\ubc94\uc8c4\uc601\uc0c1\ubb3c \ub300\uc751 \uc804\ubb38\uac00 \ud1a0\ub860\ud68c\ub97c \uc5f0\ub2e4\uace0 11\uc77c \ubc1d\ud614\ub2e4.'\ub525\ud398\uc774\ud06c \uc131\ubc94\uc8c4\uc601\uc0c1\ubb3c \uc544\uc6c3(OUT)!-\ud604\uc548 \uc9c4\ub2e8\uacfc \ub300\ucc45 \ubaa8\uc0c9'\uc744 \uc8fc\uc81c\ub85c \uc5f4\ub9ac\ub294 \uc774\ubc88 \ud1a0\ub860\ud68c\uc5d0\ub294 \uc815\ubd80 \ubd80\ucc98, \ud559\uacc4, \uc0b0\uc5c5\uacc4, \uc720\uad00\uae30\uad00 \ub4f1 \uad6d\ub0b4 \uad00\ub828 \uc804\ubb38\uac00\uac00 \ub300\uac70 \ucc38\uc5ec\ud574 \uc778\uacf5\uc9c0\ub2a5\uc758 \uc5ed\uae30\ub2a5\uacfc \ud3d0\ud574 \uadf8\ub9ac\uace0 \ubc95\uc81c\ub3c4 \uac1c\uc120 \ubc29\ud5a5, \ub525\ud398\uc774\ud06c \uc131\ubc94\uc8c4\uc601\uc0c1\ubb3c \ub300\uc751 \uc804\ub7b5 \ub4f1\uc744 \ub17c\uc758\ud55c\ub2e4.\uc2e0\uc601\uaddc \ubc29\ud1b5\uc704 \ubc29\uc1a1\ud1b5\uc2e0\uc774\uc6a9\uc790\uc815\ucc45\uad6d\uc7a5\uc740 \u201c\ubc29\uc2ec\uc704, \uc7ac\ub2e8\uacfc \ud568\uaed8 \uc774\ubc88 \ud1a0\ub860\ud68c\uc5d0\uc11c \ub17c\uc758\ub418\ub294 \uc804\ubb38\uac00 \uc758\uacac\uc744 \uacbd\uccad\ud558\uace0, \ud5a5\ud6c4 \uc815\ucc45 \uc0ac\ud56d\uc5d0 \ubc18\uc601\ud558\ub3c4\ub85d \ub178\ub825\ud560 \uc608\uc815\u201d\uc774\ub77c\uace0 \ubc1d\ud614\ub2e4.",
  "ai_image_file_6": "https://snuss1.qualtrics.com/ControlPanel/Graphic.php?IM=IM_6YXH5FH9sC6k2DY",
  "real_image_file_6": "https://snuss1.qualtrics.com/ControlPanel/Graphic.php?IM=IM_f8JFYaixVBJ4dni",
  "ai_caption_6": "\ucc57GPT 4o\ub85c \uc0dd\uc131\ud55c \uc774\ubbf8\uc9c0",
  "real_caption_6": "'\ub525\ud398\uc774\ud06c \uc131\ubc94\uc8c4\uc601\uc0c1\ubb3c \uc544\uc6c3(OUT)!-\ud604\uc548 \uc9c4\ub2e8\uacfc \ub300\ucc45 \ubaa8\uc0c9' \ud1a0\ub860\ud68c",
  "idx_7": "49",
  "title_7": "\uc0ac\ud0d5\uc778 \uc904 \uc54c\uace0 \u4e2d\uc5ec\uc131\uc774 \uba39\uc740 \ud3ed\uc8fd, \uc785\uc5d0\uc11c \uadf8\ub300\ub85c \ud3ed\ubc1c\ud588\ub2e4",
  "body_7": "\uc911\uad6d\uc5d0\uc11c \ucea1\uc290\ub85c \ud3ec\uc7a5\ub41c \ud3ed\uc8fd\uc744 \uc0ac\ud0d5\uc73c\ub85c \uc798\ubabb \uc54c\uace0, \uc5ec\uc131\uc774 \uc785\uc5d0 \ub123\uc5c8\ub2e4\uac00 \uc785\uc548\uc5d0\uc11c \ud3ed\uc8fd\uc774 \ud3ed\ubc1c\ud558\ub294 \uc0ac\uace0\uac00 \ubc1c\uc0dd\ud588\ub2e4.<br>13\uc77c \uc0ac\uc6b0\uc2a4\ucc28\uc774\ub098\ubaa8\ub2dd\ud3ec\uc2a4\ud2b8(SCMP)\uc5d0 \ub530\ub974\uba74 \uc911\uad6d \uc11c\ubd80 \uc4f0\ucd28\uc131 \uccad\ub450\uc2dc\uc5d0 \uc0ac\ub294 \uc6b0\ubaa8\uc528\ub294 \uc0ac\ud0d5\uacfc \uc720\uc0ac\ud55c \ud3ec\uc7a5 \ub514\uc790\uc778\uc758 \ud3ed\uc8fd\uc744 \uc785\uc5d0 \ub123\uc5c8\ub2e4\uac00 \ubd80\uc0c1\uc744 \ub2f9\ud588\ub2e4.<br>\uc6b0\uc528\ub294 \u201c\uc9d1\uc5d0\uc11c \uac70\uc2e4 \uc870\uba85\uc774 \uaebc\uc9c4 \uc0c1\ud0dc\ub85c TV\ub97c \ubcf4\uace0 \uc788\uc5c8\ub2e4. \ub3d9\uc0dd\uc774 \ud55c \ubd09\uc9c0 \uac00\ub4dd \uac04\uc2dd\uc744 \uc0ac \uc654\ub294\ub370, \uadf8 \uc911\uc5d0 \uc5b4\ub9b4 \ub54c \uba39\ub358 \uc6b0\uc720 \uc0ac\ud0d5\ucc98\ub7fc \uc0dd\uae34 \uac8c \uc788\uc5c8\ub2e4\u201d\uba70 \u201c\ud558\ub098\ub97c \uaebc\ub0b4 \uc785\uc5d0 \ub123\uace0 \uc539\uc5c8\ub294\ub370 \uac11\uc790\uae30 \ud3ed\ubc1c\ud588\ub2e4\u201d\uace0 \ub2f9\uc2dc \uc0c1\ud669\uc744 \uc124\uba85\ud588\ub2e4.<br>\uc774\uc5b4 \"\uc21c\uac04 \uc5b4\uc548\uc774 \ubc99\ubc99\ud574 \uc544\ud508 \uc904\ub3c4 \ubab0\ub790\ub2e4.<br>\uadf8\ub7ec\ub098 \uc785\uc548\uc5d0\uc11c \ud654\uc57d \ub0c4\uc0c8\uac00 \uc9c4\ub3d9\ud574 \ud3ed\uc8fd\uc778 \uc904 \uc54c\uc558\ub2e4\"\uace0 \ud588\ub2e4.<br>\ub2e4\ud589\ud788 \uc6b0\uc528\uc758 \uc785 \uc548\uc774 \uc870\uae08 \uae4c\uc9c4 \uac83 \uc678\uc5d0 \ubcc4\ub2e4\ub978 \ubd80\uc0c1\uc740 \uc5c6\ub294 \uac83\uc73c\ub85c \uc804\ud574\uc84c\ub2e4.<br>'\uc1bd\ud30c\uc624'\ub77c \ubd88\ub9ac\ub294 \uc774 \uc81c\ud488\uc740 \uac04\ud3b8\ud558\uac8c \uc0ac\uc6a9\uc774 \uac00\ub2a5\ud574 \uacb0\ud63c\uc2dd\uc774\ub098 \ud30c\ud2f0 \ub4f1\uc5d0 \ub9ce\uc774 \uc0ac\uc6a9\ub41c\ub2e4. \ubcf4\ud1b5 \ube44\ub2d0\ub85c \uac10\uc2f8 \ud310\ub9e4\ub418\uc9c0\ub9cc, \ucd5c\uadfc \uc77c\ubd80 \uc81c\ud488\ub4e4\uc740 \uc2b5\uae30\ub97c \ubc29\uc9c0\ud558\uae30 \uc704\ud574 \ucea1\uc290 \ud615\ud0dc\ub85c \ud3ec\uc7a5\ub3fc \ud310\ub9e4\ub418\uace0 \uc788\ub2e4. \uc774 \ud3ed\uc8fd\uc740 \ubd88\uc744 \ubd99\uc774\uc9c0 \uc54a\uc544\ub3c4 \ub358\uc9c0\uac70\ub098 \uc77c\uc815\ud55c \ucda9\uaca9\uc744 \ubc1b\uc73c\uba74 \ud3ed\ubc1c\ud558\ub294 \uac83\uc73c\ub85c \uc54c\ub824\uc84c\ub2e4.<br>\uc6b0\uc528\ub294 \"\uc774\ub7f0 \ud3ed\uc8fd\uc740 \uc0c1\uc790\uc5d0 \ud3ec\uc7a5\ud574\uc57c \ud558\uc9c0 \uc54a\ub0d0\"\uace0 \uc758\ubb38\uc744 \uc81c\uae30\ud588\ub2e4.<br>\ud574\ub2f9 \uc0ac\uac74\uc774 \uc804\ud574\uc9c0\uc790 \ub204\ub9ac\uafbc\ub4e4\uc740 \ucea1\uc220\uc5d0 \ub123\uc740 \ud3ec\uc7a5 \ubc29\uc2dd\uc774 \uc624\ud574\ub97c \ubd88\ub7ec \uc77c\uc73c\ud0ac \uc218 \uc788\ub2e4\ub294 \ub370 \ub3d9\uc758\ud588\ub2e4. \ub204\ub9ac\uafbc\ub4e4\uc740 \"\uacfc\uc790 \ud3ec\uc7a5\uacfc \uc815\ub9d0 \ube44\uc2b7\ud558\ub2e4\", \"\uc815\ub9d0 \uac71\uc815\uc2a4\ub7fd\ub2e4\", \"\uc704\ud5d8 \ubb3c\uc9c8 \ub77c\ubca8\uc744 \uba85\ud655\ud558\uac8c \ubd80\ucc29\ud574\uc57c \ud55c\ub2e4\"\ub294 \ub4f1\uc758 \ubc18\uc751\uc744 \ubcf4\uc600\ub2e4.<br>\uc774\uc640 \uad00\ub828 \ud3ed\uc8fd \ud68c\uc0ac \uc9c1\uc6d0\uc740 \ub9e4\uccb4\uc5d0 \"\ud3ed\uc8fd\uc744 \ucea1\uc290 \ud615\ud0dc\ub85c \ud3ec\uc7a5\ud55c \uac83\uc740 \uc2b5\uae30\ub97c \ubc29\uc9c0\ud574 \uc720\ud1b5 \uae30\ud55c\uc744 \ub298\ub9ac\uae30 \uc704\ud55c \uac83\uc774\ub77c\uba70 \ub3c5\ucc3d\uc801\uc778 \uc544\uc774\ub514\uc5b4\ub77c\uace0 \uc0dd\uac01\ud588\ub294\ub370, \ub204\uad70\uac00\uc5d0\uac90 \uacfc\uc790\ub85c \ubcf4\uc77c \uc904\uc740 \uafc8\uc5d0\ub3c4 \ubab0\ub790\ub2e4\"\uace0 \ub9d0\ud588\ub2e4.",
  "ai_image_file_7": "https://snuss1.qualtrics.com/ControlPanel/Graphic.php?IM=IM_66uAycF9GjhcBXM",
  "real_image_file_7": "https://snuss1.qualtrics.com/ControlPanel/Graphic.php?IM=IM_6beYB8iqcLq3uYq",
  "ai_caption_7": "\uae30\uc0ac \uc774\ud574\ub97c \ub3d5\uae30 \uc704\ud55c \uc790\ub8cc\uc0ac\uc9c4. \ud234 \uc81c\uacf5=\ud50c\ub77c\uba5c(AI \uc81c\uc791)",
  "real_caption_7": "\uc911\uad6d\uc5d0\uc11c \ud310\ub9e4 \uc911\uc778 \ud3ed\uc8fd \uc81c\ud488. SCMP \uac08\ubb34\ub9ac",
  "idx_8": "140",
  "title_8": "\uae08\uac10\uc6d0, \ubcf4\ud5d8\uc0ac\uae30 \uc54c\uc120 400\uc5ec\uba85 \uc218\uc0ac\uc758\ub8b0 \ubbf8\ud658\uae09 \ud560\uc99d\ubcf4\ud5d8\ub8cc 2\uc5b53000\uc5b5\uc6d0 \ud658\uae09",
  "body_8": "\uae08\uc735\uac10\ub3c5\uc6d0\uc774 \ubcf4\ud5d8\uc0ac\uae30\ubc29\uc9c0 \ud2b9\ubcc4\ubc95 \uac1c\uc815 \uc774\ud6c4 \ubcf4\ud5d8\uc0ac\uae30 \uc54c\uc120\ud589\uc704 \ud610\uc758\ub85c \uc57d 400\uba85\uc744 \uc218\uc0ac \uc758\ub8b0\ud558\uace0, \ubbf8\ud658\uae09 \ud560\uc99d\ubcf4\ud5d8\ub8cc 2\uc5b53000\uc5b5\uc6d0\uc5b4\uce58\ub97c 877\uba85\uc5d0\uac8c \ub3cc\ub824\uc92c\ub2e4\uace0 14\uc77c \ubc1d\ud614\ub2e4.<br>\uac1c\uc815\ub41c \ubcf4\ud5d8\uc0ac\uae30\ubc29\uc9c0 \ud2b9\ubcc4\ubc95\uc740 \uc9c0\ub09c\ud574 8\uc6d4 14\uc77c\ubd80\ud130 \uc2dc\ud589\ub410\ub2e4. \uc774 \uac1c\uc815\uc73c\ub85c \ubcf4\ud5d8\uc0ac\uae30 \uc54c\uc120\u00b7\uc720\uc778\u00b7\uad8c\uc720\u00b7\uad11\uace0 \ub4f1\uc774 \uae08\uc9c0\ub410\uace0, \uae08\uc735\ub2f9\uad6d\uc758 \ubcf4\ud5d8\uc0ac\uae30 \uc870\uc0ac\ub97c \uc704\ud55c \uad00\uacc4\uae30\uad00\uc5d0 \ub300\ud55c \uc790\ub8cc\uc694\uccad\uad8c\uc774 \uc2e0\uc124\ub410\ub2e4.<br>\uae08\uac10\uc6d0\uc740 \ubcf4\ud5d8\uc0ac\uae30\ubc29\uc9c0 \ud2b9\ubcc4\ubc95\uc744 \ud1b5\ud574 \uc790\ub3d9\ucc28 \uace0\uc758\uc0ac\uace0 \uad11\uace0\uc640 \uad00\ub828\ub41c \uae30\ud68d\uc870\uc0ac 2\uac74\uc744 \uc2e4\uc2dc\ud588\uace0, \ud610\uc758\uc790 19\uba85\uc744 \uc218\uc0ac\ub97c \uc758\ub8b0\ud588\ub2e4. \ub124\uc774\ubc84\u00b7\uce74\uce74\uc624 \ub4f1\uc5d0 \uc790\ub8cc\ub97c \uc694\uccad\ud574 \ud610\uc758\uc790 \uc778\uc801 \uc0ac\ud56d\uc744 \ud655\ubcf4\ud574 \uace0\uc758\uc0ac\uace0 \ud610\uc758 24\uac74\uc744 \ud655\uc778\ud588\ub2e4.<br>\uc8fc\uc694 \uc190\ud574\ubcf4\ud5d8\uc0ac\ub4e4\ub3c4 \ubcf4\ud5d8\uc0ac\uae30 \uc54c\uc120 \ud589\uc704 \ub4f1\uc5d0 \ub300\ud55c \uc790\uccb4 \uc870\uc0ac\ub97c \ud1b5\ud574 \ud610\uc758\uc790 380\uc5ec\uba85\uc744 \ud655\uc778\ud574, \uad00\ud560 \uacbd\ucc30\uc11c\uc5d0 \uc218\uc0ac\ub97c \uc758\ub8b0\ud588\ub2e4.<br>\uae08\uac10\uc6d0\uc740 \ud2b9\ubcc4\ubc95 \uac1c\uc815\uc5d0 \ub530\ub77c \uc790\ub3d9\ucc28 \ubcf4\ud5d8\uc0ac\uae30 \ud53c\ud574\uc0ac\uc2e4 \uace0\uc9c0\uc758\ubb34\uac00 \ubc95\uc815\ud654\ub3fc \uad00\ud589\uc801\uc73c\ub85c \ud574\uc624\ub358 \uace0\uc9c0\uae30\ud55c\uacfc \ubc29\ubc95, \ud658\uae09\uc808\ucc28 \ub4f1\uc744 \ud45c\uc900\ud654\ud588\ub2e4.<br>\uc774\uc5d0 \uc9c0\ub09c 8\uc6d4\ubd80\ud130 \ub450 \ub2ec\uac04 \ucea0\ud398\uc778\uc744 \uc2e4\uc2dc\ud574 \ubcf4\ud5d8\uc0ac\uae30\ub85c \ud560\uc99d\ub41c \ubcf4\ud5d8\ub8cc\ub97c \uc218\ub839\ud558\uc9c0 \uc54a\uc740 \uacc4\uc57d\uc790\uc5d0\uac8c \ud658\uae09\uc548\ub0b4\ub97c \uc9c4\ud589\ud588\ub2e4. 877\uba85\uc5d0\uac8c \ud560\uc99d\ubcf4\ud5d8\ub8cc 2\uc5b53000\ub9cc\uc6d0\uc744 \ub3cc\ub824\uc92c\ub2e4.<br>\ub610 \uae08\uac10\uc6d0\uc740 \uad00\uacc4\uae30\uad00 \uac04 \ud611\uc5c5 \uccb4\uacc4\uac00 \ub9c8\ub828\ub3fc \uc911\uace0\ucc28 \ubcf4\ud5d8\uc0ac\uae30\ub098 \uc9c4\ub2e8\uc11c \uc704\u00b7\ubcc0\uc870 \ubcf4\ud5d8\uc0ac\uae30 \ub4f1 \uc0c8\ub85c\uc6b4 \ud14c\ub9c8\uc758 \ubcf4\ud5d8\uc0ac\uae30\ub97c \uc870\uc0ac\ud558\uace0 \uc788\ub2e4.<br>\uae08\uac10\uc6d0\uc740 \"\uac1c\uc815\ub41c \ubcf4\ud5d8\uc0ac\uae30\ubc29\uc9c0 \ud2b9\ubcc4\ubc95\uc5d0 \ub530\ub77c \ucc98\ubc8c\uadfc\uac70\uac00 \ub9c8\ub828\ub41c \ubcf4\ud5d8\uc0ac\uae30 \uc54c\uc120 \ud589\uc704 \ub4f1\uc5d0 \ub300\ud55c \ubaa8\ub2c8\ud130\ub9c1\uc744 \uac15\ud654\ud558\uaca0\ub2e4\"\uba70 \"\uc9c0\ub2a5\ud654\u00b7\uc870\uc9c1\ud654\ub418\ub294 \uc2e0\uc885 \ubcf4\ud5d8\uc0ac\uae30 \uc218\ubc95\uc5d0 \ub300\ud574\uc11c\ub294 \uc720\uad00\uae30\uad00\uacfc \uae34\ubc00\ud788 \ud611\ub825\ud574 \uc2e0\uc18d\ud558\uace0 \uc5c4\uc815\ud558\uac8c \ub300\uc751\ud560 \uc608\uc815\"\uc774\ub77c\uace0 \ubc1d\ud614\ub2e4.",
