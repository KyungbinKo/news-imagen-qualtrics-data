  "real_image_file_8": "https://snuss1.qualtrics.com/ControlPanel/Graphic.php?IM=IM_fvrbBpklMpCJYgE",
  "ai_caption_8": "\ud574\ub2f9 \uae30\uc0ac\uc640 \uad00\ub828 \uc5c6\uc74c. \ud234 \uc81c\uacf5=\ud50c\ub77c\uba5c(AI)",
  "real_caption_8": "\uc778\ucc9c\uad6d\uc81c\uacf5\ud56d \uc81c1\uc5ec\uac1d\ud130\ubbf8\ub110 \ucd9c\uad6d\uc7a5. \ub274\uc2dc\uc2a4"
}