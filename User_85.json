  "real_image_file_8": "https://snuss1.qualtrics.com/ControlPanel/Graphic.php?IM=IM_XhpBFb4NfF6p6IC",
  "ai_caption_8": "\uc0ac\uc9c4=\ucc57GPT",
  "real_caption_8": "\ud0dc\uc591\uad11 \uc6e8\uc774\ud37c\ub294 \ud0dc\uc591\uad11 \ud328\ub110\uc744 \uad6c\uc131\ud558\ub294 \ucd08\ubc15\ud615 \uc2e4\ub9ac\ucf58\uc73c\ub85c \ud0dc\uc591\uc804\uc9c0\uc758 \uae30\ucd08 \uc18c\uc7ac\ub2e4. \uc0ac\uc9c4 \ubc14\uc774\ub450 \ucea1\ucc98"
}